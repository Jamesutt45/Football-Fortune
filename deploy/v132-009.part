") center/contain no-repeat;
  border:none;
  box-shadow:none;
  filter:drop-shadow(0 4px 8px rgba(0,0,0,.22));
  pointer-events:none;
}

.minute-node.kickoff-node::before{
  display:none;
}

.minute-node.kickoff-node span{
  display:none;
}

.minute-node.fulltime-node{
  width:96px;
  height:96px;
  background:transparent url("data:image/webp;base64,") center/contain no-repeat;
  border:none;
  box-shadow:none;
  filter:drop-shadow(0 4px 8px rgba(0,0,0,.22));
  pointer-events:none;
  z-index:4;
}

.minute-node.fulltime-node::before{
  display:none;
}

.minute-node.fulltime-node span{
  display:none;
}

.minute-node.fixed{
  width:36px;
  height:36px;
  border-radius:50%;
  background:#173a5e;
  color:#fff;
  border:2px solid #fff;
  box-shadow:0 0 0 2px #173a5e, 0 3px 8px rgba(0,0,0,.24);
  filter:none;
}

.minute-node.fixed::before{
  display:none;
}

/* v65 — Full Time asset must override the legacy fixed-node circle */
.minute-node.fixed.fulltime-node{
  width:96px;
  height:96px;
  border-radius:0;
  background:transparent url("data:image/webp;base64,") center/contain no-repeat;
  color:transparent;
  border:none;
  box-shadow:none;
  filter:drop-shadow(0 4px 8px rgba(0,0,0,.22));
  z-index:4;
}

.minute-node.fixed.fulltime-node::before,
.minute-node.fixed.fulltime-node span{
  display:none;
}

.minute-node.minute95-stopwatch{
  z-index:8;
}

.minute-node.football-minute-node{
  width:52px;
  height:52px;
  background:transparent url("data:image/png;base64,") center/contain no-repeat;
  border:none;
  box-shadow:none;
  color:transparent;
  filter:drop-shadow(0 4px 8px rgba(0,0,0,.22));
  z-index:8;
}

.minute-node.football-minute-node::before,
.minute-node.football-minute-node span{
  display:none;
}

.minute-node.dice-six-node{
  width:40px;
  height:40px;
  background:transparent url("data:image/png;base64,") center/contain no-repeat;
  border:none;
  box-shadow:none;
  color:transparent;
  filter:drop-shadow(0 4px 8px rgba(0,0,0,.22));
  z-index:8;
}

.minute-node.dice-six-node::before,
.minute-node.dice-six-node span{
  display:none;
}

/* v103 — 95th-minute target stays randomised per match (1–6), but always renders as a real die face. */
.minute-node.dice-six-node.m95-random-target{
  background:linear-gradient(145deg,#ffffff 0%,#f2f4f7 100%);
  color:transparent !important;
  border:2px solid rgba(17,24,39,.88);
  border-radius:10px;
  box-shadow:0 3px 8px rgba(0,0,0,.24), inset 0 1px 0 rgba(255,255,255,.85);
  display:block;
  font-size:0;
  text-shadow:none;
}
.minute-node.dice-six-node.m95-random-target .m95-pip{
  display:block !important;
  position:absolute;
  width:7px;
  height:7px;
  border-radius:50%;
  background:#111827;
  transform:translate(-50%,-50%);
  z-index:2;
}
.minute-node.dice-six-node.m95-random-target .m95-pip.p1{left:25%;top:25%}
.minute-node.dice-six-node.m95-random-target .m95-pip.p2{left:50%;top:25%}
.minute-node.dice-six-node.m95-random-target .m95-pip.p3{left:75%;top:25%}
.minute-node.dice-six-node.m95-random-target .m95-pip.p4{left:25%;top:50%}
.minute-node.dice-six-node.m95-random-target .m95-pip.p5{left:50%;top:50%}
.minute-node.dice-six-node.m95-random-target .m95-pip.p6{left:75%;top:50%}
.minute-node.dice-six-node.m95-random-target .m95-pip.p7{left:25%;top:75%}
.minute-node.dice-six-node.m95-random-target .m95-pip.p8{left:50%;top:75%}
.minute-node.dice-six-node.m95-random-target .m95-pip.p9{left:75%;top:75%}

.halftime-label{
  position:absolute;
  z-index:4;
  transform:translate(-50%,-50%);
  pointer-events:none;
  display:flex;
  align-items:flex-end;
  justify-content:center;
  gap:1px;
  white-space:nowrap;
}

.halftime-label span{
  display:inline-block;
  font-size:19px;
  line-height:1;
  font-weight:1000;
  letter-spacing:.01em;
  color:#f7c948;
  text-transform:uppercase;
  text-shadow:
    -1px -1px 0 rgba(16,43,70,.98),
    1px -1px 0 rgba(16,43,70,.98),
    -1px 1px 0 rgba(16,43,70,.98),
    1px 1px 0 rgba(16,43,70,.98),
    0 2px 10px rgba(0,0,0,.18),
    0 0 8px rgba(255,255,255,.55);
}

.halftime-label span:nth-child(1){ transform:translateY(10px) rotate(-16deg); }
.halftime-label span:nth-child(2){ transform:translateY(6px) rotate(-12deg); }
.halftime-label span:nth-child(3){ transform:translateY(3px) rotate(-8deg); }
.halftime-label span:nth-child(4){ transform:translateY(1px) rotate(-4deg); margin-right:6px; }
.halftime-label span:nth-child(5){ transform:translateY(0px) rotate(4deg); }
.halftime-label span:nth-child(6){ transform:translateY(2px) rotate(8deg); }
.halftime-label span:nth-child(7){ transform:translateY(5px) rotate(11deg); }
.halftime-label span:nth-child(8){ transform:translateY(9px) rotate(14deg); }
.minute-node span{
  position:absolute;
  left:50%;
  top:56%;
  z-index:1;
  display:flex;
  align-items:center;
  justify-content:center;
  width:26px;
  height:26px;
  text-align:center;
  font-size:13px;
  font-weight:950;
  line-height:1;
  transform:translate(-50%,-50%);
}

/* v14 — keep Live Match Report visible to the right on normal desktop/tablet widths */
@media (min-width:900px) and (max-width:1180px){
  html, body{
    height:100%;
    overflow:hidden;
  }

  .app{
    height:100dvh;
    min-height:100dvh;
    overflow:hidden;
    grid-template-rows:70px minmax(0,1fr);
  }

  .page{
    height:100%;
    min-height:0;
    overflow:hidden;
    padding:14px 14px 16px;
    display:grid;
    grid-template-rows:auto minmax(0,1fr);
  }

  .play-layout{
    height:100%;
    min-height:0;
    overflow:hidden;
    grid-template-columns:minmax(0,1fr) 300px;
    gap:14px;
    align-items:stretch;
  }

  .board-shell{
    min-height:0;
    height:100%;
  }

  .sidebar{
    min-height:0;
    height:100%;
  }

  .live-report-card{
    min-height:0;
    height:100%;
  }
}

/* v15 — robust two-column match layout */
.page{
  width:100%;
  max-width:none;
}

.play-layout{
  display:grid !important;
  grid-template-columns:minmax(0,1fr) 340px !important;
  gap:14px !important;
  align-items:stretch !important;
  width:100%;
  min-width:0;
}

.board-shell{
  width:100%;
  min-width:0;
}

.sidebar{
  display:flex !important;
  width:340px;
  min-width:340px;
  max-width:340px;
  height:100%;
}

.live-report-card{
  display:flex !important;
  width:100%;
  height:100%;
}

/* Only stack on genuinely narrow screens */
@media (max-width:799px){
  html, body{
    overflow:auto;
  }

  .app{
    height:auto;
    min-height:100dvh;
    overflow:visible;
  }

  .page{
    height:auto;
    overflow:visible;
  }

  .play-layout{
    grid-template-columns:1fr !important;
    height:auto;
    overflow:visible;
  }

  .sidebar{
    width:100%;
    min-width:0;
    max-width:none;
    min-height:500px;
  }
}

/* v16 — force report visibly beside pitch */
@media (min-width:800px){
  html, body{
    width:100%;
    max-width:100%;
    overflow:hidden;
  }

  .page{
    width:100vw !important;
    max-width:100vw !important;
    min-width:0 !important;
    overflow:hidden !important;
    padding-left:14px !important;
    padding-right:14px !important;
  }

  .play-layout{
    display:flex !important;
    flex-direction:row !important;
    width:100% !important;
    max-width:100% !important;
    min-width:0 !important;
    gap:14px !important;
    overflow:hidden !important;
  }

  .board-shell{
    flex:1 1 auto !important;
    width:auto !important;
    min-width:0 !important;
    max-width:calc(100% - 334px) !important;
  }

  .sidebar{
    display:flex !important;
    flex:0 0 320px !important;
    width:320px !important;
    min-width:320px !important;
    max-width:320px !important;
    height:100% !important;
    visibility:visible !important;
    opacity:1 !important;
    overflow:hidden !important;
  }

  .live-report-card{
    display:flex !important;
    flex-direction:column !important;
    width:100% !important;
    min-width:0 !important;
    height:100% !important;
    visibility:visible !important;
    opacity:1 !important;
  }
}


/* v71 — first constrained dynamic-board randomiser */
.movement-layer{position:absolute;inset:0;width:100%;height:100%;z-index:6;pointer-events:none;display:block}
.dynamic-event-layer{position:absolute;inset:0;z-index:7;pointer-events:none}
.minute-node.event-covered::before,.minute-node.event-covered>span{visibility:hidden}
.dynamic-event{position:absolute;transform:translate(-50%,-50%);display:grid;place-items:center;width:72px;height:72px;z-index:7;overflow:visible;filter:drop-shadow(0 4px 6px rgba(0,0,0,.30))}
.dynamic-event img{display:block;max-width:100%;max-height:100%;object-fit:contain;pointer-events:none}
.dynamic-event.event-goal{width:72px;height:72px}
.dynamic-event.event-card{width:72px;height:72px}
.dynamic-event.event-open{width:72px;height:72px}
.dynamic-event.event-setpiece,.dynamic-event.event-injury{width:72px;height:72px}
.dynamic-event.event-setpiece img,.dynamic-event.event-injury img{width:72px;height:72px;max-width:72px;max-height:72px;object-fit:contain;object-position:center}
.minute-node.force-flash-red::before{animation:ffPulseRed .9s ease-in-out 2}
.minute-node.force-flash-yellow::before{animation:ffPulseYellow .9s ease-in-out 2}
.minute-node.force-flash-blue::before{animation:ffPulseBlue .9s ease-in-out 2}
@keyframes ffPulseRed{0%,100%{filter:drop-shadow(0 4px 8px rgba(0,0,0,.22))}50%{filter:drop-shadow(0 0 18px rgba(227,23,23,.95)) drop-shadow(0 4px 8px rgba(0,0,0,.22));transform:translate(-50%,-54%) scale(1.1)}}
@keyframes ffPulseYellow{0%,100%{filter:drop-shadow(0 4px 8px rgba(0,0,0,.22))}50%{filter:drop-shadow(0 0 18px rgba(255,213,31,.98)) drop-shadow(0 4px 8px rgba(0,0,0,.22));transform:translate(-50%,-54%) scale(1.1)}}
@keyframes ffPulseBlue{0%,100%{filter:drop-shadow(0 4px 8px rgba(0,0,0,.22))}50%{filter:drop-shadow(0 0 18px rgba(47,143,232,.98)) drop-shadow(0 4px 8px rgba(0,0,0,.22));transform:translate(-50%,-54%) scale(1.1)}}
.dynamic-event .dice-strip{position:absolute;left:50%;top:76px;transform:translateX(-50%);display:flex;gap:4px;padding:3px 4px;border-radius:8px;background:rgba(8,27,54,.94);box-shadow:0 2px 6px rgba(0,0,0,.36);white-space:nowrap;z-index:10}
.dynamic-event .dice-strip img{width:30px;height:30px;object-fit:contain;filter:none}
.dynamic-event .goal-rule-label{
  position:absolute;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  display:flex;
  align-items:center;
  justify-content:center;
  min-width:46px;
  padding:6px 9px 7px;
  border-radius:999px;
  background:rgba(8,27,54,.82);
  color:#ffd83d;
  border:1px solid rgba(255,255,255,.88);
  box-shadow:0 3px 7px rgba(0,0,0,.34);
  text-shadow:0 1px 2px rgba(0,0,0,.55);
  font-size:13px;
  line-height:1;
  font-weight:1000;
  letter-spacing:.06em;
  white-space:nowrap;
  z-index:9;
  pointer-events:none;
}

.board-generation-chip{position:absolute;left:50%;top:13px;transform:translateX(-50%);z-index:12;background:rgba(6,22,45,.78);color:#fff;border:1px solid rgba(255,255,255,.28);border-radius:999px;padding:5px 9px;font-size:11px;font-weight:800;letter-spacing:.02em;backdrop-filter:blur(5px);pointer-events:none}


/* v84 — original match-engine gameplay visuals restored */
.ff-player-token{
  position:absolute;
  width:4.4%;
  aspect-ratio:1;
  border-radius:50%;
  display:block;
  transform:translate(-50%,-50%);
  z-index:30;
  border:2px solid rgba(255,255,255,.92);
  background-color:#fff;
  background-size:100% 100%;
  background-position:center;
  background-repeat:no-repeat;
  box-shadow:0 6px 14px rgba(0,0,0,.34),inset -4px -6px 9px rgba(0,0,0,.12),inset 6px 8px 12px rgba(255,255,255,.28);
  transition:left .55s cubic-bezier(.18,.85,.26,1),top .55s cubic-bezier(.18,.85,.26,1),margin-left .24s cubic-bezier(.18,.85,.26,1),transform .2s ease,box-shadow .2s ease;
  pointer-events:none;
}
.ff-player-token::after{content:"";position:absolute;inset:-2px;border-radius:50%;box-shadow:inset 0 0 0 1px rgba(0,0,0,.08);pointer-events:none}
.ff-player-token.blue{background-image:url("data:image/png;base64,")}
.ff-player-token.red{background-image:url("data:image/png;base64,")}
.ff-player-token.active{z-index:31}
.ff-player-token.blue.active{box-shadow:0 0 0 4px #fff,0 0 0 8px rgba(47,125,255,.95),0 8px 20px rgba(0,0,0,.40)}
.ff-player-token.red.active{box-shadow:0 0 0 4px #fff,0 0 0 8px rgba(255,74,69,.95),0 8px 20px rgba(0,0,0,.40)}
.ff-turn-pill{display:none!important}

.ff-game-modal{
  position:absolute;inset:0;z-index:50;display:grid;place-items:center;
  background:rgba(30,48,67,.42);backdrop-filter:blur(4px);
  opacity:1;pointer-events:auto;transition:opacity .28s ease;
}
.ff-game-modal.hidden{opacity:0;pointer-events:none;display:grid}
.ff-game-card{position:relative;width:min(300px,72%);border-radius:24px;padding:20px 22px 22px;text-align:center;background:#f8fafc;border:1px solid #aebdca;box-shadow:0 24px 60px rgba(16,40,62,.28)}
.ff-game-kicker{color:#68829a;text-transform:uppercase;letter-spacing:1.4px;font-size:11px;font-weight:900}
.ff-game-title{margin-top:4px;font-size:24px;font-weight:950;color:#102f4d}
.ff-game-rule{margin:12px auto 0;padding:9px 12px 10px;border-radius:14px;background:#edf4fa;border:1px solid #b7ccdc;max-width:240px;color:#102f4d;font-size:14px;line-height:1.25;font-weight:800}
.ff-game-rule.hidden{display:none}
.ff-event-hero{display:grid;grid-template-columns:88px 1fr;gap:12px;align-items:center;margin:12px 0 10px;padding:14px;border-radius:18px;background:linear-gradient(180deg,#fffdf6,#f6fbff);border:1px solid #d2dfeb}
.ff-event-hero.hidden{display:none}
.ff-event-badge-wrap{width:88px;height:88px;border-radius:18px;display:grid;place-items:center;background:#eef5fb}
.ff-event-badge-wrap img{width:76px;height:76px;object-fit:contain;display:block;filter:drop-shadow(0 6px 10px rgba(0,0,0,.18))}
.ff-event-copy{text-align:left}
.ff-event-headline{font-size:16px;line-height:1.15;font-weight:1000;letter-spacing:.3px;color:#102f4d;text-transform:uppercase}
.ff-event-commentary{margin-top:6px;font-size:14px;line-height:1.35;color:#3b5872;font-weight:800}
.ff-event-targets-label{margin-top:10px;font-size:13px;line-height:1.15;color:#102f4d;font-weight:1000;text-transform:uppercase;letter-spacing:.4px}
.ff-event-targets{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.ff-event-targets.hidden,.ff-event-targets-label.hidden{display:none}
.ff-target-chip{width:32px;height:32px;border-radius:999px;display:grid;place-items:center;background:#e8eff6;border:1px solid #bfd0de;color:#587289;font-size:15px;font-weight:950;box-shadow:inset 0 1px 0 rgba(255,255,255,.7)}
.ff-target-chip.hit{background:linear-gradient(180deg,#ffe166,#ffbf1c);border-color:#d79700;color:#4a3300;box-shadow:0 3px 8px rgba(255,191,28,.26)}
.ff-game-card.event-mode{width:min(370px,84%)}
.ff-game-card.event-mode .ff-game-kicker{font-size:18px;line-height:1;font-weight:1000;letter-spacing:1.1px;color:#173a5e;margin-bottom:2px}
.ff-game-card.event-mode .ff-game-title{font-size:22px;margin-top:2px;margin-bottom:4px}
.ff-game-card.event-mode .ff-game-rule{display:none!important}
.ff-game-card.roll-info-mode .ff-game-dice-stage,
.ff-game-card.roll-info-mode .ff-roll-btn{display:none!important}
.ff-game-card.roll-info-mode{padding-bottom:20px}

.ff-event-target-box.hidden{display:none}
.ff-game-card.free-kick-mode{width:min(440px,88%);padding:18px 20px 20px}
.ff-game-card.free-kick-mode .ff-game-kicker{font-size:34px;line-height:1;font-weight:1000;letter-spacing:.4px;color:#0b2746;margin-top:4px}
.ff-game-card.free-kick-mode .ff-game-title{font-size:24px;line-height:1.05;margin-top:5px;color:#102f4d}
.ff-game-card.free-kick-mode .ff-game-rule{display:none!important}
.ff-game-card.free-kick-mode .ff-event-hero{display:block;margin:14px 0 12px;padding:0;border:0;background:transparent;box-shadow:none}
.ff-game-card.free-kick-mode .ff-event-badge-wrap{width:100%;height:178px;border-radius:18px;overflow:hidden;background:#dce9f4;box-shadow:none}
.ff-game-card.free-kick-mode .ff-event-badge-wrap img{width:100%;height:100%;object-fit:cover;filter:none}
.ff-game-card.free-kick-mode .ff-event-copy{text-align:left}
.ff-game-card.free-kick-mode .ff-event-headline{display:none}
.ff-game-card.free-kick-mode .ff-event-commentary{margin:14px 8px 12px;font-size:17px;line-height:1.28;font-weight:950;color:#173a5e}
.ff-game-card.free-kick-mode .ff-event-target-box{display:block;margin-top:8px;padding:12px 12px 14px;border-radius:18px;background:linear-gradient(180deg,#fff9e8,#fffdf6);border:1px solid #f1cf69;text-align:center}
.ff-game-card.free-kick-mode .ff-event-targets-label{display:block!important;margin:0 0 9px;font-size:16px;font-weight:1000;letter-spacing:.2px;color:#102f4d;text-transform:uppercase}
.ff-game-card.free-kick-mode .ff-event-targets{display:flex!important;justify-content:center;gap:9px;flex-wrap:nowrap;margin:0}
.ff-game-card.free-kick-mode .ff-target-chip{width:36px;height:36px;font-size:16px}

.ff-game-dice-stage{min-height:170px;display:grid;place-items:center;perspective:700px;margin:2px 0 4px}
.ff-game-die{width:86px;height:86px;position:relative;transform-style:preserve-3d;-webkit-transform-style:preserve-3d;backface-visibility:hidden;-webkit-backface-visibility:hidden;transform:rotateX(-15deg) rotateY(25deg);transition:transform .12s linear}
.ff-game-die.rolling{animation:ffSpinDice 1s cubic-bezier(.2,.7,.2,1)}
@keyframes ffSpinDice{0%{transform:rotateX(0) rotateY(0) rotateZ(0) scale(1)}35%{transform:rotateX(310deg) rotateY(185deg) rotateZ(95deg) scale(1.13)}70%{transform:rotateX(640deg) rotateY(490deg) rotateZ(215deg) scale(.98)}100%{transform:rotateX(900deg) rotateY(720deg) rotateZ(360deg) scale(1)}}
.ff-game-die .face{position:absolute;width:86px;height:86px;border-radius:16px;background:#fff;color:#111;border:2px solid rgba(0,0,0,.08);box-shadow:inset 0 0 18px rgba(0,0,0,.08);display:grid;place-items:center;font-size:58px;font-weight:950;line-height:1;font-variant-numeric:tabular-nums;backface-visibility:hidden;-webkit-backface-visibility:hidden}
.ff-game-die .f1{transform:translateZ(43px)}.ff-game-die .f6{transform:rotateY(180deg) translateZ(43px)}.ff-game-die .f2{transform:rotateY(90deg) translateZ(43px)}.ff-game-die .f5{transform:rotateY(-90deg) translateZ(43px)}.ff-game-die .f3{transform:rotateX(90deg) translateZ(43px)}.ff-game-die .f4{transform:rotateX(-90deg) translateZ(43px)}
.ff-roll-btn{width:100%;border:1px solid #2f8fe8;border-radius:10px;padding:15px 18px;font-weight:950;font-size:17px;cursor:pointer;background:#2f8fe8;color:#fff;box-shadow:0 6px 14px rgba(47,143,232,.22);transition:.12s ease}
.ff-roll-btn:hover{background:#1879d3;border-color:#1879d3}.ff-roll-btn:active{transform:translateY(2px)}.ff-roll-btn:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none}
.ff-dice-collapse{position:absolute;top:10px;right:10px;width:34px;height:34px;border-radius:50%;border:1px solid #173a5e;background:#173a5e;color:#fff;font-size:24px;line-height:1;cursor:pointer;display:grid;place-items:center;font-weight:950}