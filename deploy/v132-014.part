  </div>
</div>
<button class="ff-dice-restore hidden" id="ffDiceRestoreBtn" type="button" aria-label="Open dice">🎲 <span id="ffDiceRestoreLabel">Blue team to roll</span></button>
      </div>

      <aside class="sidebar">
        <section class="live-report-card">
          <div class="live-report-header">
            <h2 class="live-report-title">Live Match Report</h2>
            <div class="live-clock">54'</div>
          </div>

          <div class="live-report-feed">
            <div class="report-entry">
              <div class="report-icon">⚽</div>
              <div class="report-copy">
                <div class="report-head">Home Team</div>
                <div class="report-body">Number 11 cuts inside and curls a lovely finish into the far corner.</div>
              </div>
              <div class="report-minute">54'</div>
            </div>

            <div class="report-entry">
              <div class="report-icon">🧤</div>
              <div class="report-copy">
                <div class="report-head">Away Team</div>
                <div class="report-body">A huge save keeps them in it. The keeper gets down sharply to deny Number 9.</div>
              </div>
              <div class="report-minute">47'</div>
            </div>

            <div class="report-entry">
              <div class="report-icon">⏸️</div>
              <div class="report-copy">
                <div class="report-head">Half-time</div>
                <div class="report-body">Level at the break. Both sides have had moments and it still feels wide open.</div>
              </div>
              <div class="report-minute">45'</div>
            </div>

            <div class="report-entry">
              <div class="report-icon">🟨</div>
              <div class="report-copy">
                <div class="report-head">Away Team</div>
                <div class="report-body">A late challenge brings the first booking of the game. That could slow them down.</div>
              </div>
              <div class="report-minute">38'</div>
            </div>

            <div class="report-entry">
              <div class="report-icon">⚽</div>
              <div class="report-copy">
                <div class="report-head">Away Team</div>
                <div class="report-body">A lively move down the flank ends with Number 7 sliding home the equaliser.</div>
              </div>
              <div class="report-minute">22'</div>
            </div>

            <div class="report-entry">
              <div class="report-icon">🚀</div>
              <div class="report-copy">
                <div class="report-head">Kick Off</div>
                <div class="report-body">And we are under way. The dynamic-pitch shell is ready for the coordinate layer next.</div>
              </div>
              <div class="report-minute">0'</div>
            </div>
          </div>
        </section>

        <section class="ff-standard-dice-card" id="ffStandardDiceCard" aria-label="Standard dice roll">
          <div class="ff-standard-dice-kicker" id="ffStandardDiceKicker">BLUE TEAM</div>
          <div class="ff-standard-dice-title" id="ffStandardDiceTitle"></div>
          <button class="ff-sidebar-dice-click" id="ffSidebarRollBtn" type="button" aria-label="Roll dice for Blue team">
            <div class="ff-game-die" id="ffSidebarDie" aria-hidden="true">
              <div class="face f1">1</div><div class="face f2">2</div><div class="face f3">3</div><div class="face f4">4</div><div class="face f5">5</div><div class="face f6">6</div>
            </div>
            <div class="ff-sidebar-dice-hint" id="ffSidebarDiceHint">Click dice to roll</div>
          </button>
        </section>
      </aside>
    </section>
  </main>
</div>

<script>
  // v116 — move all full-screen modal backdrops out of the isolated/clipped board-shell.
  // The board-shell creates its own stacking context, so even very large z-index values
  // could not reliably cover the sibling Live Match Report. Body-level overlays can.
  ['ffShootoutTransition','ffResultBackdrop','ffSummaryBackdrop'].forEach(id=>{
    const el=document.getElementById(id);
    if(el && el.parentElement!==document.body) document.body.appendChild(el);
  });

  const initialMatchSnapshot = {
    homeScore: document.querySelector('.score span:nth-child(1)')?.textContent || '0',
    awayScore: document.querySelector('.score span:nth-child(3)')?.textContent || '0',
    halfTime: document.querySelector('.half-time-score')?.textContent || '',
    minute: document.querySelector('.match-minute')?.textContent || "0'",
    report: document.querySelector('.live-report-feed')?.innerHTML || ''
  };

  document.getElementById('restartMatchBtn')?.addEventListener('click', () => {
    const scoreParts = document.querySelectorAll('.score span');
    if (scoreParts[0]) scoreParts[0].textContent = '0';
    if (scoreParts[2]) scoreParts[2].textContent = '0';

    const halfTime = document.querySelector('.half-time-score');
    if (halfTime) halfTime.textContent = '';

    const minute = document.querySelector('.match-minute');
    if (minute) minute.textContent = "0'";

    const liveClock = document.querySelector('.live-clock');
    if (liveClock) liveClock.textContent = "0'";

    const report = document.querySelector('.live-report-feed');
    if (report) {
      report.innerHTML = `
        <div class="report-entry">
          <div class="report-icon">🚀</div>
          <div class="report-copy">
            <div class="report-head">Kick Off</div>
            <div class="report-body">New match ready. Dynamic board generation will be wired into this reset next.</div>
          </div>
          <div class="report-minute">0'</div>
        </div>
      `;
    }
  });

  document.getElementById('quickSimBtn')?.addEventListener('click', () => {
    alert('Quick Sim will be wired when the current match-engine mechanics are migrated into this dynamic board.');
  });
</script>


<script id="footballFortuneDynamicBoardV71">
(() => {
  'use strict';
  const ASSET = {"goal": "data:image/png;base64,", "yellow": "data:image/png;base64,", "free": "data:image/png;base64,", "penalty": "data:image/png;base64,", "injury": "data:image/png;base64,", "open": "data:image/png;base64,", "d1": "data:image/png;base64,", "d2": "data:image/png;base64,", "d3": "data:image/png;base64,", "d4": "data:image/png;base64,", "d5": "data:image/png;base64,", "d6": "data:image/png;base64,