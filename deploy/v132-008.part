") center/100% 100% no-repeat;
    box-shadow:
      inset 0 0 0 2px rgba(255,255,255,.18),
      0 18px 28px rgba(15,43,26,.20);
  }

  .pitch svg{
    display:none;
  }

  .layer-tag{
    position:absolute;
    top:16px;
    left:18px;
    z-index:4;
    padding:8px 12px;
    border-radius:999px;
    background:rgba(255,255,255,.88);
    border:1px solid rgba(20,50,78,.12);
    color:#4f6a80;
    font-size:12px;
    font-weight:900;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  .board-note{
    position:absolute;
    left:24px;
    right:24px;
    bottom:24px;
    z-index:3;
    padding:14px 16px;
    border-radius:18px;
    background:rgba(255,255,255,.92);
    border:1px solid rgba(20,50,78,.10);
    color:#51697e;
    font-size:13px;
    line-height:1.4;
    box-shadow:0 10px 20px rgba(19,45,69,.08);
  }

  .sidebar{
    min-width:0;
    display:flex;
  }

  .live-report-card{
    width:100%;
    height:100%;
    background:#fff;
    color:#142018;
    border:1px solid rgba(0,0,0,.10);
    border-radius:26px;
    box-shadow:0 14px 34px rgba(0,0,0,.10);
    display:flex;
    flex-direction:column;
    overflow:hidden;
  }

  .live-report-header{
    position:sticky;
    top:0;
    z-index:1;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    padding:18px 18px 16px;
    border-bottom:1px solid rgba(0,0,0,.08);
    background:#fff;
  }
  .live-report-title{
    margin:0;
    font-size:18px;
    font-weight:950;
    color:#102016;
  }
  .live-clock{
    min-width:66px;
    text-align:center;
    padding:8px 12px;
    border-radius:999px;
    background:#edf4fa;
    border:1px solid #cfdeea;
    color:#345771;
    font-size:18px;
    font-weight:950;
  }

  .live-report-feed{
    flex:1;
    min-height:0;
    overflow-y:auto;
    padding:14px 18px 18px;
    background:#fff;
  }
  .report-entry{
    display:grid;
    grid-template-columns:auto 1fr auto;
    gap:12px;
    align-items:start;
    padding:12px 0;
    border-bottom:1px solid rgba(16,32,22,.08);
  }
  .report-entry:last-child{
    border-bottom:0;
  }
  .report-icon{
    width:34px;
    height:34px;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:#eef3f7;
    font-size:18px;
  }
  .report-copy{
    min-width:0;
  }
  .report-head{
    font-size:13px;
    font-weight:950;
    color:#18324e;
    margin-bottom:4px;
  }
  .report-body{
    font-size:13px;
    line-height:1.45;
    color:#577086;
  }
  .report-minute{
    font-size:12px;
    font-weight:950;
    color:#6c8397;
    white-space:nowrap;
    padding-top:2px;
  }

  @media (max-width: 1180px){
    .play-layout{
      grid-template-columns:1fr;
    }
    .board-shell{
      min-height:640px;
    }
    .sidebar{
      min-height:520px;
    }
  }

  @media (max-width: 760px){
    .page{ padding:12px; }
    .scoreboard{
      grid-template-columns:1fr;
      text-align:center;
    }
    .team,
    .team.away{
      justify-content:center;
      text-align:center;
    }
    .play-layout{
      grid-template-columns:1fr;
    }
    .board-shell{
      min-height:520px;
    }
    .pitch-stage{
      inset:14px;
    }
  }

/* v2 — fit pitch + live report into the viewport with no page scrolling */
html, body{
  height:100%;
  overflow:hidden;
}

.app{
  height:100dvh;
  min-height:100dvh;
  grid-template-rows:70px minmax(0,1fr);
  overflow:hidden;
}

.page{
  height:100%;
  min-height:0;
  overflow:hidden;
  display:grid;
  grid-template-rows:auto minmax(0,1fr);
  gap:0;
}

.scoreboard{
  margin-bottom:14px;
}

.play-layout{
  min-height:0;
  height:100%;
  overflow:hidden;
}

.board-shell{
  min-height:0;
  height:100%;
}

.sidebar{
  min-height:0;
  height:100%;
}

.live-report-card{
  min-height:0;
  height:100%;
}

.live-report-feed{
  min-height:0;
  overflow-y:auto;
}

/* Fill the whole board card with the pitch image */
.pitch-stage{
  inset:0;
}

.board-note{
  bottom:16px;
  padding:10px 14px;
  font-size:12px;
}

/* Keep desktop/tablet prototype on one screen */
@media (min-width:1181px){
  .page{
    padding:14px 18px 16px;
  }
}

@media (max-width:1180px){
  body{
    overflow:auto;
  }
  .app{
    height:auto;
    min-height:100dvh;
    overflow:visible;
  }
  .page{
    height:auto;
    overflow:visible;
  }
  .play-layout{
    height:auto;
    overflow:visible;
  }
  .board-shell{
    min-height:620px;
  }
  .sidebar{
    min-height:520px;
  }
}

/* v11 — simplified fixed minute route */
.coordinate-layer{
  position:absolute;
  inset:0;
  z-index:5;
  pointer-events:none;
}

.route-layer{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  pointer-events:none;
  z-index:1;
  display:block;
}

.minute-node{
  position:absolute;
  z-index:3;
  width:52px;
  height:52px;
  transform:translate(-50%,-50%);
  border:none;
  display:grid;
  place-items:center;
  background:none;
  overflow:visible;
  color:#173a5e;
  font-size:12px;
  font-weight:950;
  line-height:1;
}

.minute-node::before{
  content:"";
  position:absolute;
  left:50%;
  top:50%;
  width:52px;
  height:52px;
  transform:translate(-50%,-54%);
  background:transparent url("data:image/png;base64,") center/contain no-repeat;
  filter:drop-shadow(0 2px 4px rgba(0,0,0,.18));
  z-index:0;
  pointer-events:none;
}

.minute-node.kickoff-node{
  width:128px;
  height:128px;
  background:transparent url("data:image/png;base64,