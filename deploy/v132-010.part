  #ffjTournamentSetup .ffj-team-select-badge .ffj-club-badge{width:38px;height:38px}
  #ffjTournamentSetup .ffj-size-option{min-height:52px}
  #ffjTournamentSetup .ffj-tournament-setup-actions{margin-top:8px}
  #ffjTournamentSetup .ffj-secondary-action,#ffjTournamentSetup .ffj-primary-action{min-height:38px}
  .ffj-tournament-side-copy{padding-bottom:24px}
}

</style>
