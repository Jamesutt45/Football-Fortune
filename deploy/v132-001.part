<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Football Fortune — v101 Integrated Penalty Shootout</title>
<style>
  :root{
    --page:#e8eef3;
    --page-2:#dfe7ee;
    --surface:#ffffff;
    --surface-soft:#f5f8fb;
    --border:#b8c7d5;
    --navy:#14324e;
    --navy-2:#20496f;
    --slate:#5d7387;
    --blue:#2f8fe8;
    --blue-2:#1677d2;
    --green-1:#2f8c4c;
    --green-2:#338e4e;
    --green-3:#2d7a44;
    --green-4:#2f8450;
    --white:#ffffff;
  }

  *{ box-sizing:border-box; }
  html,body{ height:100%; }
  body{
    margin:0;
    background:linear-gradient(180deg,var(--page) 0%, var(--page-2) 100%);
    color:var(--navy);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .app{
    min-height:100vh;
    display:grid;
    grid-template-rows:auto auto 1fr;
  }

  .ff-appbar{
    height:70px;
    padding:0 18px 0 20px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    background:linear-gradient(180deg,#f9fbfd 0%, #eef3f7 100%);
    border-bottom:1px solid #aebdca;
    box-shadow:0 4px 14px rgba(23,53,82,.08);
    overflow:visible;
    position:relative;
    z-index:200;
  }
  .ff-appbar-title{
    font-size:19px;
    font-weight:950;
    letter-spacing:-.01em;
    color:var(--navy);
  }
  .ff-appbar-actions{
    display:flex;
    align-items:center;
    gap:8px;
  }
  .ghost,
  .ff-menu-btn,
  .ff-icon-btn{
    height:40px;
    border-radius:10px;
    border:1px solid #afbfcc;
    background:#f9fbfd;
    color:var(--navy);
    padding:0 14px;
    font:inherit;
    font-weight:850;
    cursor:pointer;
  }
  .ff-icon-btn{
    width:42px;
    padding:0;
    display:grid;
    place-items:center;
  }
  .ff-menu-wrap{
    position:relative;
    z-index:30000;
  }
  .ff-menu-panel{
    position:absolute!important;
    top:calc(100% + 8px)!important;
    right:0!important;
    z-index:30001!important;
    width:220px!important;
    min-width:220px!important;
    padding:8px!important;
    border:1px solid #c9d7e2!important;
    border-radius:14px!important;
    background:#ffffff!important;
    box-shadow:0 16px 40px rgba(20,50,78,.22)!important;
    overflow:hidden!important;
  }
  .ff-menu-panel::before{
    content:"";
    position:absolute;
    top:-6px;
    right:24px;
    width:10px;
    height:10px;
    background:#fff;
    border-left:1px solid #c9d7e2;
    border-top:1px solid #c9d7e2;
    transform:rotate(45deg);
  }
  .ff-menu-panel.hidden{display:none!important}
  .ff-menu-item{
    width:100%!important;
    min-height:48px!important;
    display:flex!important;
    align-items:center!important;
    gap:11px!important;
    border:0!important;
    border-radius:10px!important;
    background:transparent!important;
    color:#17385f!important;
    padding:0 12px!important;
    text-align:left!important;
    font:inherit!important;
    font-size:14px!important;
    font-weight:850!important;
    cursor:pointer!important;
  }
  .ff-menu-item:hover{background:#eef4f8!important}
  .ff-menu-item-icon{
    width:20px;
    height:20px;
    display:grid;
    place-items:center;
    flex:0 0 20px;
    color:#5f7488;
  }
  .ff-menu-item-icon svg{
    width:19px;
    height:19px;
    stroke:currentColor;
    fill:none;
  }
  .ff-menu-logout{color:#9f2d2d!important}
  .ff-menu-logout .ff-menu-item-icon{color:#9f2d2d}
  .ff-menu-logout:hover{background:#fff1f1!important}
  .ff-home-btn{
    background:var(--navy);
    color:#fff;
    border-color:var(--navy);
  }
  .ff-icon-btn svg{
    width:21px;
    height:21px;
    stroke:currentColor;
  }

  .page{
    width:min(1800px, 100%);
    margin:0 auto;
    padding:18px;
  }

  .scoreboard{
    background:linear-gradient(180deg,#f6f9fb 0%, #edf3f7 100%);
    border:1px solid var(--border);
    border-radius:24px;
    box-shadow:0 8px 20px rgba(28,59,86,.08);
    padding:16px 20px;
    display:grid;
    grid-template-columns:1fr auto 1fr;
    gap:16px;
    align-items:center;
    margin-bottom:16px;
  }
  .team{
    display:flex;
    align-items:center;
    gap:12px;
  }
  .team.away{
    justify-content:flex-end;
    text-align:right;
  }
  .kit{
    width:42px;
    height:42px;
    border-radius:50%;
    display:grid;
    place-items:center;
    font-weight:950;
    color:#fff;
    box-shadow:0 6px 14px rgba(0,0,0,.12);
  }
  .kit.home{ background:#347fe8; }
  .kit.away{ background:#ef5656; }
  .team-name{ font-size:16px; font-weight:950; color:var(--navy); }
  .team-role{ font-size:12px; font-weight:800; color:var(--slate); margin-top:2px; }
  .score-centre{
    text-align:center;
  }
  .score{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    font-size:40px;
    line-height:1;
    font-weight:950;
    color:var(--navy);
    letter-spacing:-1px;
  }
  .half-time-score{
    margin-top:6px;
    font-size:13px;
    font-weight:900;
    color:#5a7086;
  }
  .match-minute{
    margin-top:6px;
    font-size:14px;
    font-weight:950;
    color:#4a657c;
  }

  .play-layout{
    display:grid;
    grid-template-columns:minmax(0, 1fr) 360px;
    gap:18px;
    align-items:stretch;
  }

  .board-shell{
    position:relative;
    min-height:720px;
    border-radius:34px;
    background:linear-gradient(180deg,#e8eef3 0%, #dce5ed 100%);
    border:1px solid var(--border);
    box-shadow:0 18px 36px rgba(28,59,86,.12);
    overflow:hidden;
    isolation:isolate;
    padding:0;
  }

  .pitch-stage{
    position:absolute;
    inset:0;
    display:grid;
    place-items:center;
  }

  .pitch{
    position:relative;
    width:100%;
    height:100%;
    border-radius:22px;
    overflow:hidden;
    background:#0d7f23 url("data:image/png;base64,