':(window.FOOTBALL_FORTUNE_ASSET?.[opts.kind]||'');
      $('#ffEventHeadline').textContent=opts.headline||'';
      $('#ffEventCommentary').textContent=opts.commentary||'';
      renderEventTargets(opts.numbers||[]);
    }else{
      card.classList.remove('event-mode','free-kick-mode');
      if(!isChance)card.classList.remove('roll-info-mode');
      hero.classList.add('hidden');
      if(kicker!=='95TH MINUTE')heroImg.removeAttribute('src');
      $('#ffEventHeadline').textContent='';
      $('#ffEventCommentary').textContent='';
      renderEventTargets([]);
    }

    const d=$('#ffGameDie');
    d.classList.remove('rolling');
    if(!state.busy)d.style.transform='rotateX(-15deg) rotateY(25deg)';
    updateStandardDiceAvailability();
  }
  function hideGameModalForRoll(){
    const m=$('#ffGameModal');
    m.classList.add('hidden');
    m.setAttribute('aria-hidden','true');
    $('#ffDiceRestoreBtn').classList.add('hidden');
  }
  function setBusy(v){state.busy=v;$('#ffRollBtn').disabled=v;updateStandardDiceAvailability();}