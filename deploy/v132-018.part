  function randomDie(){return 1+Math.floor(Math.random()*6);}
  function updateM95TargetDisplay(){
    const target=state?.m95Target||6;
    const die=node('m95-dice');
    if(!die)return;
    const faces={
      1:[5],
      2:[1,9],
      3:[1,5,9],
      4:[1,3,7,9],
      5:[1,3,5,7,9],
      6:[1,3,4,6,7,9]
    };
    die.classList.add('m95-random-target');
    die.innerHTML=(faces[target]||faces[6]).map(pos=>`<span class="m95-pip p${pos}" aria-hidden="true"></span>`).join('');
    die.title=`Roll a ${target}`;
    die.setAttribute('aria-label',`95th-minute target: roll a ${target}`);
  }
  async function animateMove(player,toIndex){
    const el=token(player);
    const direction=toIndex>=state.pos[player]?1:-1;
    while(state.pos[player]!==toIndex){
      const fromIndex=state.pos[player];
      const nextIndex=fromIndex+direction;
      const from=ROUTE[fromIndex], to=ROUTE[nextIndex];
      // Every single board-space movement uses exactly the same travel time.
      await window.FOOTBALL_FORTUNE_ROUTE.movePieceAlongRoute(el,from,to,255);
      state.pos[player]=nextIndex;
      placeTokens();
      updateClock();

      // Half time must enter the report at the exact point the FIRST marker reaches 45.
      // If the roll continues beyond 45, this is reported before the marker moves on
      // and before commentary for the eventual landing node.
      if(ROUTE[nextIndex]==='halftime'&&!state.halfTimeCalled){
        await callHalfTime();
      }

      // Human-counting pause: the marker visibly settles on each node before moving again.
      await wait(185);
    }
  }
  function pulseDestination(id,color){ const n=node(id); if(!n)return; const layer=$('#coordinateLayer'),r=layer.getBoundingClientRect(),nr=n.getBoundingClientRect(); const p=document.createElement('div');p.className=`ff-destination-pulse ${color}`;p.style.left=(nr.left-r.left+nr.width/2)+'px';p.style.top=(nr.top-r.top+nr.height/2)+'px';layer.appendChild(p);setTimeout(()=>p.remove(),1400); }
  let lastGoalStyle=null;
  function pick(lines){return lines[Math.floor(Math.random()*lines.length)];}
  function pickGoalStyle(styles){const available=styles.filter(s=>s.id!==lastGoalStyle),pool=available.length?available:styles,chosen=pool[Math.floor(Math.random()*pool.length)];lastGoalStyle=chosen.id;return chosen.text();}
  function scoreLine(){return `${state.score.blue}–${state.score.red}`;}
  function unavailableNumbers(player){return new Set((state?.unavailable?.[player]||[]).map(Number));}
  function markUnavailable(player,n){if(!player||!n)return;state.unavailable=state.unavailable||{blue:[],red:[]};state.unavailable[player]=state.unavailable[player]||[];if(!state.unavailable[player].includes(Number(n)))state.unavailable[player].push(Number(n));}
  function resolvePlayerInjury(player,team){
    const n=shirtNumber(pick(['defender','attacker']),player);
    // Most injury stoppages are knocks a player can recover from; a meaningful minority force them off.
    const forcedOff=Math.random()<0.38;
    if(forcedOff){
      markUnavailable(player,n);
      return {
        number:n,
        forcedOff:true,
        text:pick([
          `Number ${n} is unable to continue for ${team} after the knock and has to come off.`,
          `Bad news for ${team}: Number ${n} cannot shake off the injury and their match is over.`,
          `Number ${n} tries to continue but signals to the bench — ${team} will have to replace them.`
        ])
      };
    }
    return {
      number:n,
      forcedOff:false,
      text:pick([
        `Number ${n} needs treatment for ${team}, but after a nervous pause they are able to carry on.`,
        `${team} have a scare as Number ${n} goes down, but they recover and stay on the pitch.`,
        `Number ${n} takes a painful knock for ${team}. Treatment does the job and they are fit to continue.`
      ])
    };
  }
  function availablePick(player,pool){const banned=player?unavailableNumbers(player):new Set();const available=pool.filter(n=>!banned.has(n));return pick(available.length?available:pool);}
  function shirtNumber(role='attacker',player=null){const pools={defender:[2,3,4,5,6],attacker:[7,8,9,10,11],substitute:[12,13,14,15,16,17,18,19,20]};return availablePick(player,pools[role]||pools.attacker);}
  function captainNumber(player){return state?.captains?.[player]||8;}
  function isCaptainNumber(player,n){return Number(n)===Number(captainNumber(player));}
  function chooseAssistNumber(player,scorerNo,commentary,kind='goal'){
    const text=(commentary||'').toLowerCase();
    if(kind==='penalty'||kind==='free'||/own goal|own net|individual brilliance|mistake at the back|huge slice of luck/.test(text))return null;
    if(Math.random()>.38)return null;
    const banned=unavailableNumbers(player);
    const pool=[captainNumber(player),6,8,10,7,11,2,3,4,5]
      .filter((n,i,a)=>a.indexOf(n)===i)
      .filter(n=>Number(n)!==Number(scorerNo)&&!banned.has(Number(n)));
    return pool.length?pick(pool):null;
  }
  function assistLiveLine(n){
    const role=summaryRole(Number(n));
    if(['full-back','winger'].includes(role)){
      return pick([
        `Number ${n} whipped a perfect cross into the danger area.`,
        `A superb delivery from Number ${n} put the chance on a plate.`,
        `Number ${n} bent an inviting ball right across the six-yard box.`
      ]);
    }
    if(['midfielder','attacking midfielder'].includes(role)){
      return pick([
        `Number ${n} split the defence with a wonderful through ball.`,
        `An unplayable pass from Number ${n} opened the defence completely.`,
        `Number ${n} spotted the run early and threaded a beautiful pass through.`
      ]);
    }
    return pick([
      `Number ${n} produced a brilliant final ball to create the opening.`,
      `A beautifully weighted pass from Number ${n} unlocked the defence.`,
      `Number ${n} carved the chance open with an excellent piece of vision.`
    ]);
  }
  function defenderCharacter(player){return pick([{label:'centre-back',number:shirtNumber('defender',player)},{label:'full-back',number:shirtNumber('defender',player)},{label:'overlapping full-back',number:shirtNumber('defender',player)},{label:'quick defender',number:shirtNumber('defender',player)},{label:'young full-back',number:shirtNumber('defender',player)}]);}
  function midfieldCharacter(player){return pick([{label:'midfielder',number:availablePick(player,[7,8,10,11])},{label:'box-to-box midfielder',number:availablePick(player,[8,10])},{label:'playmaker',number:availablePick(player,[8,10,11])},{label:'attacking midfielder',number:availablePick(player,[8,10,11])}]);}
  function wingerCharacter(player){return pick([{label:'winger',number:availablePick(player,[7,11])},{label:'wide player',number:availablePick(player,[7,11])},{label:'flying winger',number:availablePick(player,[7,11])},{label:'tricky winger',number:availablePick(player,[7,11])}]);}
  function goalMoment(kind,team,player){const n=shirtNumber('attacker',player);
    if(kind==='penalty')return pick([`Cool as you like from Number ${n}! ${team} tuck the penalty away.`,`Number ${n} sends the keeper the wrong way. A brilliant penalty.`,`That was nerveless from Number ${n} — ${team} make no mistake from the spot.`,`A little fortunate! The keeper gets close, but Number ${n}'s penalty finds the net.`]);
    if(kind==='free')return pick([`WHAT A GOAL! Number ${n} bends the free kick beautifully into the net.`,`Stunning from Number ${n}! The free kick flies over the wall and in.`,`Number ${n} catches everyone out with a clever free kick — brilliant thinking.`,`A touch of luck for Number ${n}! The free kick takes a nick and ends up in the net.`]);
    if(kind==='late')return pick([`Number ${n} delivers when it matters most! A huge goal for ${team}.`,`Late heroics from Number ${n}! ${team} have found something right at the end.`,`Number ${n} pops up with a massive goal at the perfect time.`]);
    return pickGoalStyle([
      {id:'team-goal',text:()=>`What a team goal from ${team}! A slick passing move ends with Number ${shirtNumber('attacker',player)} sweeping it home.`},
      {id:'individual',text:()=>`Individual brilliance from Number ${shirtNumber('attacker',player)}! They beat their player and produce a superb finish.`},
      {id:'centre-back-corner',text:()=>{const p=defenderCharacter(player);return `The ${p.label}, Number ${p.number}, attacks the corner brilliantly and heads it home!`; }},
      {id:'full-back-arrival',text:()=>{const p=defenderCharacter(player);return `The ${p.label}, Number ${p.number}, arrives late in the box and finishes like a striker!`; }},
      {id:'midfield-run',text:()=>{const p=midfieldCharacter(player);return `A superb late run from the ${p.label}, Number ${p.number}, and they bury the chance.`;}},
      {id:'midfield-strike',text:()=>{const p=midfieldCharacter(player);return `The ${p.label}, Number ${p.number}, takes aim from distance — what a strike!`; }},
      {id:'winger-solo',text:()=>{const p=wingerCharacter(player);return `The ${p.label}, Number ${p.number}, cuts inside and produces a brilliant finish.`;}},
      {id:'winger-backpost',text:()=>{const p=wingerCharacter(player);return `The ${p.label}, Number ${p.number}, sneaks in at the back post and turns it home.`;}},
      {id:'long-range',text:()=>`WHAT A STRIKE! Number ${shirtNumber('attacker',player)} lets fly from distance and it absolutely flies in.`},
      {id:'poacher',text:()=>`Number ${shirtNumber('attacker',player)} reacts quickest in the box — a proper poacher's goal.`},
      {id:'defensive-error',text:()=>`A mistake at the back gifts ${team} the chance, and Number ${shirtNumber('attacker',player)} makes them pay.`},
      {id:'own-goal',text:()=>`Oh no! A defender gets the final touch and turns it into their own net. ${team} won't care — it counts!`},
      {id:'lucky-break',text:()=>`A huge slice of luck for ${team}! The ball ricochets kindly and Number ${shirtNumber('attacker',player)} pokes it home.`},
      {id:'keeper-parry',text:()=>`The keeper can only parry it, and Number ${shirtNumber('attacker',player)} is first to the rebound.`},
      {id:'one-two',text:()=>`Lovely football! A quick one-two opens the defence and Number ${shirtNumber('attacker',player)} finishes it beautifully.`},
      {id:'scramble',text:()=>`Chaos in the box! The ball won't clear and Number ${shirtNumber('attacker',player)} finally forces it over the line.`}
    ]);
  }
  function goalCommentary(player,beforeBlue,beforeRed,kind='goal'){
    const minute=currentMinute(),scorer=teamName(player),opponent=teamName(other(player)),sa=state.score[player],oa=state.score[other(player)],sb=player==='blue'?beforeBlue:beforeRed,ob=player==='blue'?beforeRed:beforeBlue,moment=goalMoment(kind,scorer,player);
    if(state.finalTurnFor===player){if(sa===oa)return `${moment} UNBELIEVABLE! ${scorer} score with their final chance and force it to ${scoreLine()}. We're heading for penalties!`;if(sa>oa&&sb===ob)return `${moment} INCREDIBLE! ${scorer} grab a winner with the very last chance of the match — ${scoreLine()}!`;if(sa>oa)return `${moment} ${scorer} score with the final attack and finish the match in style at ${scoreLine()}.`;return `${moment} ${scorer} find a last-gasp goal, but the final whistle is moments away at ${scoreLine()}.`;}
    if(sa===oa){if(minute>=90)return `${moment} ${scorer} equalise right at the death — it's ${scoreLine()}!`;if(minute>=80)return `${moment} A huge late equaliser for ${scorer}. We're all square at ${scoreLine()}.`;if(minute<=10)return `${moment} What a start — ${scorer} hit straight back and make it ${scoreLine()}.`;return `${moment} ${scorer} are level again at ${scoreLine()}.`;}
    if(sb===ob&&sa>oa){if(minute<=5)return `${moment} What an electric start — ${scorer} lead ${scoreLine()} after just ${minute} minutes.`;if(minute<=12)return `${moment} A fast start from ${scorer}, who move ${scoreLine()} in front.`;if(minute>=90)return `${moment} ${scorer} take the lead right at the death! It's ${scoreLine()}.`;if(minute>=80)return `${moment} A massive late goal puts ${scorer} ${scoreLine()} ahead.`;return `${moment} ${scorer} break the deadlock and lead ${scoreLine()}.`;}
    if(sa>oa&&sb>ob){if(minute>=85)return `${moment} That could finish it — ${scorer} stretch their lead to ${scoreLine()} late on.`;return `${moment} ${scorer} extend their lead to ${scoreLine()}. ${opponent} have work to do now.`;}
    if(minute>=90)return `${moment} Late drama! That could be decisive at ${scoreLine()}.`;if(minute>=80)return `${moment} A big late goal for ${scorer}. It's now ${scoreLine()}.`;return `${moment} ${scorer} make it ${scoreLine()}.`;
  }
  function missedChanceCommentary(kind,player){const minute=currentMinute(),team=teamName(player),late=minute>=85;
    if(kind==='penalty')return late?pick([`What a miss! ${team} had a huge late chance from the spot and can't take it.`,`Saved! The keeper guesses right and denies ${team} from the penalty spot.`,`How have they missed that? ${team} had the perfect chance to change the match.`,`Pressure tells! ${team} fail from the spot with the game on the line.`]):pick([`${team} miss from the spot! That's a big opportunity gone.`,`What a save! The keeper gets across brilliantly and keeps the penalty out.`,`They've put it wide! ${team} will know that was a golden chance.`,`The penalty is saved — superb goalkeeping under pressure.`]);
    if(kind==='free')return pick([`${team} go for goal from the free kick, but it doesn't come off.`,`What a save! The keeper claws the free kick away.`,`So close from ${team} — just over the bar.`,`That was ambitious from ${team}. A tough chance, and it never quite dipped in time.`,`A wicked free kick from ${team}, but the keeper gets a strong hand to it.`]);
    if(late)return pick([`How have they missed that? ${team} had a huge late chance and somehow let it go.`,`What a save! The keeper may just have rescued the match.`,`Off the woodwork! ${team} were centimetres from a dramatic late goal.`,`That could have been the moment. ${team} had the chance, but not the finish.`,`A really difficult chance late on — ${team} almost pulled off something special.`]);
    return pick([`How have they missed that? It looked easier to score than miss.`,`That was a sitter! ${team} won't get many better chances than that.`,`What a save! The keeper has somehow kept ${team} out.`,`A brilliant stop denies ${team}. That looked destined for the net.`,`That was a tough chance. ${team} did well to create it, but couldn't quite finish.`,`${team} snatch at the chance and drag it wide.`,`Off the post! ${team} were inches away.`,`The keeper stands tall and makes a huge save.`,`A difficult angle for ${team}. They try their luck, but it's always drifting wide.`,`So close! ${team} beat the keeper but not the crossbar.`,`A great opening, but ${team} can't find the final touch.`,`The chance falls kindly, but ${team} blaze it over.`]);
  }
  function matchFlowSnapshot(){
    const f=state.matchFlow||{goals:0,chances:0,cards:0,reds:0,injuries:0};
    const goals=state.score.blue+state.score.red;
    return {goals,chances:f.chances||0,cards:f.cards||0,reds:f.reds||0,injuries:f.injuries||0,activity:goals+(f.chances||0)+(f.cards||0)+(f.injuries||0)};
  }
  function matchTone(minute){
    const f=matchFlowSnapshot();
    const physical=f.cards+f.reds;
    const attacking=f.goals+f.chances;
    if(minute<=15){
      if(physical>=2)return 'feisty';
      if(attacking>=3)return 'electric';
      if(attacking>=2)return 'lively';
      if(f.activity===0)return 'slow';
      return 'cagey';
    }
    if(minute<=45){
      if(physical>=3&&attacking>=2)return 'feisty-lively';
      if(attacking>=5||f.goals>=3)return 'exciting';
      if(attacking>=3)return 'lively';
      if(f.activity<=1)return 'boring';
      if(physical>=2)return 'scrappy';
      return 'cagey';
    }
    if(physical>=4&&attacking>=4)return 'feisty-lively';
    if(attacking>=7||f.goals>=4)return 'exciting';
    if(attacking>=5)return 'lively';
    if(f.activity<=3)return 'boring';
    if(physical>=3)return 'scrappy';
    return 'cagey';
  }
  function quietMatchCommentary(minute){
    const blue=teamName('blue'),red=teamName('red'),tone=matchTone(minute);
    if(minute<=15){
      if(tone==='slow')return pick([`It's been a slow start. Neither side has really found any rhythm yet.`,`A quiet opening so far — both teams are still feeling their way into the match.`,`Not much to report in the opening minutes. The game is taking a little while to get going.`]);
      if(tone==='feisty')return pick([`It's been a feisty start. There is already plenty of bite in the challenges.`,`A fiery opening to this one — neither side is giving an inch.`,`The temperature is up early. This has been a combative start to the match.`]);
      if(tone==='electric'||tone==='lively')return pick([`What a lively start — both teams have come out looking to make things happen.`,`This has opened at a really good tempo. There is already a sense that chances will come.`,`An energetic start from both sides. The match has settled into a quick rhythm.`]);
      return pick([`It's a cagey start, with both teams trying not to give anything away.`,`Neither side has taken control yet. A careful opening to the match.`]);
    }
    if(minute<45){
      if(tone==='boring')return pick([`This first half really needs a spark. Very little has happened for a while.`,`It's turning into a pretty dull first half — neither side is creating enough.`,`The first half has gone flat. There has been very little for either set of fans to get excited about.`]);
      if(tone==='exciting')return pick([`This has been an excellent first half — open, attacking and full of incident.`,`A really entertaining first half so far. The game keeps producing moments at both ends.`,`This first half has had almost everything. The tempo has barely dropped.`]);
      if(tone==='lively'||tone==='feisty-lively')return pick([`It's been a lively first half, with plenty happening at both ends.`,`The first half has developed into a really competitive contest with chances starting to arrive.`,`There is a good edge to this game now. The first half has been full of action.`]);
      if(tone==='scrappy')return pick([`The first half has become scrappy and physical. Neither side is getting much time on the ball.`,`There has been more aggression than quality for a spell — it's getting a little bit feisty out there.`,`This has turned into a stop-start, physical first half.`]);
      return pick([`It's been a tight first half so far. Neither side has really taken control.`,`The game remains finely balanced. Both teams are being fairly cautious.`]);
    }
    if(minute>=70){
      if(state.score.blue===state.score.red)return pick([`Something has to change now. ${pick([blue,red])} are getting Number ${shirtNumber('substitute')} ready to try to find a winner.`,`A tactical change is coming. Number ${shirtNumber('substitute')} is on to give ${pick([blue,red])} more threat up front.`,`We're into the closing stages and it's still ${scoreLine()}. Fresh legs are coming on to try to break the deadlock.`,`The coaches are rolling the dice now. A new centre forward is coming on to try to make something happen.`,`It's getting tense. One moment of quality could decide this at ${scoreLine()}.`,`Both sides are pushing a little higher now. Nobody wants to settle for ${scoreLine()}.`]);
      const trailing=state.score.blue<state.score.red?blue:red,leading=state.score.blue>state.score.red?blue:red;
      return pick([`${trailing} need something now. Number ${shirtNumber('substitute')} is coming on to add more firepower.`,`${trailing} are making an attacking change — another forward is on to chase the game.`,`${leading} are trying to manage the closing stages, but ${trailing} are throwing players forward.`,`We're into the last part of the match. ${trailing} have to take a few more risks now.`,`Fresh legs for ${trailing}. They're looking for one big chance before time runs out.`]);
    }
    if(tone==='boring')return pick([`The second half is struggling to come alive. Someone needs to raise the tempo.`,`This has gone a little flat since the break. Neither side is creating enough.`]);
    if(tone==='exciting'||tone==='lively')return pick([`The match is really opening up now. There is space at both ends and another big moment feels close.`,`The tempo is rising. Both sides are committing more players forward now.`]);
    if(tone==='scrappy'||tone==='feisty-lively')return pick([`The game is getting increasingly physical. There is very little between these two sides.`,`There is a real edge to this now — every challenge feels important.`]);
    return pick([`The game moves on with ${scoreLine()} on the board.`,`Play settles down for a moment. Still ${scoreLine()}.`]);
  }
  function halfTimeCommentary(){
    const tone=matchTone(45),f=matchFlowSnapshot();
    const score=`${scoreLine()}`;
    if(tone==='boring')return state.score.blue===0&&state.score.red===0
      ? `Half time at ${score}. That was a really quiet first half — very little goalmouth action and both sides need to offer much more after the break.`
      : `Half time at ${score}. The scoreline is the main talking point because the first half itself was fairly uneventful.`;
    if(tone==='exciting')return `Half time at ${score}. That was an excellent first half — ${f.goals} goal${f.goals===1?'':'s'}, plenty of attacking moments and hardly any let-up in the tempo.`;
    if(tone==='feisty-lively')return `Half time at ${score}. A fiery, entertaining first half with chances, strong challenges and plenty of incident.`;
    if(tone==='lively')return `Half time at ${score}. It's been a lively first half with both teams contributing to an open contest.`;
    if(tone==='scrappy')return `Half time at ${score}. A physical, scrappy first half with more battles than flowing football.`;
    if(tone==='cagey')return `Half time at ${score}. A cagey first half — competitive and finely balanced, but neither side has really taken control.`;
    return `Half time at ${score}. A slow-burning first half that never quite found a consistent rhythm.`;
  }
  function finalChanceCommentary(p){const team=teamName(p),ts=state.score[p],os=state.score[other(p)];if(ts===os)return pick([`We're getting towards the end of the game, and ${team} have one last chance. Can they find a winner before the whistle?`,`We're almost done, but ${team} get one final chance. Even the keeper is looking to get forward!`,`One last roll for ${team}. Is there a final twist in this match before the whistle goes?`]);if(ts+1===os)return pick([`${team} have one last chance to save the match. They're throwing everyone forward — even the keeper.`,`The referee is checking the watch. ${team} need a last-gasp equaliser now.`,`This could be the final attack. Can ${team} snatch an equaliser at the death?`]);if(ts<os)return pick([`The referee is almost ready to end it. ${team} have one final attack, but they need something extraordinary.`,`${team} get one last chance to finish on a high. Time is almost up.`,`One final push from ${team}. The result may be slipping away, but there's still one last moment to come.`]);return pick([`${team} get one final chance before the whistle. Can they put the result beyond doubt?`,`Almost full time. ${team} have one last attack to try to add another.`,`The referee is looking at the watch, but ${team} still have one final opportunity.`]);}
  function fullTimeCommentary(){if(state.score.blue===state.score.red)return `Full time: ${scoreLine()}. Nothing separates them — we're heading to a penalty shootout.`;const winner=state.score.blue>state.score.red?teamName('blue'):teamName('red'),loser=state.score.blue>state.score.red?teamName('red'):teamName('blue'),margin=Math.abs(state.score.blue-state.score.red);if(state.score.blue+state.score.red===1)return `Full time. ${winner} edge it ${scoreLine()} in a tight, tense match.`;if(margin>=3)return `Full time. A convincing win for ${winner}, who finish ${scoreLine()} ahead of ${loser}.`;return `Full time. ${winner} take it ${scoreLine()} after a lively contest.`;}

  function scoreGoal(player,kind='goal'){
    const beforeBlue=state.score.blue,beforeRed=state.score.red;
    state.score[player]++;
    let text=goalCommentary(player,beforeBlue,beforeRed,kind);
    const goalMeta=recordGoalFromCommentary(player,text,kind);
    if(goalMeta?.assistNumber)text+=` ${assistLiveLine(goalMeta.assistNumber)}`;
    updateScore();
    report(player,'GOAL!',text,'⚽');
  }
  async function forcedMove(player,ev){
    const target=ev.to;if(!target)return finishTurn();
    const color=ev.type==='red'?'red':ev.type==='yellow'?'yellow':'blue',team=teamName(player);
    let title,icon,text;
    if(ev.type==='yellow'){
      state.matchEvents.yellows[player]++;
      const n=shirtNumber(pick(['defender','defender','attacker']),player);
      title='YELLOW CARD';icon='🟨';
      text=pick([
        `Number ${n} goes into the book for ${team}. A late challenge — and they may be a little lucky it wasn't red.`,
        `Yellow card for Number ${n} of ${team}. They mistimed the tackle and the referee had no hesitation.`,
        `Number ${n} is booked for ${team}. A clumsy challenge, and they'll need to be careful from here.`
      ]);
    }
    else if(ev.type==='red'){
      state.matchEvents.reds[player]++;
      const redNo=shirtNumber(pick(['defender','attacker']),player);
      markUnavailable(player,redNo);
      title='RED CARD';icon='🟥';const minute=currentMinute(),ts=state.score[player],os=state.score[other(player)],late=minute>=75;
      if(ts>os)text=late?pick([`RED CARD! Number ${redNo} is sent off for ${team}. A massive blow. They're leading, but can they hold on with ten players?`,`Number ${redNo} sees red for ${team}! They're in front, but this could make the closing stages very uncomfortable.`,`Number ${redNo} is off! ${team} have the lead, but now they have to protect it with ten players.`]):pick([`RED CARD! Number ${redNo} is dismissed for ${team}. A major setback. They're ahead, but the match has suddenly become much harder.`,`Number ${redNo} sees red for ${team}. They're leading, but they'll have to defend that advantage with ten players.`,`A huge moment — Number ${redNo} is sent off and ${team} are reduced to ten despite being in front.`]);
      else if(ts<os)text=late?pick([`RED CARD! Number ${redNo} is sent off for ${team}. Disaster. They're already behind and time is running out.`,`Number ${redNo} is sent off for ${team} while they're chasing the game. Is that the moment their hopes disappear?`,`Number ${redNo} is off! ${team} were already in trouble, and this makes the comeback look even tougher.`]):pick([`RED CARD! Number ${redNo} is dismissed for ${team}. A major blow. They're behind and now have to find a way back with ten players.`,`Number ${redNo} sees red for ${team} while they're trailing. Their task has just become much more difficult.`,`Disaster for ${team}: Number ${redNo} is sent off while they're losing and now they're a player down as well.`]);
      else text=late?pick([`RED CARD! Number ${redNo} is sent off in a level game. Can ${team} survive the closing stages with ten players?`,`Number ${redNo} sees red for ${team} with the scores level. That could completely change the finish.`,`Number ${redNo} is off! With the game finely balanced, ${team} now have to hang on with ten.`]):pick([`RED CARD! Number ${redNo} is dismissed — ${team} are down to ten with the game still level.`,`Number ${redNo} sees red for ${team}. The scores are level, but the balance of the match may have just shifted.`,`Number ${redNo} is sent off for ${team}. Plenty of football left, but they'll have to play it with ten.`]);
    } else {
      state.matchEvents.injuries[player]++;
      const injury=resolvePlayerInjury(player,team);
      title='INJURY';icon='🩹';text=injury.text;
    }
    report(player,title,text,icon);
    pulseDestination(target,color);
    await wait(650);
    await animateMove(player,ROUTE.indexOf(target));
    await wait(220);

    // Forced movement can itself take a team onto Full Time. Treat that exactly
    // like landing there from a normal roll: the opponent gets one final turn,
    // and after that turn resolves the match ends.
    if(target==='fulltime') return reachedFullTime(player);
    finishTurn();
  }

  async function resolveLanding(player){
    const id=ROUTE[state.pos[player]],minute=minuteFor(id),team=teamName(player);
    if(id==='halftime'&&!state.halfTimeCalled){await callHalfTime();}
    if(id==='fulltime') return reachedFullTime(player);
    if(id==='m95'){const target=state.m95Target;state.phase='chance';state.pending={player,kind:'late',numbers:[target]};report(player,'95TH-MINUTE DRAMA!',pick([`${team} have one last chance. Roll a ${target} and this place will erupt.`,`We're into the 95th minute — one roll, one chance, a ${target} scores.`,`Last-gasp opportunity for ${team}. They need a ${target}.`]),'⏱️');setModal('95TH MINUTE','Last chance!',`Roll a ${target} to score.`,'ROLL TO SHOOT');return;}
    const ev=eventAt(id);
    if(!ev){ if(id!=='halftime')report(player,`${minute}'`,quietMatchCommentary(minute),'⏱️'); return finishTurn(); }
    if(ev.type==='open'){scoreGoal(player,'goal');return finishTurn();}
    if(ev.type==='yellow'||ev.type==='red'||ev.type==='injury') return forcedMove(player,ev);
    if(ev.type==='goal-odd'||ev.type==='goal-even'){
      const parity=ev.type==='goal-odd'?'odd':'even';
      const scoringNumbers = parity==='odd' ? [1,3,5] : [2,4,6];
      state.phase='chance';state.pending={player,kind:'goal',parity};
      report(player,'GOAL CHANCE!',pick([`${team} are in! Roll again — ${parity==='odd'?'an odd number':'an even number'} scores.`,`A chance opens up for ${team}. ${parity==='odd'?'Odd':'Even'} is what they need.`,`${team} have a sight of goal. One more roll decides it.`]),'⚽');
      setModal(
        'GOAL CHANCE',
        `${team} chance`,
        '',
        'ROLL TO SHOOT',
        true,
        {
          kind:'goal',
          headline:parity==='odd'?'Odd numbers score':'Even numbers score',
          commentary:chanceModalCommentary(ev.type,team),
          numbers:scoringNumbers
        }
      );
      return;
    }
    if(ev.type==='free'||ev.type==='penalty'){
      state.phase='chance';state.pending={player,kind:ev.type,numbers:ev.success||[]};
      if(ev.type==='penalty')report(player,'PENALTY!',pick([`Penalty to ${team}! ${state.pending.numbers.join(' or ')} will score.`,`The referee points to the spot! ${team} have a huge chance here.`,`Big moment for ${team} — four numbers out of six will score.`]),'🥅');
      else report(player,'FREE KICK!',pick([`Free kick in a dangerous area for ${team}. ${state.pending.numbers.join(' or ')} will score.`,`${team} have a set-piece chance here.`,`This free kick could cause trouble — two numbers out of six will score.`]),'🎯');

      const isFree=ev.type==='free';
      setModal(
        isFree?'FREE KICK':'PENALTY',
        `${team} chance`,
        '',
        isFree?'ROLL FREE KICK':'ROLL TO SHOOT',
        true,
        {
          kind:isFree?'free':'penalty',
          headline:isFree?'2 of 6 numbers score':'4 of 6 numbers score',
          commentary:chanceModalCommentary(ev.type,team),
          numbers:state.pending.numbers
        }
      );
      return;
    }
    finishTurn();
  }

  const FF_PENALTY_SCENES={centre:'data:image/jpeg;base64,',left:'data:image/jpeg;base64,',right:'data:image/jpeg;base64,