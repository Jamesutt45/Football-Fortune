'};
  const FF_PENALTY_DIRS=['left','centre','right'];
  const ffPenaltyRandomDir=()=>FF_PENALTY_DIRS[Math.floor(Math.random()*FF_PENALTY_DIRS.length)];
  const ffPenaltyDirLabel=d=>({left:'LEFT',centre:'CENTRE',right:'RIGHT'})[d]||'';
  function ffPenaltyRandomNumberSet(count){const nums=[1,2,3,4,5,6];for(let i=nums.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[nums[i],nums[j]]=[nums[j],nums[i]]}return nums.slice(0,count).sort((a,b)=>a-b)}
  function ffPenaltySetScene(dir='centre'){const host=$('#ffIntegratedPenalty');if(host)host.style.backgroundImage=`url('${FF_PENALTY_SCENES[dir]||FF_PENALTY_SCENES.centre}')`;if(state.shootout)state.shootout.keeperVisual=dir;}
  function ffPenaltySetBall(dir=null){const ball=$('#ffPenBall');if(!ball)return;if(dir){ball.dataset.dir=dir;ball.classList.add('show')}else{ball.classList.remove('show');ball.removeAttribute('data-dir')}}
  function ffPenaltySetRollPrompt(mode,nums,helper){const label=mode==='score'?'TO SCORE':mode==='save'?'TO SAVE':'TO KEEP OUT';const host=$('#ffPenStatusRule');if(host)host.innerHTML=`<div class="ff-pen-roll-visual"><span class="ff-pen-roll-label">${label}</span><div class="ff-pen-roll-dice">${nums.map(n=>`<span class="ff-pen-roll-chip">${n}</span>`).join('')}</div></div><div class="ff-pen-roll-helper">${helper}</div>`;}
  function shootoutWinnerNow(){
    const so=state.shootout;if(!so)return null;
    const bt=so.kicks.blue.length,rt=so.kicks.red.length,b=so.goals.blue,r=so.goals.red;
    if(bt<=5&&rt<=5){if(b>r+(5-rt))return 'blue';if(r>b+(5-bt))return 'red';if(bt===5&&rt===5&&b!==r)return b>r?'blue':'red';}
    if(bt>=5&&rt>=5&&bt===rt&&b!==r)return b>r?'blue':'red';
    return null;
  }
  function updateShootoutUI(){
    const so=state.shootout;if(!so)return;
    const current=so.current,blueTurn=current==='blue',kickNo=so.kicks[current].length+1,sudden=so.kicks.blue.length>=5&&so.kicks.red.length>=5;
    const badge=$('#ffPenBadge');if(badge){badge.textContent=blueTurn?'B':'R';badge.classList.toggle('red',!blueTurn)}
    $('#ffPenTitle').textContent=`${teamName(current)} Penalty`;
    $('#ffPenSub').textContent=blueTurn?'Choose an arrow to aim your shot':'Choose where the Blue keeper dives';
    $('#ffPenMeta').textContent=sudden?`Sudden death · ${so.goals.blue}–${so.goals.red}`:`Penalty ${kickNo} of 5 · ${so.goals.blue}–${so.goals.red}`;
    updateScoreboardDetails();
    const matchMinute=$('.match-minute');
    if(matchMinute)matchMinute.textContent=sudden?'Sudden death':`Penalty ${Math.min(kickNo,5)} of 5`;
    document.querySelectorAll('[data-pen-dir]').forEach(btn=>{const active=!so.choice&&!so.winner;btn.disabled=!active;btn.classList.toggle('selected',btn.dataset.penDir===so.choice)});
    if(!so.choice&&!so.winner){$('#ffPenStatus').className='ff-pen-status hidden';ffPenaltySetScene('centre');ffPenaltySetBall(null)}
    const penSim=$('#ffPenQuickSimBtn');if(penSim)penSim.disabled=!!so.winner||!!state.busy;
    updateStandardDiceTurn(`${teamName(current)} penalty`);updateStandardDiceAvailability();
  }
  function showShootoutTransition(){
    const wrap=$('#ffShootoutTransition');if(!wrap)return;
    const score=$('#ffShootoutTransitionScore');if(score)score.textContent=scoreLine();
    wrap.classList.remove('hidden');wrap.setAttribute('aria-hidden','false');document.body.classList.add('ff-result-open');
    $('#ffGameModal')?.classList.add('hidden');$('#ffGameModal')?.setAttribute('aria-hidden','true');
    updateStandardDiceAvailability();
  }
  function hideShootoutTransition(){
    const wrap=$('#ffShootoutTransition');if(!wrap)return;
    wrap.classList.add('hidden');wrap.setAttribute('aria-hidden','true');
  }
  function beginShootout(){
    hideShootoutTransition();
    document.body.classList.remove('ff-result-open');
    state.finished=false;state.phase='shootout';state.pending=null;
    state.shootout={current:'blue',choice:null,computer:null,successNumbers:[],keeperRight:false,keeperVisual:'centre',goals:{blue:0,red:0},kicks:{blue:[],red:[]},winner:null};ffScheduleAutosave('shootout-start');
    $('#ffGameModal').classList.add('hidden');$('#ffGameModal').setAttribute('aria-hidden','true');
    $('.pitch-stage')?.classList.add('hidden');
    const host=$('#ffIntegratedPenalty');host?.classList.remove('hidden');host?.setAttribute('aria-hidden','false');
    $('#ffPenWinner')?.classList.add('hidden');
    ffPenaltySetScene('centre');ffPenaltySetBall(null);updateShootoutUI();
  }
  function chooseShootoutDirection(dir){
    const so=state.shootout;if(!so||so.winner||so.choice||!FF_PENALTY_DIRS.includes(dir))return;
    const blueTurn=so.current==='blue';so.choice=dir;so.computer=ffPenaltyRandomDir();so.keeperRight=so.choice===so.computer;
    const revealDir=blueTurn?so.computer:so.choice;ffPenaltySetScene(revealDir);
    const shotDir=blueTurn?so.choice:so.computer;ffPenaltySetBall(shotDir);
    const successCount=so.keeperRight?(blueTurn?2:4):(blueTurn?5:1);so.successNumbers=ffPenaltyRandomNumberSet(successCount);
    const status=$('#ffPenStatus');status.className='ff-pen-status';
    if(blueTurn){
      $('#ffPenStatusTitle').textContent=so.keeperRight?'Red keeper guesses correctly':(so.computer==='centre'?'Red keeper is rooted to the spot!':'Red keeper has gone the wrong way!');
      ffPenaltySetRollPrompt('score',so.successNumbers,'Roll the standard dice — any highlighted number scores');
    }else{
      $('#ffPenStatusTitle').textContent=so.keeperRight?'Blue keeper guesses correctly':(so.choice==='centre'?'Blue keeper is rooted to the spot!':'Blue keeper has gone the wrong way!');
      ffPenaltySetRollPrompt(so.keeperRight?'save':'keepout',so.successNumbers,so.keeperRight?'Roll the standard dice — any highlighted number makes the save':'Roll the standard dice — only a highlighted number keeps it out');
    }
    document.querySelectorAll('[data-pen-dir]').forEach(btn=>{btn.disabled=true;btn.classList.toggle('selected',btn.dataset.penDir===dir)});
    updateStandardDiceAvailability();
  }
  function prepareNextShootoutKick(){
    const so=state.shootout;if(!so||so.winner)return;
    so.current=other(so.current);so.choice=null;so.computer=null;so.successNumbers=[];so.keeperRight=false;ffPenaltySetScene('centre');ffPenaltySetBall(null);updateShootoutUI();ffScheduleAutosave('penalty-complete');
  }
  function finishShootout(winner){
    const so=state.shootout;if(!so)return;so.winner=winner;state.finished=true;state.phase='finished';ffScheduleAutosave('shootout-finished');
    if(getMatchMode()==='tournament'){
      window.FOOTBALL_FORTUNE_TOURNAMENT_MATCH_COMPLETE?.({
        winner:teamName(winner),
        homeTeam:teamName('blue'),
        awayTeam:teamName('red'),
        homeScore:state.score.blue,
        awayScore:state.score.red,
        penalties:{home:so.goals.blue,away:so.goals.red}
      });
    }
    const loser=other(winner),penScore=`${so.goals[winner]}–${so.goals[loser]}`;
    report(winner,'SHOOTOUT WINNERS',`${teamName(winner)} win ${penScore} on penalties!`,'🏆',95);updateStandardDiceAvailability();
    const delay=state.quickSimulating?180:950;
    setTimeout(()=>{
      const host=$('#ffIntegratedPenalty');if(host){host.classList.add('hidden');host.setAttribute('aria-hidden','true');}
      $('.pitch-stage')?.classList.remove('hidden');
      $('#ffPenWinner')?.classList.add('hidden');
      updateScoreboardDetails();
      updateClock();
      showFinalResult();
    },delay);
  }
  function ffPenaltyMissCommentary(team){return pick([`${teamName(team)} blaze it over the bar.`,`${teamName(team)} drag the penalty wide.`,`${teamName(team)} hit the post and it stays out.`,`${teamName(team)} clip the crossbar — no goal.`,`${teamName(team)} scuff the spot kick wide.`])}
  function ffPenaltySaveCommentary(team){return pick([`A strong save keeps ${teamName(team)} out.`,`The keeper reads it and makes the save.`,`The keeper gets across sharply and pushes it away.`,`Saved! The keeper holds their nerve.`])}
  function ffPenaltyGoalCommentary(team,keeperRight){return keeperRight?pick([`${teamName(team)} score despite the keeper going the right way — too much power.`,`${teamName(team)} beat the keeper even though the direction was read.`]):pick([`${teamName(team)} send the keeper the wrong way and score.`,`${teamName(team)} finish confidently with the keeper beaten.`,`${teamName(team)} roll it home after wrong-footing the keeper.`])}
  function resolveShootoutRoll(result){
    const so=state.shootout;if(!so||!so.choice||so.winner)return;
    const team=so.current,blueTurn=team==='blue',userSuccess=so.successNumbers.includes(result),scored=blueTurn?userSuccess:!userSuccess;
    so.kicks[team].push(scored);if(scored)so.goals[team]++;
    let title,copy,icon;
    if(scored){title='GOAL!';copy=ffPenaltyGoalCommentary(team,so.keeperRight);icon='⚽';$('#ffPenStatus').className='ff-pen-status result-goal';$('#ffPenStatusTitle').textContent='GOAL!';$('#ffPenStatusRule').textContent=`Rolled ${result} · Goal.`;}
    else{const saved=so.keeperRight;title=saved?'SAVED!':'MISSED!';copy=saved?ffPenaltySaveCommentary(team):ffPenaltyMissCommentary(team);icon=saved?'🧤':'❌';$('#ffPenStatus').className='ff-pen-status result-miss';$('#ffPenStatusTitle').textContent=title;$('#ffPenStatusRule').textContent=`Rolled ${result} · ${saved?'Saved.':'Missed.'}`;}
    report(null,title,copy,icon,95);
    so.choice=null;
    updateScoreboardDetails();
    updateStandardDiceAvailability();
    const winner=shootoutWinnerNow();
    if(state.quickSimulating){if(winner)finishShootout(winner);else prepareNextShootoutKick();return;}
    setTimeout(()=>{if(winner)finishShootout(winner);else prepareNextShootoutKick();},2900);
  }
  async function quickSimShootout(){
    if(!state.shootout)beginShootout();let safety=0;
    while(!state.shootout.winner&&safety++<40){const so=state.shootout,blueTurn=so.current==='blue';so.choice=ffPenaltyRandomDir();so.computer=ffPenaltyRandomDir();so.keeperRight=so.choice===so.computer;const successCount=so.keeperRight?(blueTurn?2:4):(blueTurn?5:1);so.successNumbers=ffPenaltyRandomNumberSet(successCount);const roll=randomDie(),userSuccess=so.successNumbers.includes(roll),scored=blueTurn?userSuccess:!userSuccess;so.kicks[so.current].push(scored);if(scored)so.goals[so.current]++;updateScoreboardDetails();const winner=shootoutWinnerNow();if(winner){finishShootout(winner);break}so.current=other(so.current);so.choice=null;so.computer=null;so.successNumbers=[];await wait(15)}
    updateShootoutUI();
  }

  function finishTurn(){
    state.phase='move';
    state.pending=null;
    if(state.finished)return;

    // If this player was granted the one-and-only final turn after their
    // opponent reached Full Time, the match ends as soon as that turn has
    // fully resolved. Do not hand control back to the player already at FT.
    if(state.finalTurnFor===state.current){
      state.finalTurnFor=null;
      return endMatch();
    }

    state.current=other(state.current);
    placeTokens();
    setModal('YOUR TURN',`${state.current==='blue'?'Blue':'Red'} team to roll`,'','ROLL DICE');
    ffScheduleAutosave('turn-complete');
  }
  function reachedFullTime(player){
    if(state.finalTurnFor){ return endMatch(); }
    const opponent=other(player); if(state.pos[opponent]>=ROUTE.length-1)return endMatch(); state.finalTurnFor=opponent; report(null,'ALMOST FULL TIME',finalChanceCommentary(opponent),'⏳',95); state.current=opponent;state.phase='move';setModal('FINAL ROLL',`${teamName(opponent)} have one last roll`,'','ROLL DICE');placeTokens();ffScheduleAutosave('final-roll');
  }
  function endMatch(){
    const drawn=state.score.blue===state.score.red;
    placeTokens();const ft=drawn&&getMatchMode()==='season'?`Full time: ${scoreLine()}. The points are shared — one point each.`:fullTimeCommentary();
    report(null,'FULL TIME',ft,'🏁',95);
    $('#ffGameModal').classList.add('hidden');$('#ffGameModal').setAttribute('aria-hidden','true');
    $('#ffRollBtn').disabled=true;updateStandardDiceAvailability();

    if(drawn&&drawNeedsShootout()){
      state.finished=false;state.phase='pre-shootout';
      showShootoutTransition();
      ffScheduleAutosave('pre-shootout');
      return;
    }

    state.finished=true;state.phase='finished';
    ffScheduleAutosave('full-time');
    if(getMatchMode()==='tournament'){
      const winner=state.score.blue>state.score.red?'blue':'red';
      window.FOOTBALL_FORTUNE_TOURNAMENT_MATCH_COMPLETE?.({
        winner:teamName(winner),
        homeTeam:teamName('blue'),
        awayTeam:teamName('red'),
        homeScore:state.score.blue,
        awayScore:state.score.red,
        penalties:null
      });
    }
    if(!state.quickSimulating)setTimeout(showFinalResult,650);
  }
  async function doRoll(){
    if(state.busy||state.finished)return;
    if(state.phase==='shootout'&&!state.shootout?.choice)return;
    const isChanceRoll=state.phase==='chance';
    setBusy(true);
    const v=randomDie();
    const d=$('#ffSidebarDie');
    const rotations={1:'rotateX(0deg) rotateY(0deg)',2:'rotateX(0deg) rotateY(-90deg)',3:'rotateX(-90deg) rotateY(0deg)',4:'rotateX(90deg) rotateY(0deg)',5:'rotateX(0deg) rotateY(90deg)',6:'rotateX(0deg) rotateY(180deg)'};
    // Every roll uses the same persistent bottom-right v58/v95 3D die.
    d.classList.remove('rolling');
    d.style.transform='rotateX(-15deg) rotateY(25deg)';
    void d.offsetWidth;
    d.classList.add('rolling');

    await wait(950);
    d.classList.remove('rolling');
    d.style.transform=rotations[v];
    await wait(1400);
    if(isChanceRoll)hideGameModalForRoll();

    if(state.phase==='shootout'){
      resolveShootoutRoll(v);
      setBusy(false);
      return;
    }

    if(state.phase==='chance'){
      const p=state.pending;
      let success=false;
      if(p.kind==='goal')success=(v%2===1)===(p.parity==='odd');
      else success=(p.numbers||[]).includes(v);
      if(success)scoreGoal(p.player,p.kind==='goal'?'goal':p.kind==='free'?'free':p.kind==='penalty'?'penalty':'late');
      else { const title=p.kind==='penalty'?'PENALTY MISSED':p.kind==='free'?'FREE KICK MISSED':'CHANCE MISSED'; const icon=p.kind==='penalty'?'🥅':p.kind==='free'?'🎯':'😮'; report(p.player,title,missedChanceCommentary(p.kind,p.player),icon); }
      await wait(500);
      setBusy(false);
      finishTurn();
      return;
    }

    const movingPlayer=state.current;
    const max=ROUTE.length-1;
    const target=Math.min(max,state.pos[movingPlayer]+v);

    // Brief clear-board pause after the dice disappears, then one smooth route animation to the destination.
    await wait(320);
    await animateMove(movingPlayer,target);
    await wait(260);
    await resolveLanding(movingPlayer);
    setBusy(false);
  }
  function summaryEventCount(type){
    return (state.matchEvents?.[type]?.blue||0)+(state.matchEvents?.[type]?.red||0);
  }
  function summaryMissCount(){
    return [...document.querySelectorAll('.report-head')].filter(el=>/MISSED|CHANCE MISSED/i.test(el.textContent||'')).length;
  }
  function topScorerSummary(){
    const standouts=matchPlayerStats()
      .filter(p=>p.goals>=2)
      .sort((a,b)=>b.goals-a.goals||b.assists-a.assists)
      .slice(0,2);
    if(!standouts.length)return null;
    return standouts.map(p=>{
      const label=isCaptainNumber(p.team,p.number)?`The captain, No. ${p.number}`:`No. ${p.number}`;
      if(p.goals>=3)return `${label} was the hat-trick hero for ${teamName(p.team)}, producing the outstanding individual display of the match.`;
      return `${label} was one of ${teamName(p.team)}'s strongest players, scoring twice and repeatedly troubling the opposition.`;
    }).join(' ');
  }
  function summaryPlayerNumber(ev){
    const m=(ev.commentary||'').match(/Number\s+(\d+)/i);
    return m?Number(m[1]):null;
  }
  function summaryRole(number){
    if([7,11].includes(number))return 'winger';
    if(number===9)return 'striker';
    if(number===10)return 'attacking midfielder';
    if([6,8].includes(number))return 'midfielder';
    if([2,3].includes(number))return 'full-back';
    if([4,5].includes(number))return 'centre-back';
    return 'player';
  }
  function summaryAssistNumber(ev){
    const text=ev?.commentary||'';
    const patterns=[
      /Number\s+(\d+)\s+(?:whipped|bent|split|spotted|threaded|produced|carved)/i,
      /(?:delivery|pass|ball) from Number\s+(\d+)/i,
      /Number\s+(\d+)\s+.*?(?:cross|through ball|final ball|pass)/i
    ];
    for(const pattern of patterns){
      const m=text.match(pattern);
      if(m)return Number(m[1]);
    }
    return null;
  }
  function summaryAssistClause(ev,n){
    if(!n)return '';
    const text=(ev?.commentary||'').toLowerCase();
    if(/through ball|threaded|split the defence/.test(text)){
      return ` The move owed plenty to Number ${n}, whose incisive through ball cut the defence apart.`;
    }
    if(/cross|delivery|six-yard box|danger area/.test(text)){
      return ` Number ${n} deserves plenty of credit too after an excellent delivery into the box.`;
    }
    if(/unplayable pass|weighted pass|vision|unlocked|carved/.test(text)){
      return ` It was created by a terrific piece of vision from Number ${n}.`;
    }
    return ` Number ${n} played a major part in creating the opening.`;
  }
  function matchPlayerStats(){
    const map=new Map();
    const ensure=(team,number)=>{
      if(!number)return null;
      const key=`${team}-${number}`;
      if(!map.has(key))map.set(key,{team,number:Number(number),goals:0,assists:0,captain:isCaptainNumber(team,number)});
      return map.get(key);
    };
    ['blue','red'].forEach(team=>{
      (state.scorers?.[team]||[]).forEach(g=>{
        if(g.number)ensure(team,g.number).goals++;
        if(g.assistNumber)ensure(team,g.assistNumber).assists++;
      });
    });
    return [...map.values()];
  }
  function playerOfMatchSummary(){
    const stats=matchPlayerStats();
    const shootoutWinner=state.shootout?.winner||null;
    const regulationWinner=state.score.blue===state.score.red?null:(state.score.blue>state.score.red?'blue':'red');
    const winningTeam=shootoutWinner||regulationWinner;
    let candidates=stats.length?stats.slice():[];
    if(!candidates.length){
      const team=winningTeam||'blue';
      candidates=[{team,number:captainNumber(team),goals:0,assists:0,captain:true}];
    }
    candidates.sort((a,b)=>{
      const sa=a.goals*6+a.assists*2.25+(winningTeam&&a.team===winningTeam?1:0)+(a.captain?.25:0);
      const sb=b.goals*6+b.assists*2.25+(winningTeam&&b.team===winningTeam?1:0)+(b.captain?.25:0);
      return sb-sa||b.goals-a.goals||b.assists-a.assists;
    });
    const p=candidates[0];
    const label=p.captain?`captain No. ${p.number}`:`No. ${p.number}`;
    let reason;
    if(p.goals>=3)reason=`the hat-trick hero, scoring ${p.goals} times in a match-winning display`;
    else if(p.goals===2)reason=`one of the strongest players on the pitch, scoring twice`;
    else if(p.goals&&p.assists)reason=`decisive at both ends of the move with ${p.goals} goal${p.goals>1?'s':''} and ${p.assists} assist${p.assists>1?'s':''}`;
    else if(p.goals)reason=`the scorer of a crucial goal and a constant threat`;
    else if(p.assists>=2)reason=`the creative influence behind ${p.assists} goals`;
    else if(p.assists===1)reason=`a key creative presence, including an assist`;
    else reason=`a steady influence throughout and the player who best set the tone for ${teamName(p.team)}`;
    return `<span class="ff-potm-label">Player of the Match:</span> ${label} — ${reason}.`;
  }
  function ordinalMinute(minute){
    const n=Number(minute)||0, mod100=n%100;
    const suffix=(mod100>=11&&mod100<=13)?'th':({1:'st',2:'nd',3:'rd'}[n%10]||'th');
    return `${n}${suffix}`;
  }
  function summaryTiming(minute){
    if(minute<=15)return 'early on';
    if(minute<=30)return 'in the first half';
    if(minute<45)return 'before half-time';
    if(minute<=60)return 'soon after the break';
    if(minute<=75)return 'midway through the second half';
    if(minute<90)return 'late on';
    return 'in the closing moments';
  }
  function firstSentence(text){
    const clean=(text||'').replace(/\s+/g,' ').trim();
    const m=clean.match(/^(.+?[.!?])(?:\s|$)/);
    return (m?m[1]:clean).replace(/^WHAT A GOAL!\s*/i,'').replace(/^RED CARD!\s*/i,'').trim();
  }
  function lowerLead(s){return s?s.charAt(0).toLowerCase()+s.slice(1):s;}
  function summaryPhrase(options,ev,salt=0){
    if(!options?.length)return '';
    const ctx=ev?.summaryContext||{};
    const n=summaryPlayerNumber(ev)||0;
    const seed=(Number(ev?.minute)||0)+(Number(ctx.goalNumber)||0)*7+n*3+salt;
    return options[Math.abs(seed)%options.length];
  }
  function goalJournalistLine(ev){
    const team=ev.player?teamName(ev.player):'The scoring side';
    const opponent=ev.player?teamName(other(ev.player)):'the opposition';
    const n=summaryPlayerNumber(ev);
    const role=n?summaryRole(n):'player';
    const minute=ev.minute;
    const raw=(ev.commentary||'').toLowerCase();
    const ctx=ev.summaryContext||{};
    let finish='finished the move well';
    if(/distance|long-range|lets fly|takes aim/.test(raw))finish='unleashed a superb long-range effort';
    else if(/back post/.test(raw))finish='arrived at the back post and turned it home';
    else if(/header|heads it/.test(raw))finish='rose highest and powered in a header';
    else if(/free kick/.test(raw))finish='curled a free kick into the net';
    else if(/penalty/.test(raw))finish='kept their nerve from the penalty spot';
    else if(/rebound|parry/.test(raw))finish='reacted quickest to the rebound';
    else if(/one-two/.test(raw))finish='finished off a sharp one-two';
    else if(/cuts inside/.test(raw))finish='cut inside and found the far corner';
    else if(/poacher|pokes it home|forces it over/.test(raw))finish='was quickest in the box and forced the ball home';
    let who='their attacker';
    if(n){
      if(ctx.isCaptain && ctx.scorerMention===1)who=`the captain, Number ${n}`;
      else if(ctx.scorerMention>1)who=`Number ${n}`;
      else {
        const useRole=((Number(n)+Number(minute))%3===0);
        who=useRole?`the ${role}, Number ${n}`:`Number ${n}`;
      }
    }
    const assistNo=summaryAssistNumber(ev);
    const assistClause=summaryAssistClause(ev,assistNo);
    let intro='The breakthrough came';
    let minutePhrase=`in the ${ordinalMinute(minute)} minute`;
    if(ctx.goalNumber===1){
      intro=minute<=15
        ? summaryPhrase([
            'The game sparked into life early',
            'The contest burst into life early',
            'It did not take long for the deadlock to be broken'
          ],ev,1)
        : summaryPhrase([
            'The opening goal arrived',
            'The deadlock was finally broken',
            'The first real breakthrough came'
          ],ev,2);
    }else if(ctx.equaliser){
      if(ctx.prevGoalMinute===minute){
        intro=summaryPhrase([
          `${team} immediately hit back`,
          `${team} responded almost straight away`,
          `${team} wasted no time in replying`
        ],ev,3);
        minutePhrase='moments later';
      }else{
        intro=minute>=80
          ? summaryPhrase([
              `${team} found a crucial late equaliser`,
              `${team} rescued parity late on`,
              `${team} clawed their way level late in the contest`
            ],ev,4)
          : summaryPhrase([
              `${team} drew level`,
              `${team} restored parity`,
              `${team} were back on terms`,
              `${team} found a way back into the game`
            ],ev,5);
      }
    }else if(ctx.tookLead){
      if(ctx.prevGoalMinute===minute){
        intro=summaryPhrase([
          `${team} completed a rapid turnaround`,
          `${team} turned the game on its head`,
          `${team} suddenly found themselves in front`
        ],ev,6);
        minutePhrase='almost immediately';
      }else{
        intro=ctx.hadLedBefore
          ? summaryPhrase([
              `${team} regained the lead`,
              `${team} wrestled back the advantage`,
              `${team} moved back in front`
            ],ev,7)
          : summaryPhrase([
              `${team} moved in front`,
              `${team} took control of the scoreline`,
              `${team} edged ahead`
            ],ev,8);
      }
    }else if(ctx.extendedLead){
      intro=minute>=80
        ? summaryPhrase([
            `${team} put the result beyond serious doubt`,
            `${team} added the late cushion they were looking for`,
            `${team} all but settled the contest`,
            `${team} opened up daylight when it mattered most`
          ],ev,9)
        : summaryPhrase([
            `${team} strengthened their grip on the contest`,
            `${team} moved further clear`,
            `${team} gave themselves some breathing room`,
            `${team} built a more comfortable cushion`,
            `${team} put the game more firmly in their hands`
          ],ev,10);
    }else if(ctx.reducedDeficit){
      intro=summaryPhrase([
        `${team} gave themselves a route back into the game`,
        `${team} cut the deficit and breathed life back into the contest`,
        `${team} dragged themselves back into contention`,
        `${team} suddenly had a foothold again`
      ],ev,11);
    }
    return `${intro} ${minutePhrase}, when ${who} ${finish}.${assistClause}`;
  }
  function summaryIncidentLine(ev){
    const team=ev.player?teamName(ev.player):'';
    const n=summaryPlayerNumber(ev);
    const role=n?summaryRole(n):'player';
    const minute=ev.minute;
    const timing=summaryTiming(minute);
    const text=(ev.commentary||'').replace(/\s+/g,' ').trim();

    if(/GOAL!/i.test(ev.title)) return goalJournalistLine(ev);

    if(/YELLOW CARD/i.test(ev.title)){
      const who=n?`Number ${n}`:'The booked player';
      if(/lucky it wasn'?t red|lucky it was not red/i.test(text)){
        return `${who}'s booking in the ${ordinalMinute(minute)} minute was another talking point. It was a poor challenge and ${team} could consider themselves fortunate the referee stopped at yellow.`;
      }
      return `${who} went into the book for ${team} in the ${ordinalMinute(minute)} minute. It was a needless challenge, and from that point on ${role==='player'?'they':`the ${role}`} had to play with much more caution.`;
    }

    if(/RED CARD/i.test(ev.title)){
      const who=n?`Number ${n}`:'The dismissed player';
      return `The sending-off in the ${ordinalMinute(minute)} minute was an obvious one. ${who} could have few complaints, ${team} were left to finish with ten, and a suspension is likely to follow.`;
    }

    if(/INJURY/i.test(ev.title)){
      const who=n?`Number ${n}`:`a ${team} player`;
      const forcedOff=/unable to continue|match is over|replace them|has to come off/i.test(text);
      const recovered=/able to carry on|stay on the pitch|fit to continue/i.test(text);
      if(forcedOff){
        if(minute<=20)return `${who}'s early injury was a genuine setback for ${team}; treatment was not enough and they were forced off.`;
        if(minute>=75)return `${who} was forced off by the late injury, leaving ${team} to reshuffle for the closing stages.`;
        return `${who} could not recover from the injury ${timing} and had to leave the field, forcing ${team} into a change.`;
      }
      if(recovered){
        if(ev.summaryContext?.scoredLater){
          return `${who} needed treatment ${timing} but was able to recover and continue — a decision that mattered, as they later got on the scoresheet.`;
        }
        return `${who} gave ${team} a scare ${timing}, but recovered after treatment and was able to continue.`;
      }
      return `${who} needed treatment ${timing}, briefly interrupting ${team}'s rhythm.`;
    }

    if(/PENALTY MISSED/i.test(ev.title)){
      return `${team} will rue the missed penalty in the ${ordinalMinute(minute)} minute. In a game of fine margins, that was a huge opportunity to change the result.`;
    }

    if(/FREE KICK MISSED|CHANCE MISSED/i.test(ev.title)){
      return `${team} had a major opening in the ${ordinalMinute(minute)} minute but failed to take it. In a match this tight, chances like that tend to linger in the memory.`;
    }

    return `${team} had another important moment ${timing}, but it did not ultimately alter the course of the match.`;
  }
  function buildMatchSummary(){
    const blue=teamName('blue'), red=teamName('red');
    const b=state.score.blue, r=state.score.red;
    const shootoutWinner=state.shootout?.winner||null;
    const regulationWinner=b===r?null:(b>r?blue:red);
    const winner=shootoutWinner?teamName(shootoutWinner):regulationWinner;
    const loser=shootoutWinner?teamName(other(shootoutWinner)):(b===r?null:(b>r?red:blue));
    const gap=Math.abs(b-r);
    const incidents=[...(state.summaryEvents||[])].sort((a,b)=>a.minute-b.minute);
    const goals=incidents.filter(e=>/GOAL!/i.test(e.title));
    // Give each goal editorial context so later goals are described as equalisers,
    // lead changes or extensions rather than repeatedly calling them "the breakthrough".
    let runningBlue=0, runningRed=0;
    let blueHadLed=false, redHadLed=false;
    const scorerMentions={};
    goals.forEach((g,index)=>{
      const beforeBlue=runningBlue, beforeRed=runningRed;
      const prevGoal=goals[index-1]||null;
      const scorerNo=summaryPlayerNumber(g);
      const scorerKey=`${g.player||'x'}-${scorerNo||'x'}`;
      scorerMentions[scorerKey]=(scorerMentions[scorerKey]||0)+1;
      if(g.player==='blue')runningBlue++; else if(g.player==='red')runningRed++;
      const afterBlue=runningBlue, afterRed=runningRed;
      const beforeFor=g.player==='blue'?beforeBlue:beforeRed;
      const beforeAgainst=g.player==='blue'?beforeRed:beforeBlue;
      const afterFor=g.player==='blue'?afterBlue:afterRed;
      const afterAgainst=g.player==='blue'?afterRed:afterBlue;
      const hadLedBefore=g.player==='blue'?blueHadLed:redHadLed;
      g.summaryContext={
        goalNumber:index+1,
        equaliser:afterFor===afterAgainst,
        tookLead:beforeFor<=beforeAgainst&&afterFor>afterAgainst,
        extendedLead:beforeFor>beforeAgainst&&afterFor>afterAgainst,
        reducedDeficit:beforeFor<beforeAgainst&&afterFor<afterAgainst,
        hadLedBefore,
        prevGoalMinute:prevGoal?prevGoal.minute:null,
        prevGoalTeam:prevGoal?.player||null,
        scorerMention:scorerMentions[scorerKey],
        scorerNumber:scorerNo,
        isCaptain:isCaptainNumber(g.player,scorerNo)
      };
      if(afterBlue>afterRed)blueHadLed=true;
      if(afterRed>afterBlue)redHadLed=true;
    });
    const discipline=incidents.filter(e=>/YELLOW CARD|RED CARD/i.test(e.title));
    const injuries=incidents.filter(e=>/INJURY/i.test(e.title));
    const misses=incidents.filter(e=>/MISSED/i.test(e.title));
    injuries.forEach(injury=>{
      const injuryNo=summaryPlayerNumber(injury);
      const laterGoal=injuryNo && goals.find(g=>
        g.player===injury.player &&
        g.minute>=injury.minute &&
        summaryPlayerNumber(g)===injuryNo
      );
      injury.summaryContext={...(injury.summaryContext||{}),scoredLater:!!laterGoal};
    });
    const paragraphs=[];

    // Editorial rule: open with an assessment, not with the mechanics of summarising.
    if(shootoutWinner){
      paragraphs.push(pick([
        `There was nothing between the sides over 95 minutes, with the match finishing <strong>${b}–${r}</strong>. It ultimately needed penalties to separate them.`,
        `The <strong>${b}–${r}</strong> draw was a fair reflection of a tight game, and the shootout became the only way to find a winner.`
      ]));
      paragraphs.push(`<strong>${winner}</strong> held their nerve in the shootout, winning ${state.shootout.goals[shootoutWinner]}–${state.shootout.goals[other(shootoutWinner)]} on penalties.`);
    }else if(!winner){
      paragraphs.push(pick([
        `A draw was a fair reflection of a game in which neither side sustained enough control to deserve more. At <strong>${b}–${r}</strong>, there was very little between them.`,
        `This was a genuinely even contest. The <strong>${b}–${r}</strong> scoreline felt about right, with both sides having good spells but neither doing enough to take command.`
      ]));
    }else if(gap>=3){
      paragraphs.push(pick([
        `<strong>${winner}</strong> were deserved <strong>${b}–${r}</strong> winners. They were more clinical, more composed in the key moments and gave ${loser} very little route back once they took control.`,
        `The <strong>${b}–${r}</strong> scoreline reflected ${winner}'s superiority in the moments that mattered. ${loser} competed, but they were punished whenever the game opened up.`
      ]));
    }else{
      paragraphs.push(pick([
        `<strong>${winner}</strong> edged a close contest <strong>${b}–${r}</strong>. There was no great gulf between the sides, but the winners were calmer when the decisive moments arrived.`,
        `This was tighter than the final score might suggest. <strong>${winner}</strong> took it <strong>${b}–${r}</strong>, largely because they handled the big moments better than ${loser}.`
      ]));
    }

    const totalGoals=b+r;
    if(totalGoals>=5 && paragraphs.length){
      const highScoringLead=totalGoals>=7
        ? pick([
            `It was a breathless, extraordinary contest packed with goals from start to finish.`,
            `This was the sort of wild, end-to-end game that barely gave either side time to settle.`
          ])
        : pick([
            `It was a fantastic match, full of goals, momentum swings and plenty of excitement.`,
            `This turned into a hugely entertaining contest, with goals and big moments arriving throughout.`,
            `There was rarely a quiet spell in a terrific game that delivered goals, drama and repeated changes of momentum.`
          ]);
      paragraphs[0]=`${highScoringLead} ${paragraphs[0]}`;
    }

    // Editorial rule: select the story, do not replay the live feed.
    const chosen=[];
    const addUnique=e=>{if(e&&!chosen.includes(e))chosen.push(e);};
    goals.forEach(addUnique);
    const reds=discipline.filter(e=>/RED CARD/i.test(e.title));
    const yellows=discipline.filter(e=>/YELLOW CARD/i.test(e.title));
    if(reds.length)addUnique(reds[0]);
    else if(yellows.length)addUnique(yellows[0]);
    if(injuries.length)addUnique(injuries[0]);
    if(misses.length)addUnique(misses[0]);

    // Keep only the four strongest moments, prioritising goals and red cards.
    const priority=e=>/GOAL!/i.test(e.title)?0:/RED CARD/i.test(e.title)?1:/PENALTY MISSED/i.test(e.title)?2:/INJURY/i.test(e.title)?3:4;
    const selected=chosen.sort((a,b)=>priority(a)-priority(b)||a.minute-b.minute).slice(0,4).sort((a,b)=>a.minute-b.minute);
    selected.forEach(ev=>paragraphs.push(summaryIncidentLine(ev)));

    if(!selected.length){
      paragraphs.push(`There was no single flashpoint that decided it. The match was shaped more by territory, patience and which side made fewer mistakes over the full 95 minutes.`);
    }

    // Only add broader texture when it adds something not already covered by a chosen incident.
    const yellowTotal=summaryEventCount('yellows');
    const redTotal=summaryEventCount('reds');
    const injuryTotal=summaryEventCount('injuries');
    const selectedHasRed=selected.some(e=>/RED CARD/i.test(e.title));
    const selectedHasInjury=selected.some(e=>/INJURY/i.test(e.title));
    if(injuryTotal>=3&&!selectedHasInjury){
      paragraphs.push(`${injuryTotal} injury stoppages made it a stop-start contest and prevented either side from building much sustained rhythm.`);
    }else if(redTotal&&!selectedHasRed){
      paragraphs.push(`The dismissal gave the contest an extra edge and forced the ten-man side to reorganise for the closing stages.`);
    }else if(yellowTotal>=3){
      paragraphs.push(`There was an edge to the game too, with ${yellowTotal} bookings reflecting how competitive it became.`);
    }

    const top=topScorerSummary();
    if(top)paragraphs.push(top);

    if(shootoutWinner){
      paragraphs.push(`<strong>Verdict:</strong> neither side did enough to win it in normal time, but ${winner} were calmer from the spot and deserved credit for handling the shootout pressure better.`);
    }else if(winner){
      paragraphs.push(gap>=2
        ? `<strong>Verdict:</strong> ${winner} deserved it. They were more ruthless in both boxes and made better use of the chances the game gave them.`
        : `<strong>Verdict:</strong> ${winner} just about deserved it. The difference was not dominance, but better decision-making and a little more composure at the crucial moments.`);
    }else{
      paragraphs.push(`<strong>Verdict:</strong> the draw felt fair. Both teams had reasons to believe they might have won it, but neither produced enough sustained quality to make a stronger claim.`);
    }

    // Turn the event notes into a flowing match article rather than a list of factual snippets.
    const home=teamName('blue'), away=teamName('red');
    const softenTeamStarts=s=>s
      .replace(new RegExp(`^${home.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')}\\b`),'The hosts')
      .replace(new RegExp(`^${away.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')}\\b`),'The visitors')
      .replace(new RegExp(`([.!?]\\s+)${home.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')}\\b`,'g'),'$1The hosts')
      .replace(new RegExp(`([.!?]\\s+)${away.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')}\\b`,'g'),'$1The visitors');

    const cleaned=paragraphs.slice(0,7).map(softenTeamStarts);
    const verdict=cleaned.find(p=>/^<strong>Verdict:/i.test(p));
    const story=cleaned.filter(p=>!/^<strong>Verdict:/i.test(p));
    const article=[];

    // Lead with a fuller opening paragraph.
    if(story.length){
      const opener=story.shift();
      if(story.length && (shootoutWinner || opener.length<230)){
        article.push(`${opener} ${story.shift()}`);
      }else{
        article.push(opener);
      }
    }

    // Fold the main moments into longer, conversational paragraphs.
    while(story.length){
      const first=story.shift();
      if(story.length){
        const second=story.shift();
        article.push(`${first} ${second}`);
      }else{
        article.push(first);
      }
    }

    const result=article.slice(0,3);
    if(verdict)result.push(verdict);
    result.push(playerOfMatchSummary());
    return result;
  }
  function hideFinalResult(){
    const wrap=$('#ffResultBackdrop');if(!wrap)return;wrap.classList.add('hidden');wrap.setAttribute('aria-hidden','true');document.body.classList.remove('ff-result-open');
  }
  function finalResultBrief(){