    const so=state.shootout;
    if(so?.winner){
      const winner=teamName(so.winner),loser=other(so.winner);
      return `${winner} hold their nerve to win the shootout ${so.goals[so.winner]}–${so.goals[loser]} after regulation ended ${scoreLine()}.`;
    }
    const winningTeam=state.score.blue>state.score.red?'blue':'red',losingTeam=other(winningTeam),gap=Math.abs(state.score.blue-state.score.red);
    const scorers=(state.scorers?.[winningTeam]||[]);
    const lead=scorers.length?`${scorers[scorers.length-1].name} was among the scorers as `:'';
    return `${lead}${teamName(winningTeam)} win ${scoreLine()}${gap>=2?', finishing the stronger side.':', edging a tight contest.'}`;
  }
  function showFinalResult(){
    document.body.classList.remove('ff-result-open');
    const wrap=$('#ffResultBackdrop');if(!wrap)return;
    const so=state.shootout, winner=so?.winner|| (state.score.blue>state.score.red?'blue':'red');
    const penWin=!!so?.winner;
    $('#ffResultIcon').textContent='🏆';
    $('#ffResultEyebrow').textContent=penWin?'PENALTY SHOOTOUT':'FULL TIME';
    $('#ffResultTitle').textContent=`${teamName(winner)} win!`;
    $('#ffResultScore').textContent=penWin?`${so.goals.blue}\u00a0–\u00a0${so.goals.red} PENS`:`${state.score.blue}\u00a0–\u00a0${state.score.red}`;
    $('#ffResultCopy').textContent=finalResultBrief();
    const closeBtn=$('#ffResultCloseBtn');
    if(closeBtn)closeBtn.textContent=getMatchMode()==='tournament'?'RETURN TO TOURNAMENT':'BACK TO MATCH';
    wrap.classList.remove('hidden');wrap.setAttribute('aria-hidden','false');
    $('#ffGameModal')?.classList.add('hidden');$('#ffGameModal')?.setAttribute('aria-hidden','true');
  }
  function fitMatchSummary(){
    const card=document.querySelector('.ff-summary-card.ff-newspaper');
    if(!card)return;
    card.classList.remove('ff-summary-compact','ff-summary-tight');
    const maxH=Math.max(420,window.innerHeight-40);
    if(card.scrollHeight>maxH)card.classList.add('ff-summary-compact');
    if(card.scrollHeight>maxH)card.classList.add('ff-summary-tight');
  }
  function showMatchSummary(){
    hideFinalResult();
    const backdrop=$('#ffSummaryBackdrop'); if(!backdrop)return;
    const shootoutWinner=state.shootout?.winner||null;
    const winner=shootoutWinner?teamName(shootoutWinner):(state.score.blue===state.score.red?null:(state.score.blue>state.score.red?teamName('blue'):teamName('red')));
    $('#ffSummaryScore').textContent=shootoutWinner?`${state.score.blue}–${state.score.red} (${state.shootout.goals.blue}–${state.shootout.goals.red} pens)`:`${state.score.blue}–${state.score.red}`;
    $('#ffSummaryTitle').textContent=shootoutWinner?`${winner} win on penalties!`:winner?pick([`${winner} take it!`,`${winner} get the job done`,`What a match!`]):pick(['All square after a thriller','Nothing between them','What a battle!']);
    $('#ffSummaryCopy').innerHTML=buildMatchSummary().map(p=>`<p>${p}</p>`).join('');
    backdrop.classList.remove('hidden'); backdrop.setAttribute('aria-hidden','false');
    document.body.classList.add('ff-summary-open');
    requestAnimationFrame(fitMatchSummary);
  }
  function closeMatchSummary(){
    const backdrop=$('#ffSummaryBackdrop');if(!backdrop)return;
    backdrop.classList.add('hidden');
    backdrop.setAttribute('aria-hidden','true');
    document.body.classList.remove('ff-summary-open');
    // Once the match summary has been shown, returning to the report should reveal
    // the finished board/report only — there is no need to show the Full Time modal again.
    if(state?.finished){
      const modal=$('#ffGameModal');
      if(modal){modal.classList.add('hidden');modal.setAttribute('aria-hidden','true');}
      $('#ffDiceRestoreBtn')?.classList.add('hidden');
    }
  }

  const FF_FRIENDLY_SAVE_KEY='footballFortuneFriendlySavesV1';
  let ffActiveSaveId=null;
  let ffSaveEnabled=false;
  let ffAutosaveTimer=null;

  function ffReadSaves(){
    try{const raw=JSON.parse(localStorage.getItem(FF_FRIENDLY_SAVE_KEY)||'[]');return Array.isArray(raw)?raw:[];}catch(e){return [];}
  }
  function ffWriteSaves(saves){localStorage.setItem(FF_FRIENDLY_SAVE_KEY,JSON.stringify(saves.slice(0,20)));}
  function ffNewSaveId(){return 'friendly_'+Date.now()+'_'+Math.random().toString(36).slice(2,7);}
  function ffClone(value){return JSON.parse(JSON.stringify(value));}
  function ffOwnerKey(){const p=managerProfile();return String(p?.email||p?.fullName||p?.surname||'player').trim().toLowerCase();}
  function ffSaveSummary(id,createdAt,updatedAt){
    return {
      id,version:1,mode:'friendly',createdAt,updatedAt,
      status:state?.finished?'finished':'in-progress',
      minute:currentMinute(),score:ffClone(state?.score||{blue:0,red:0}),
      homeTeam:teamName('blue'),awayTeam:teamName('red'),managerSurname:managerSurname(),ownerKey:ffOwnerKey(),
      state:ffClone(state),board:ffClone(window.FOOTBALL_FORTUNE_CURRENT_BOARD||[]),
      feedHTML:$('.live-report-feed')?.innerHTML||''
    };
  }
  function ffSaveGame(reason='autosave'){
    if(!ffSaveEnabled||!state||state.busy)return null;
    const now=new Date().toISOString(),saves=ffReadSaves();
    const existing=ffActiveSaveId?saves.find(s=>s.id===ffActiveSaveId):null;
    if(!ffActiveSaveId)ffActiveSaveId=ffNewSaveId();
    const save=ffSaveSummary(ffActiveSaveId,existing?.createdAt||now,now);
    const next=[save,...saves.filter(s=>s.id!==ffActiveSaveId)].sort((a,b)=>new Date(b.updatedAt)-new Date(a.updatedAt));
    ffWriteSaves(next);
    window.dispatchEvent(new CustomEvent('football-fortune-save-changed',{detail:{reason,save}}));
    return save;
  }
  function ffScheduleAutosave(reason='turn'){
    if(!ffSaveEnabled)return;
    clearTimeout(ffAutosaveTimer);
    ffAutosaveTimer=setTimeout(()=>ffSaveGame(reason),100);
  }
  function ffShowSaveToast(message='Game saved'){
    document.querySelector('.ff-save-toast')?.remove();
    const el=document.createElement('div');el.className='ff-save-toast';el.textContent='✓ '+message;document.body.appendChild(el);
    setTimeout(()=>el.classList.add('hide'),1500);setTimeout(()=>el.remove(),1800);
  }
  function ffRestorePhaseUI(){
    hideFinalResult();hideShootoutTransition();
    const shoot=$('#ffIntegratedPenalty'),pitch=$('.pitch-stage');
    if(state.phase==='shootout'&&state.shootout){
      $('#ffGameModal')?.classList.add('hidden');pitch?.classList.add('hidden');shoot?.classList.remove('hidden');shoot?.setAttribute('aria-hidden','false');updateShootoutUI();return;
    }
    shoot?.classList.add('hidden');shoot?.setAttribute('aria-hidden','true');pitch?.classList.remove('hidden');
    if(state.phase==='pre-shootout'){showShootoutTransition();return;}
    if(state.phase==='chance'&&state.pending){
      const p=state.pending,team=teamName(p.player||state.current);
      if(p.kind==='goal'){
        const nums=p.parity==='odd'?[1,3,5]:[2,4,6];
        setModal('GOAL CHANCE',team+' chance','','ROLL TO SHOOT',true,{kind:'goal',headline:p.parity==='odd'?'Odd numbers score':'Even numbers score',commentary:chanceModalCommentary(p.parity==='odd'?'goal-odd':'goal-even',team),numbers:nums});
      }else if(p.kind==='free'||p.kind==='penalty'){
        const isFree=p.kind==='free';
        setModal(isFree?'FREE KICK':'PENALTY',team+' chance','',isFree?'ROLL FREE KICK':'ROLL TO SHOOT',true,{kind:p.kind,headline:isFree?'2 of 6 numbers score':'4 of 6 numbers score',commentary:chanceModalCommentary(p.kind,team),numbers:p.numbers||[]});
      }else{
        const target=(p.numbers||[])[0]||state.m95Target;
        setModal('95TH MINUTE','Last chance!','Roll a '+target+' to score.','ROLL TO SHOOT');
      }
      return;
    }
    if(state.finished||state.phase==='finished'){
      $('#ffGameModal')?.classList.add('hidden');$('#ffGameModal')?.setAttribute('aria-hidden','true');updateStandardDiceAvailability();return;
    }
    setModal(state.finalTurnFor?'FINAL ROLL':'YOUR TURN',state.finalTurnFor?(teamName(state.current)+' have one last roll'):((state.current==='blue'?'Blue':'Red')+' team to roll'),'','ROLL DICE');
  }
  function ffLoadSave(id){
    const save=ffReadSaves().find(s=>s.id===id&&(s.ownerKey||ffOwnerKey())===ffOwnerKey());if(!save)return false;
    ffSaveEnabled=true;ffActiveSaveId=save.id;
    if(typeof window.FOOTBALL_FORTUNE_LOAD_BOARD==='function')window.FOOTBALL_FORTUNE_LOAD_BOARD(save.board||[]);
    state=ffClone(save.state);state.busy=false;state.quickSimulating=false;
    updateM95TargetDisplay();updateScore();updateClock();placeTokens();
    const feed=$('.live-report-feed');if(feed)feed.innerHTML=save.feedHTML||'';
    lastReportCommentary=feed?.querySelector('.report-body')?.textContent?.trim()||'';
    ffRestorePhaseUI();updateStandardDiceAvailability();
    requestAnimationFrame(()=>requestAnimationFrame(()=>{placeTokens();try{window.FOOTBALL_FORTUNE_DRAW_LOCKED_ROUTE?.();}catch(e){}}));
    return true;
  }
  function ffStartNewFriendly(){ffSaveEnabled=true;ffActiveSaveId=null;try{window.FOOTBALL_FORTUNE_GENERATE_BOARD?.();}catch(e){}resetGame();ffScheduleAutosave('kickoff');}

  window.FOOTBALL_FORTUNE_SAVE_GAME=()=>{const saved=ffSaveGame('manual');if(saved)ffShowSaveToast('Friendly saved');return saved;};
  window.FOOTBALL_FORTUNE_AUTOSAVE_NOW=()=>ffSaveGame('navigation');
  window.FOOTBALL_FORTUNE_LIST_SAVES=()=>ffReadSaves().filter(s=>(s.ownerKey||ffOwnerKey())===ffOwnerKey()).sort((a,b)=>new Date(b.updatedAt)-new Date(a.updatedAt));
  window.FOOTBALL_FORTUNE_GET_RECENT_SAVE=()=>window.FOOTBALL_FORTUNE_LIST_SAVES().find(s=>s.status!=='finished')||null;
  window.FOOTBALL_FORTUNE_LOAD_SAVE=ffLoadSave;
  window.FOOTBALL_FORTUNE_DELETE_SAVE=(id)=>{const saves=ffReadSaves().filter(s=>s.id!==id);ffWriteSaves(saves);if(ffActiveSaveId===id)ffActiveSaveId=null;window.dispatchEvent(new CustomEvent('football-fortune-save-changed',{detail:{reason:'delete',id}}));};
  window.FOOTBALL_FORTUNE_START_NEW_FRIENDLY=ffStartNewFriendly;
  function resetGame(){
    if(ffSaveEnabled)ffActiveSaveId=null;
    closeMatchSummary();
    hideFinalResult();
    hideShootoutTransition();
    if(state)state.quickSimulating=false;
    const shoot=$('#ffIntegratedPenalty');if(shoot){shoot.classList.add('hidden');shoot.setAttribute('aria-hidden','true');}$('.pitch-stage')?.classList.remove('hidden');
    state={pos:{blue:0,red:0},score:{blue:0,red:0},scorers:{blue:[],red:[]},captains:{blue:pick([6,8,8,10]),red:pick([6,8,8,10])},current:'blue',phase:'move',pending:null,busy:false,finished:false,halfTimeCalled:false,halfTimeScore:null,finalTurnFor:null,m95Target:randomDie(),matchEvents:{yellows:{blue:0,red:0},reds:{blue:0,red:0},injuries:{blue:0,red:0}},unavailable:{blue:[],red:[]},matchFlow:{goals:0,chances:0,cards:0,reds:0,injuries:0},summaryEvents:[],shootout:null}; updateM95TargetDisplay(); updateScore();$('.half-time-score').textContent='';$('.match-minute').textContent="0'";const l=$('.live-clock');if(l)l.textContent="0'";const feed=$('.live-report-feed');if(feed)feed.innerHTML='';lastReportCommentary='';const sd=$('#ffSidebarDie');if(sd){sd.classList.remove('rolling');sd.style.transform='rotateX(-15deg) rotateY(25deg)';}placeTokens();setModal('KICK OFF','Blue team to roll','','ROLL DICE');const mp=managerPronouns(); report(null,'Kick Off',`${managerSurname()} takes charge of this one and will be hoping ${mp.possessive} team can come out on top.`,'⚽',0);
  }
  async function quickSimMove(player,toIndex){
    const el=token(player);
    const direction=toIndex>=state.pos[player]?1:-1;
    while(state.pos[player]!==toIndex){
      const fromIndex=state.pos[player], nextIndex=fromIndex+direction;
      const from=ROUTE[fromIndex], to=ROUTE[nextIndex];
      await window.FOOTBALL_FORTUNE_ROUTE.movePieceAlongRoute(el,from,to,18);
      state.pos[player]=nextIndex;
      placeTokens();
      updateClock();
      if(ROUTE[nextIndex]==='halftime'&&!state.halfTimeCalled){
        state.halfTimeCalled=true;
        state.halfTimeScore={...state.score};
        $('.half-time-score').textContent=`(HT ${state.score.blue}–${state.score.red})`;
        report(null,'HALF TIME',halfTimeCommentary(),'⏸️',45);
        await wait(22);
      }
      await wait(4);
    }
  }

  async function quickSimResolveChance(){
    const q=state.pending, p=q.player||state.current, v=randomDie();
    let ok=q.kind==='goal'?((v%2===1)===(q.parity==='odd')):(q.numbers||[]).includes(v);
    await wait(22);
    if(ok) scoreGoal(p,q.kind==='goal'?'goal':q.kind);
    else {
      const title=q.kind==='penalty'?'PENALTY MISSED':q.kind==='free'?'FREE KICK MISSED':'CHANCE MISSED';
      const icon=q.kind==='penalty'?'🥅':q.kind==='free'?'🎯':'😮';
      report(p,title,missedChanceCommentary(q.kind,p),icon);
    }
    await wait(22);
    finishTurn();
  }

  async function quickSimResolveLanding(player){
    const id=ROUTE[state.pos[player]], minute=minuteFor(id), team=teamName(player);
    if(id==='fulltime'){reachedFullTime(player);return;}
    if(id==='m95'){
      const target=state.m95Target;
      state.phase='chance'; state.pending={player,kind:'late',numbers:[target]};
      report(player,'95TH-MINUTE DRAMA!',pick([`${team} have one last chance. A ${target} scores.`,`We're into the 95th minute — one roll, one chance. They need a ${target}.`,`Last-gasp opportunity for ${team}. They need a ${target}.`]),'⏱️');
      await wait(14); return;
    }
    const ev=eventAt(id);
    if(!ev){
      if(id!=='halftime') report(player,`${minute}'`,quietMatchCommentary(minute),'⏱️');
      await wait(18); finishTurn(); return;
    }
    if(ev.type==='open'){
      report(player,'OPEN GOAL!',pick([`${team} have an open goal — surely this has to be finished.`,`The keeper is stranded! ${team} have the goal at their mercy.`,`What a chance for ${team} — an open goal!`]),'🥅');
      scoreGoal(player,'goal'); await wait(25); finishTurn(); return;
    }
    if(ev.type==='yellow'||ev.type==='red'||ev.type==='injury'){
      const color=ev.type==='red'?'red':ev.type==='yellow'?'yellow':'blue';
      let title,icon,text;
      if(ev.type==='yellow'){
        state.matchEvents.yellows[player]++;
        const n=shirtNumber(pick(['defender','defender','attacker']),player);
        title='YELLOW CARD';icon='🟨';text=pick([
          `Number ${n} goes into the book for ${team}. A late challenge — and they may be a little lucky it wasn't red.`,
          `Yellow card for Number ${n} of ${team}. They mistimed the tackle and the referee had no hesitation.`,
          `Number ${n} is booked for ${team}. A clumsy challenge, and they'll need to be careful from here.`
        ]);
      }
      else if(ev.type==='red'){
        state.matchEvents.reds[player]++;
        const n=shirtNumber(pick(['defender','attacker']),player);
        markUnavailable(player,n);
        title='RED CARD';icon='🟥';text=pick([
          `RED CARD! Number ${n} is sent off for ${team}. A huge moment in the match.`,
          `Number ${n} sees red for ${team}. They're down to ten and have to regroup.`,
          `They're off! Number ${n} is dismissed and ${team} must finish with ten players.`
        ]);
      }
      else {
        state.matchEvents.injuries[player]++;
        const injury=resolvePlayerInjury(player,team);
        title='INJURY';icon='🩹';text=injury.text;
      }
      report(player,title,text,icon); pulseDestination(ev.to,color); await wait(25);
      const ix=ROUTE.indexOf(ev.to); if(ix>=0) await quickSimMove(player,ix);
      await wait(20); finishTurn(); return;
    }
    if(ev.type==='goal-odd'||ev.type==='goal-even'){
      const parity=ev.type==='goal-odd'?'odd':'even';
      state.phase='chance'; state.pending={player,kind:'goal',parity};
      report(player,'GOAL CHANCE!',pick([`${team} are in! ${parity==='odd'?'An odd number':'An even number'} will score.`,`A chance opens up for ${team}. ${parity==='odd'?'Odd':'Even'} is what they need.`,`${team} have a sight of goal. One more roll decides it.`]),'⚽');
      await wait(14); return;
    }
    if(ev.type==='free'||ev.type==='penalty'){
      state.phase='chance'; state.pending={player,kind:ev.type,numbers:ev.success||[]};
      if(ev.type==='penalty') report(player,'PENALTY!',pick([`Penalty to ${team}! A huge chance.`,`The referee points to the spot for ${team}.`,`Big moment for ${team} — it's a penalty.`]),'🥅');
      else report(player,'FREE KICK!',pick([`Free kick in a dangerous area for ${team}.`,`${team} have a set-piece chance here.`,`This free kick could cause trouble.`]),'🎯');
      await wait(14); return;
    }
    finishTurn();
  }

  async function quickSim(){
    if(state.busy)return;

    // During a shootout, the same top-bar Quick Sim button completes penalties.
    if(state.phase==='shootout'){
      if(state.shootout?.winner)return;
      state.quickSimulating=true;
      setBusy(true);
      const simBtn=$('#quickSimBtn');if(simBtn)simBtn.disabled=true;
      const hint=$('#ffSidebarDiceHint');if(hint)hint.textContent='Quick sim penalties running…';
      try{await quickSimShootout();}
      finally{
        state.quickSimulating=false;
        setBusy(false);
        if(simBtn&&!state.shootout?.winner)simBtn.disabled=false;
        updateStandardDiceAvailability();
      }
      return;
    }

    // The draw hand-off requires Continue; do not skip the transition screen.
    if(state.phase==='pre-shootout')return;

    resetGame();
    state.quickSimulating=true;
    setBusy(true);
    $('#ffGameModal').classList.add('hidden');
    $('#ffGameModal').setAttribute('aria-hidden','true');
    const simBtn=$('#quickSimBtn'); if(simBtn)simBtn.disabled=true;
    const hint=$('#ffSidebarDiceHint'); if(hint)hint.textContent='Quick sim running…';
    let safety=0;
    // Regulation only: stop the instant the main match reaches the shootout hand-off.
    while(!state.finished&&state.phase!=='pre-shootout'&&state.phase!=='shootout'&&safety++<250){
      if(state.phase==='chance'){
        await quickSimResolveChance();
        continue;
      }
      const p=state.current, v=randomDie();
      const target=Math.min(ROUTE.length-1,state.pos[p]+v);
      await quickSimMove(p,target);
      await quickSimResolveLanding(p);
      await wait(14);
    }
    if(!state.finished&&state.phase!=='pre-shootout'&&state.phase!=='shootout')endMatch();
    placeTokens(); updateClock();
    state.quickSimulating=false;
    setBusy(false);
    if(simBtn)simBtn.disabled=false;
    const liveReportFeed=$('.live-report-feed'); if(liveReportFeed)liveReportFeed.scrollTop=0;
    await wait(125);

    // A draw now pauses on the Full Time transition card until Continue is pressed.
    if(state.phase==='pre-shootout'){
      showShootoutTransition();
      return;
    }
    if(state.phase==='shootout')return;

    // Regulation produced a winner (or a mode where a draw stands): now show the summary.
    if(state.finished)showFinalResult();
  }

  async function quickSimPenalties(){
    if(state.busy||state.phase!=='shootout'||state.shootout?.winner)return;
    return quickSim();
  }
  function install(){
    // replace buttons to remove old prototype listeners while preserving styling
    const oldNew=$('#restartMatchBtn'), newNew=oldNew.cloneNode(true);oldNew.replaceWith(newNew);newNew.addEventListener('click',()=>{window.FOOTBALL_FORTUNE_GENERATE_BOARD?.();setTimeout(resetGame,60);});
    const oldSim=$('#quickSimBtn'),newSim=oldSim.cloneNode(true);oldSim.replaceWith(newSim);newSim.addEventListener('click',quickSim);
    $('#ffRollBtn').addEventListener('click',doRoll);
    $('#ffSidebarRollBtn').addEventListener('click',doRoll);
    $('#ffDiceCollapseBtn').addEventListener('click',()=>{$('#ffGameModal').classList.add('hidden');$('#ffGameModal').setAttribute('aria-hidden','true');$('#ffDiceRestoreBtn').classList.remove('hidden');});
    $('#ffDiceRestoreBtn').addEventListener('click',()=>{$('#ffDiceRestoreBtn').classList.add('hidden');$('#ffGameModal').classList.remove('hidden');$('#ffGameModal').setAttribute('aria-hidden','false');});
    $('#ffSummaryCloseBtn')?.addEventListener('click',closeMatchSummary);
    $('#ffResultSummaryBtn')?.addEventListener('click',showMatchSummary);
    $('#ffResultCloseBtn')?.addEventListener('click',()=>{
      if(getMatchMode()==='tournament'&&window.FOOTBALL_FORTUNE_RETURN_TO_TOURNAMENT){
        hideFinalResult();
        window.FOOTBALL_FORTUNE_RETURN_TO_TOURNAMENT();
      }else hideFinalResult();
    });
    document.querySelectorAll('[data-pen-dir]').forEach(btn=>btn.addEventListener('click',()=>chooseShootoutDirection(btn.dataset.penDir)));
    $('#ffPenSummaryBtn')?.addEventListener('click',()=>{const host=$('#ffIntegratedPenalty');if(host){host.classList.add('hidden');host.setAttribute('aria-hidden','true');}showFinalResult();});
    $('#ffShootoutContinueBtn')?.addEventListener('click',()=>{if(state.phase==='pre-shootout')beginShootout();});
    updateMatchModeTitle();
    setTimeout(resetGame,80);
  }
  document.addEventListener('DOMContentLoaded',install);
})();
</script>


<script>
(() => {
  const q=s=>document.querySelector(s);
  const shell=q('#ffJourneyShell');
  // Reuse the approved login artwork and logo rather than introducing new assets.
  const playerArtwork=q('.ffj-auth-visual .ffj-hero img');
  if(playerArtwork){
    const image=playerArtwork.cloneNode(true);
    image.alt='Male and female Football Fortune players';
    q('.ffj-landing-art')?.append(image);
  }
  const brandLogo=q('.ffj-auth-visual .ffj-visual-logo img');
  if(brandLogo){
    const landingTopbarLogo=brandLogo.cloneNode(true);
    landingTopbarLogo.alt='Football Fortune';
    q('#ffjLandingTopbarLogo')?.append(landingTopbarLogo);
    const contractLogo=brandLogo.cloneNode(true);
    contractLogo.alt='Football Fortune';
    q('.ffj-contract-logo')?.append(contractLogo);
    const modeTopbarLogo=brandLogo.cloneNode(true);
    modeTopbarLogo.alt='Football Fortune';
    q('#ffjModeTopbarLogo')?.append(modeTopbarLogo);
    const tournamentSetupLogo=brandLogo.cloneNode(true);
    tournamentSetupLogo.alt='Football Fortune';
    q('#ffjTournamentSetupLogo')?.append(tournamentSetupLogo);
  }
  if(playerArtwork){
    const modePlayers=playerArtwork.cloneNode(true);
    modePlayers.alt='Male and female Football Fortune players';
    q('#ffjModeArt')?.append(modePlayers);
  }
  const views=['ffjAuthView','ffjContractView','ffjLandingView'];
  const REMEMBER_KEY='footballFortuneRememberedLogin';
  const PROFILE_KEY='footballFortunePlayerProfile';
  let playerProfile={firstName:'Player',surname:'',fullName:'Player',gender:'male',email:''};
  let managerName='Player';

  function normaliseProfile(raw){
    const firstName=typeof raw?.firstName==='string'?raw.firstName.trim():'';
    const surname=typeof raw?.surname==='string'?raw.surname.trim():'';
    const fullName=[firstName,surname].filter(Boolean).join(' ') || (typeof raw?.fullName==='string'&&raw.fullName.trim()?raw.fullName.trim():'Player');
    return {
      firstName:firstName || (fullName!=='Player'?fullName.split(/\s+/)[0]:'Player'),
      surname:surname || (fullName.includes(' ')?fullName.split(/\s+/).slice(1).join(' '):''),
      fullName,
      gender:raw?.gender==='female'?'female':'male',
      email:typeof raw?.email==='string'?raw.email:''
    };
  }
  function loadPlayerProfile(){
    try{
      const saved=JSON.parse(localStorage.getItem(PROFILE_KEY)||'null');
      return saved?normaliseProfile(saved):null;
    }catch(e){return null;}
  }
  function savePlayerProfile(profile){
    playerProfile=normaliseProfile(profile);
    managerName=playerProfile.firstName || playerProfile.fullName || 'Player';
    window.FOOTBALL_FORTUNE_PLAYER_PROFILE={...playerProfile};
    try{localStorage.setItem(PROFILE_KEY,JSON.stringify(playerProfile));}catch(e){}
  }
  function loadRememberedLogin(){
    try{
      const saved=JSON.parse(localStorage.getItem(REMEMBER_KEY)||'null');
      if(!saved?.remembered)return null;
      return {email:typeof saved.email==='string'?saved.email:''};
    }catch(e){return null;}
  }
  function saveRememberedLogin(email){
    try{
      localStorage.setItem(REMEMBER_KEY,JSON.stringify({remembered:true,email:email||''}));
    }catch(e){}
  }
  function clearRememberedLogin(){
    try{localStorage.removeItem(REMEMBER_KEY);}catch(e){}
  }
  function populateContract(){
    const full=playerProfile.fullName || 'Player';
    const surname=playerProfile.surname || playerProfile.firstName || full;
    if(q('#ffjContractPlayer'))q('#ffjContractPlayer').textContent=full+'!';
    if(q('#ffjContractSignature'))q('#ffjContractSignature').textContent=full;
    if(q('#ffjContractHeadlineName'))q('#ffjContractHeadlineName').textContent=full;
    if(q('#ffjContractStoryName'))q('#ffjContractStoryName').textContent=full;
    if(q('#ffjContractStorySurname'))q('#ffjContractStorySurname').textContent=surname;
    const image=q('#ffjContractSigningImage');
    if(image){
      const isFemale=playerProfile.gender==='female';
      image.src=isFemale ? image.dataset.femaleSrc : image.dataset.maleSrc;
      image.alt=(isFemale?'Female':'Male')+' Football Fortune player signing a contract';
    }
  }

  function showJourneyView(id){
    shell?.classList.remove('hidden');
    document.body.classList.add('ffj-pre-game');
    views.forEach(v=>q('#'+v)?.classList.toggle('active',v===id));
  }
  function showAuthPane(id){
    ['ffjLoginPane','ffjSignupPane','ffjForgotPane'].forEach(v=>q('#'+v)?.classList.toggle('active',v===id));
    q('#ffjLoginTab')?.classList.toggle('active',id==='ffjLoginPane');
    q('#ffjSignupTab')?.classList.toggle('active',id==='ffjSignupPane');
  }
  function showLanding(){
    q('#ffjWelcome').textContent=`Welcome back, ${playerProfile.firstName || managerName || 'Player'}!`;
    showJourneyView('ffjLandingView');
    setTimeout(refreshSaveLanding,0);
  }
  function enterFriendlyMatch(){
    q('#ffjModeBackdrop')?.classList.add('hidden');
    q('#ffjLoadBackdrop')?.classList.add('hidden');
    shell?.classList.add('hidden');
    document.body.classList.remove('ffj-pre-game');
    const title=q('#ffMatchTitle'); if(title)title.textContent='Friendly: Match Day';
    requestAnimationFrame(()=>requestAnimationFrame(()=>{
      try{window.FOOTBALL_FORTUNE_DRAW_LOCKED_ROUTE?.();}catch(e){}
    }));
  }
  function startFriendly(){
    enterFriendlyMatch();
    requestAnimationFrame(()=>requestAnimationFrame(()=>{
      try{
        if(typeof window.FOOTBALL_FORTUNE_START_NEW_FRIENDLY==='function')window.FOOTBALL_FORTUNE_START_NEW_FRIENDLY();
        else if(typeof resetGame==='function')resetGame();
      }catch(e){}
      try{window.FOOTBALL_FORTUNE_DRAW_LOCKED_ROUTE?.();}catch(e){}
    }));
  }
  q('#ffjLoginTab')?.addEventListener('click',()=>showAuthPane('ffjLoginPane'));
  q('#ffjSignupTab')?.addEventListener('click',()=>showAuthPane('ffjSignupPane'));
  q('#ffjForgotBtn')?.addEventListener('click',()=>showAuthPane('ffjForgotPane'));
  q('#ffjBackLoginBtn')?.addEventListener('click',()=>showAuthPane('ffjLoginPane'));

  q('#ffjLoginBtn')?.addEventListener('click',()=>{
    const email=q('#ffjLoginEmail').value.trim();
    const pw=q('#ffjLoginPassword').value;
    if(!email||!pw){q('#ffjLoginMessage').textContent='Enter your email address and password.';return;}
    const savedProfile=loadPlayerProfile();
    if(savedProfile && (!savedProfile.email || savedProfile.email.toLowerCase()===email.toLowerCase())){
      savePlayerProfile({...savedProfile,email});
    }else{
      savePlayerProfile({firstName:'Player',surname:'',fullName:'Player',gender:'male',email});
    }
    if(q('#ffjRememberMe')?.checked) saveRememberedLogin(email);
    else clearRememberedLogin();
    showLanding();
  });

  q('#ffjSignupBtn')?.addEventListener('click',()=>{
    const firstName=q('#ffjSignupFirstName').value.trim();
    const surname=q('#ffjSignupSurname').value.trim();
    const email=q('#ffjSignupEmail').value.trim();
    const pw=q('#ffjSignupPassword').value;
    const gender=q('[data-ffj-gender].active')?.dataset.ffjGender || 'male';
    if(!firstName||!surname||!email||pw.length<8){
      q('#ffjSignupMessage').textContent='Enter your first name, surname, email and a password of at least 8 characters.';
      return;
    }
    savePlayerProfile({firstName,surname,fullName:`${firstName} ${surname}`,gender,email});
    saveRememberedLogin(email);
    populateContract();
    showJourneyView('ffjContractView');
  });
  document.querySelectorAll('[data-ffj-gender]').forEach(btn=>btn.addEventListener('click',()=>{
    document.querySelectorAll('[data-ffj-gender]').forEach(x=>x.classList.remove('active'));
    btn.classList.add('active');
  }));
  q('#ffjResetBtn')?.addEventListener('click',()=>{
    q('#ffjForgotMessage').textContent=q('#ffjForgotEmail').value.trim()
      ? 'If that account exists, a reset link would be sent to it.'
      : 'Enter your email address.';
  });
  q('#ffjContractContinueBtn')?.addEventListener('click',showLanding);

  function formatFriendlySave(save){
    if(!save)return 'No recent Friendly save yet.';
    const when=new Date(save.updatedAt),today=new Date();
    const sameDay=when.toDateString()===today.toDateString();
    const time=when.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
    const dateLabel=sameDay?('Today '+time):(when.toLocaleDateString([], {day:'numeric',month:'short',year:'numeric'})+' '+time);
    const status=save.status==='finished'?'Full time':(save.minute+"'");
    return (save.homeTeam||'Home Team')+' '+(save.score?.blue??0)+'–'+(save.score?.red??0)+' '+(save.awayTeam||'Away Team')+' · '+status+' · '+dateLabel;
  }
  function refreshSaveLanding(){
    const recent=window.FOOTBALL_FORTUNE_GET_RECENT_SAVE?.()||null;
    const continueBtn=q('#ffjContinueBtn'),detail=q('#ffjContinueDetail');
    if(continueBtn)continueBtn.disabled=!recent;
    if(detail)detail.textContent=recent?formatFriendlySave(recent):'No unfinished Friendly save yet.';
    const saves=window.FOOTBALL_FORTUNE_LIST_SAVES?.()||[];
    const loadDetail=q('#ffjLoadDetail');
    if(loadDetail)loadDetail.textContent=saves.length?(saves.length+' saved Friendly'+(saves.length===1?'':' matches')+' available.'):'No saved Friendly matches yet.';
  }
  function renderSaveList(){
    const host=q('#ffjSaveList');if(!host)return;
    const saves=window.FOOTBALL_FORTUNE_LIST_SAVES?.()||[];
    host.innerHTML='';
    if(!saves.length){host.innerHTML='<div class="ffj-save-empty">No Friendly saves yet. Start a match and Football Fortune will autosave as you play.</div>';return;}
    saves.forEach(save=>{
      const row=document.createElement('div');row.className='ffj-save-row';
      const title=save.status==='finished'?'Finished Friendly':'Friendly in progress';
      row.innerHTML='<div class="ffj-save-icon">⚽</div><div class="ffj-save-copy"><strong>'+title+'</strong><div class="ffj-save-meta">'+formatFriendlySave(save)+'</div></div><div class="ffj-save-actions"><button class="ffj-save-load" type="button" data-load-save="'+save.id+'">Load</button><button class="ffj-save-delete" type="button" data-delete-save="'+save.id+'">Delete</button></div>';
      host.appendChild(row);
    });
  }
  function openLoadGames(){
    renderSaveList();
    const modal=q('#ffjLoadBackdrop');modal?.classList.remove('hidden');modal?.setAttribute('aria-hidden','false');
  }
  function closeLoadGames(){
    const modal=q('#ffjLoadBackdrop');modal?.classList.add('hidden');modal?.setAttribute('aria-hidden','true');
  }

  const TOURNAMENT_KEY='footballFortuneTournamentV1';
  const TOURNAMENT_COUNTRIES=[
    {name:'England',flag:'🇬🇧'},{name:'Scotland',flag:'🏴'},{name:'Wales',flag:'🏴'},{name:'Republic of Ireland',flag:'🇮🇪'},
    {name:'France',flag:'🇫🇷'},{name:'Spain',flag:'🇪🇸'},{name:'Portugal',flag:'🇵🇹'},{name:'Germany',flag:'🇩🇪'},
    {name:'Italy',flag:'🇮🇹'},{name:'Netherlands',flag:'🇳🇱'},{name:'Belgium',flag:'🇧🇪'},{name:'Croatia',flag:'🇭🇷'},
    {name:'Denmark',flag:'🇩🇰'},{name:'Switzerland',flag:'🇨🇭'},{name:'Austria',flag:'🇦🇹'},{name:'Norway',flag:'🇳🇴'},
    {name:'Sweden',flag:'🇸🇪'},{name:'Poland',flag:'🇵🇱'},{name:'Ukraine',flag:'🇺🇦'},{name:'Türkiye',flag:'🇹🇷'},
    {name:'Brazil',flag:'🇧🇷'},{name:'Argentina',flag:'🇦🇷'},{name:'Uruguay',flag:'🇺🇾'},{name:'Colombia',flag:'🇨🇴'},
    {name:'United States',flag:'🇺🇸'},{name:'Mexico',flag:'🇲🇽'},{name:'Canada',flag:'🇨🇦'},{name:'Japan',flag:'🇯🇵'},
    {name:'South Korea',flag:'🇰🇷'},{name:'Australia',flag:'🇦🇺'},{name:'Morocco',flag:'🇲🇦'},{name:'Nigeria',flag:'🇳🇬'}
  ];
  let selectedTournamentSize=16;
  let tournamentState=null;

  function tournamentRoundNames(size){
    if(size===4)return ['Semi-final','Final'];
    if(size===8)return ['Quarter-final','Semi-final','Final'];
    return ['Round of 16','Quarter-final','Semi-final','Final'];
  }
  function shuffled(items){
    const a=[...items];
    for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}
    return a;
  }
  function loadTournament(){
    try{return JSON.parse(localStorage.getItem(TOURNAMENT_KEY)||'null');}catch(e){return null;}
  }
  function saveTournament(){
    if(tournamentState)localStorage.setItem(TOURNAMENT_KEY,JSON.stringify(tournamentState));
  }
  function showTournamentScreen(id){
    q('#ffjModeBackdrop')?.classList.add('hidden');
    q('#ffjTournamentSetup')?.classList.toggle('hidden',id!=='setup');
    q('#ffjTournamentHub')?.classList.toggle('hidden',id!=='hub');
    q('#ffjTournamentSetup')?.setAttribute('aria-hidden',id==='setup'?'false':'true');
    q('#ffjTournamentHub')?.setAttribute('aria-hidden',id==='hub'?'false':'true');
  }
  function hideTournamentScreens(){
    q('#ffjTournamentSetup')?.classList.add('hidden');
    q('#ffjTournamentHub')?.classList.add('hidden');
    q('#ffjTournamentSetup')?.setAttribute('aria-hidden','true');
    q('#ffjTournamentHub')?.setAttribute('aria-hidden','true');
  }
  function populateTournamentCountries(){
    const select=q('#ffjTournamentCountry');if(!select)return;
    if(select.options.length)return;
    TOURNAMENT_COUNTRIES.forEach(c=>{
      const option=document.createElement('option');
      option.value=c.name;
      option.textContent=c.flag+'  '+c.name;
      select.appendChild(option);
    });
    select.value='England';
  }
  function openTournamentSetup(){
    closeAllMenus?.();
    populateTournamentCountries();
    showTournamentScreen('setup');
  }
  function createTournament(){
    const countryName=q('#ffjTournamentCountry')?.value||'England';
    const userCountry=TOURNAMENT_COUNTRIES.find(c=>c.name===countryName)||TOURNAMENT_COUNTRIES[0];
    const others=shuffled(TOURNAMENT_COUNTRIES.filter(c=>c.name!==userCountry.name)).slice(0,selectedTournamentSize-1);
    const teams=shuffled([userCountry,...others]);
    tournamentState={
      id:'tournament_'+Date.now(),
      competition:'Fortune Nations Cup',
      size:selectedTournamentSize,
      userCountry:userCountry.name,
      createdAt:new Date().toISOString(),
      currentRound:0,
      teams,
      rounds:[],
      stats:{goals:[],assists:[]}
    };
    const roundNames=tournamentRoundNames(selectedTournamentSize);
    let teamSlots=teams.map(t=>({...t}));
    roundNames.forEach((roundName,roundIndex)=>{
      const matchCount=selectedTournamentSize/Math.pow(2,roundIndex+1);
      const matches=[];
      for(let i=0;i<matchCount;i++){
        matches.push({
          id:'r'+roundIndex+'m'+i,
          round:roundName,
          home:roundIndex===0?teamSlots[i*2]:null,
          away:roundIndex===0?teamSlots[i*2+1]:null,
          winner:null,
          score:null
        });
      }
      tournamentState.rounds.push({name:roundName,matches});
    });
    saveTournament();
    renderTournament();
    showTournamentScreen('hub');
  }
  function countryByName(name){
    return TOURNAMENT_COUNTRIES.find(c=>c.name===name)||{name:name||'TBC',flag:'⚪'};
  }
  function teamRow(team,emptyLabel='Winner TBC',score=null,stateClass=''){
    if(!team)return '<div class="ffj-bracket-team empty"><span class="ffj-bracket-team-main"><span class="ffj-flag">○</span><span>'+emptyLabel+'</span></span></div>';
    return '<div class="ffj-bracket-team '+stateClass+'"><span class="ffj-bracket-team-main"><span class="ffj-flag">'+team.flag+'</span><span>'+team.name+'</span></span>'+(score===null?'':'<span class="ffj-bracket-team-score">'+score+'</span>')+'</div>';
  }
  function tournamentMatchMarkup(m){
    const played=!!m.winner;
    const homeWinner=played&&m.winner?.name===m.home?.name;
    const awayWinner=played&&m.winner?.name===m.away?.name;
    const score=m.score||null;
    let html=teamRow(m.home,'Winner TBC',score?score.home:null,homeWinner?'winner':played?'loser':'');
    html+=teamRow(m.away,'Winner TBC',score?score.away:null,awayWinner?'winner':played?'loser':'');
    if(score?.pens)html+='<div class="ffj-bracket-match-result">'+score.pens.home+'–'+score.pens.away+' on penalties</div>';
    else if(played)html+='<div class="ffj-bracket-match-result">'+m.winner.name+' progress</div>';
    return html;
  }
  function sideRoundMatchIndexes(roundIndex,side){
    const matches=tournamentState.rounds[roundIndex].matches;
    const half=Math.ceil(matches.length/2);
    return side==='left'
      ? matches.slice(0,half).map((m,i)=>({m,index:i}))
      : matches.slice(half).map((m,i)=>({m,index:i+half}));
  }
  function renderBracketRound(roundIndex,side,colIndex){
    const round=tournamentState.rounds[roundIndex];
    const entries=sideRoundMatchIndexes(roundIndex,side);
    const div=document.createElement('div');
    div.className='ffj-bracket-round';
    div.dataset.side=side;
    div.dataset.round=String(roundIndex);
    div.style.gridColumn=String(colIndex);
    div.innerHTML='<div class="ffj-bracket-round-title">'+round.name+'</div><div class="ffj-bracket-match-stack"></div>';
    const stack=div.querySelector('.ffj-bracket-match-stack');
    entries.forEach(({m,index})=>{
      const card=document.createElement('div');
      const userPath=[m.home?.name,m.away?.name,m.winner?.name].includes(tournamentState.userCountry);
      card.className='ffj-bracket-match'+(userPath?' user-path':'');
      card.dataset.matchId=m.id;
      card.dataset.round=String(roundIndex);
      card.dataset.matchIndex=String(index);
      card.dataset.side=side;
      const currentUserFixture=!m.winner&&roundIndex===tournamentState.currentRound&&m.home&&m.away&&(m.home.name===tournamentState.userCountry||m.away.name===tournamentState.userCountry);
      if(currentUserFixture)card.classList.add('current-fixture');
      card.innerHTML=tournamentMatchMarkup(m)+(currentUserFixture?'<button class="ffj-play-tournament-match" type="button" data-play-tournament-match="'+m.id+'">Play match →</button>':'');
      stack.appendChild(card);
    });
    return div;
  }

  function tournamentCurrentUserMatch(){
    if(!tournamentState)return null;
    const round=tournamentState.rounds[tournamentState.currentRound];
    if(!round)return null;
    return round.matches.find(m=>!m.winner&&(m.home?.name===tournamentState.userCountry||m.away?.name===tournamentState.userCountry))||null;
  }
  function advanceTournamentWinner(roundIndex,matchIndex,winner){
    const nextRound=tournamentState.rounds[roundIndex+1];
    if(!nextRound)return;
    const nextMatch=nextRound.matches[Math.floor(matchIndex/2)];
    if(!nextMatch)return;
    if(matchIndex%2===0)nextMatch.home={...winner};
    else nextMatch.away={...winner};
  }
  function randomAIScore(){
    let a=Math.floor(Math.random()*4),b=Math.floor(Math.random()*4);
    let pens=null;
    if(a===b){
      let pa=3+Math.floor(Math.random()*4),pb=3+Math.floor(Math.random()*4);
      if(pa===pb)pa++;
      pens={home:pa,away:pb};
    }
    return {home:a,away:b,pens};
  }
  function simulateTournamentAIMatch(roundIndex,matchIndex,match){
    if(!match||match.winner||!match.home||!match.away)return;
    const r=randomAIScore();
    let homeWins;
    if(r.home!==r.away)homeWins=r.home>r.away;
    else homeWins=r.pens.home>r.pens.away;
    match.score=r;
    match.winner={...(homeWins?match.home:match.away)};
    match.simulated=true;
    advanceTournamentWinner(roundIndex,matchIndex,match.winner);
  }
  function completeTournamentRoundIfReady(){
    const round=tournamentState?.rounds?.[tournamentState.currentRound];
    if(!round||!round.matches.every(m=>m.winner))return;
    if(tournamentState.currentRound>=tournamentState.rounds.length-1){
      tournamentState.champion={...round.matches[0].winner};
      tournamentState.completed=true;
      saveTournament();
      return;
    }
    tournamentState.currentRound++;
    saveTournament();
  }
  function simulateOtherTournamentFixtures(roundIndex,userMatchId){
    const round=tournamentState.rounds[roundIndex];
    round.matches.forEach((m,i)=>{
      if(m.id!==userMatchId&&!m.winner)simulateTournamentAIMatch(roundIndex,i,m);
    });
  }
  function playedTournamentResult(payload){
    if(!tournamentState?.activeMatchId)return;
    const roundIndex=tournamentState.activeRound;
    const round=tournamentState.rounds[roundIndex];
    const matchIndex=round?.matches?.findIndex(m=>m.id===tournamentState.activeMatchId)??-1;
    if(matchIndex<0)return;
    const match=round.matches[matchIndex];
    if(match.winner)return;

    const winnerTeam=[match.home,match.away].find(t=>t?.name===payload.winner);
    if(!winnerTeam)return;
    match.score={
      home:Number(payload.homeScore)||0,
      away:Number(payload.awayScore)||0,
      pens:payload.penalties?{home:Number(payload.penalties.home)||0,away:Number(payload.penalties.away)||0}:null
    };
    match.winner={...winnerTeam};
    match.playedByUser=true;
    advanceTournamentWinner(roundIndex,matchIndex,match.winner);
    simulateOtherTournamentFixtures(roundIndex,match.id);
    tournamentState.activeMatchId=null;
    tournamentState.activeRound=null;
    tournamentState.lastResult={matchId:match.id,winner:match.winner.name,round:round.name};
    completeTournamentRoundIfReady();

    const userStillIn=!tournamentState.completed&&tournamentState.rounds
      .slice(tournamentState.currentRound)
      .some(r=>r.matches.some(m=>[m.home?.name,m.away?.name,m.winner?.name].includes(tournamentState.userCountry)));
    if(match.winner.name!==tournamentState.userCountry&&!userStillIn)tournamentState.eliminated=true;
    saveTournament();
  }
  function startTournamentFixture(match){
    if(!tournamentState||!match?.home||!match?.away||match.winner)return;
    const roundIndex=tournamentState.currentRound;
    tournamentState.activeMatchId=match.id;
    tournamentState.activeRound=roundIndex;
    saveTournament();

    localStorage.setItem('footballFortuneMatchMode','tournament');
    const params=new URLSearchParams(window.location.search);
    params.set('mode','tournament');
    params.set('round',tournamentState.rounds[roundIndex].name.toLowerCase().replace(/\s+/g,'-'));
    history.replaceState(null,'',window.location.pathname+'?'+params.toString());

    hideTournamentScreens();
    q('#ffjModeBackdrop')?.classList.add('hidden');
    shell?.classList.add('hidden');
    document.body.classList.remove('ffj-pre-game');

    const names=document.querySelectorAll('.team-name');
    if(names[0])names[0].textContent=match.home.name;
    if(names[1])names[1].textContent=match.away.name;
    const title=q('#ffMatchTitle');
    if(title)title.textContent='Tournament · '+tournamentState.rounds[roundIndex].name;

    q('#restartMatchBtn')?.setAttribute('disabled','true');
    q('#restartMatchBtn')?.setAttribute('title','Tournament fixtures cannot be restarted as a new match');

    requestAnimationFrame(()=>requestAnimationFrame(()=>{
      try{window.FOOTBALL_FORTUNE_GENERATE_BOARD?.();}catch(e){}
      try{if(typeof resetGame==='function')resetGame();}catch(e){}
      try{window.FOOTBALL_FORTUNE_DRAW_LOCKED_ROUTE?.();}catch(e){}
    }));
  }
  function returnToTournament(){
    localStorage.setItem('footballFortuneMatchMode','friendly');
    const params=new URLSearchParams(window.location.search);
    params.delete('mode');params.delete('round');
    const qs=params.toString();
    history.replaceState(null,'',window.location.pathname+(qs?'?'+qs:''));

    q('#ffResultBackdrop')?.classList.add('hidden');
    q('#ffSummaryBackdrop')?.classList.add('hidden');
    q('#ffShootoutTransition')?.classList.add('hidden');
    q('#ffIntegratedPenalty')?.classList.add('hidden');
    document.body.classList.remove('ff-result-open','ff-summary-open');
    shell?.classList.remove('hidden');
    document.body.classList.add('ffj-pre-game');

    const names=document.querySelectorAll('.team-name');
    if(names[0])names[0].textContent='Home Team';
    if(names[1])names[1].textContent='Away Team';
    q('#restartMatchBtn')?.removeAttribute('disabled');
    q('#restartMatchBtn')?.removeAttribute('title');

    renderTournament();
    showTournamentPanel('bracket');
    showTournamentScreen('hub');
  }
  window.FOOTBALL_FORTUNE_TOURNAMENT_MATCH_COMPLETE=playedTournamentResult;
  window.FOOTBALL_FORTUNE_RETURN_TO_TOURNAMENT=returnToTournament;

  function renderTournament(){
    if(!tournamentState)return;
    const rounds=tournamentState.rounds;
    const roundNames=tournamentRoundNames(tournamentState.size);
    const title=q('#ffjTournamentTitle');
    if(title)title.textContent='Tournament · '+roundNames[tournamentState.currentRound];
    q('#ffjTournamentHeading').textContent=tournamentState.competition;
    q('#ffjTournamentSummaryText').textContent=tournamentState.size+' countries · '+roundNames[0]+' to Final · Single elimination';
    q('#ffjTournamentStatusBanner')?.remove();
    const banner=document.createElement('div');
    banner.id='ffjTournamentStatusBanner';
    banner.className='ffj-tournament-status-banner';
    if(tournamentState.completed){
      banner.classList.add('champion');
      banner.textContent=tournamentState.champion?.name===tournamentState.userCountry
        ? '🏆 '+tournamentState.userCountry+' are the Fortune Nations Cup champions!'
        : '🏆 '+(tournamentState.champion?.name||'The winner')+' are the Fortune Nations Cup champions.';
    }else if(tournamentState.eliminated){
      banner.classList.add('eliminated');
      banner.textContent=tournamentState.userCountry+' have been eliminated. You can still follow the remaining tournament bracket.';
    }else{
      const next=tournamentCurrentUserMatch();
      banner.textContent=next&&next.home&&next.away
        ? 'Next match: '+next.home.flag+' '+next.home.name+' vs '+next.away.flag+' '+next.away.name
        : 'The tournament is ready for the next round.';
    }
    q('#ffjTournamentBracketPanel')?.insertBefore(banner,q('.ffj-bracket-scroll'));
    const user=countryByName(tournamentState.userCountry);
    q('#ffjUserCountryChip').innerHTML='<span class="ffj-flag">'+user.flag+'</span><span>'+user.name+'</span>';

    const grid=q('#ffjBracketGrid');if(!grid)return;
    grid.innerHTML='';
    const sideRounds=rounds.length-1;
    const colCount=sideRounds*2+1;
    grid.style.setProperty('--bracket-cols',String(colCount));

    for(let r=0;r<sideRounds;r++){
      grid.appendChild(renderBracketRound(r,'left',r+1));
      grid.appendChild(renderBracketRound(r,'right',colCount-r));
    }

    const finalRound=rounds[rounds.length-1];
    const final=finalRound.matches[0];
    const finalCol=document.createElement('div');
    finalCol.className='ffj-bracket-round ffj-bracket-final';
    finalCol.style.gridColumn=String(sideRounds+1);
    finalCol.dataset.side='final';
    finalCol.dataset.round=String(rounds.length-1);
    const finalUserFixture=!final.winner&&tournamentState.currentRound===rounds.length-1&&final.home&&final.away&&(final.home.name===tournamentState.userCountry||final.away.name===tournamentState.userCountry);
    finalCol.innerHTML='<div class="ffj-bracket-round-title">Final</div><div class="ffj-bracket-match-stack"><div class="ffj-final-trophy">🏆</div><div class="ffj-bracket-match'+(([final.home?.name,final.away?.name,final.winner?.name].includes(tournamentState.userCountry))?' user-path':'')+(finalUserFixture?' current-fixture':'')+'" data-match-id="'+final.id+'" data-round="'+(rounds.length-1)+'" data-match-index="0" data-side="final">'+tournamentMatchMarkup(final)+(finalUserFixture?'<button class="ffj-play-tournament-match" type="button" data-play-tournament-match="'+final.id+'">Play final →</button>':'')+'</div><div class="ffj-final-label">'+(tournamentState.champion?('Champion · '+tournamentState.champion.flag+' '+tournamentState.champion.name):'Champion')+'</div></div>';
    grid.appendChild(finalCol);

    requestAnimationFrame(()=>requestAnimationFrame(drawTournamentLines));
  }
  function drawTournamentLines(){
    const bracket=q('#ffjBracket'),svg=q('#ffjBracketLines');if(!bracket||!svg||!tournamentState)return;
    const br=bracket.getBoundingClientRect();
    svg.innerHTML='';
    svg.setAttribute('viewBox','0 0 '+Math.max(1,br.width-40)+' '+Math.max(1,br.height-40));
    const cards=[...bracket.querySelectorAll('.ffj-bracket-match')];
    const byId=new Map(cards.map(el=>[el.dataset.matchId,el]));
    const sideRounds=tournamentState.rounds.length-1;
    const makePath=(source,dest,side)=>{
      if(!source||!dest)return;
      const s=source.getBoundingClientRect(),d=dest.getBoundingClientRect();
      const base=svg.getBoundingClientRect();
      const sx=side==='right'?s.left-base.left:s.right-base.left;
      const sy=s.top-base.top+s.height/2;
      const dx=side==='right'?d.right-base.left:d.left-base.left;
      const dy=d.top-base.top+d.height/2;
      const mid=(sx+dx)/2;
      const path=document.createElementNS('http://www.w3.org/2000/svg','path');
      path.setAttribute('d','M '+sx+' '+sy+' H '+mid+' V '+dy+' H '+dx);
      svg.appendChild(path);
    };
    for(let r=0;r<sideRounds-1;r++){
      ['left','right'].forEach(side=>{
        const sourceEntries=sideRoundMatchIndexes(r,side);
        const destEntries=sideRoundMatchIndexes(r+1,side);
        sourceEntries.forEach(({m},i)=>{
          const dest=destEntries[Math.floor(i/2)]?.m;
          if(dest)makePath(byId.get(m.id),byId.get(dest.id),side);
        });
      });
    }
    if(sideRounds>0){
      const lastSideRound=sideRounds-1;
      const final=tournamentState.rounds[tournamentState.rounds.length-1].matches[0];
      ['left','right'].forEach(side=>{
        const source=sideRoundMatchIndexes(lastSideRound,side)[0]?.m;
        if(source)makePath(byId.get(source.id),byId.get(final.id),side);
      });
    }
  }
  function showTournamentPanel(panel){
    const map={
      bracket:['ffjTournamentBracketPanel','ffjTournamentBracketBtn'],
      scorers:['ffjTournamentScorersPanel','ffjTournamentScorersBtn'],
      assists:['ffjTournamentAssistsPanel','ffjTournamentAssistsBtn']
    };
    Object.values(map).forEach(([panelId,btnId])=>{
      q('#'+panelId)?.classList.toggle('active',panelId===map[panel][0]);
      q('#'+btnId)?.classList.toggle('active',btnId===map[panel][1]);
    });
    if(panel==='bracket')requestAnimationFrame(()=>requestAnimationFrame(drawTournamentLines));
  }

  q('#ffjTournamentBtn')?.addEventListener('click',openTournamentSetup);
  q('#ffjTournamentBackBtn')?.addEventListener('click',()=>{
    hideTournamentScreens();
    q('#ffjModeBackdrop')?.classList.remove('hidden');
  });
  document.querySelectorAll('[data-tournament-size]').forEach(btn=>btn.addEventListener('click',()=>{
    selectedTournamentSize=Number(btn.dataset.tournamentSize)||16;
    document.querySelectorAll('[data-tournament-size]').forEach(x=>{
      const selected=x===btn;
      x.classList.toggle('selected',selected);
      x.setAttribute('aria-pressed',selected?'true':'false');
    });
  }));
  q('#ffjGenerateTournamentBtn')?.addEventListener('click',createTournament);
  q('#ffjBracketGrid')?.addEventListener('click',(e)=>{
    const btn=e.target.closest('[data-play-tournament-match]');
    if(!btn)return;
    const matchId=btn.dataset.playTournamentMatch;
    const round=tournamentState?.rounds?.[tournamentState.currentRound];
    const match=round?.matches?.find(m=>m.id===matchId);
    if(match)startTournamentFixture(match);
  });
  q('#ffjTournamentBracketBtn')?.addEventListener('click',()=>showTournamentPanel('bracket'));
  q('#ffjTournamentScorersBtn')?.addEventListener('click',()=>showTournamentPanel('scorers'));
  q('#ffjTournamentAssistsBtn')?.addEventListener('click',()=>showTournamentPanel('assists'));
  q('#ffjTournamentNewDrawBtn')?.addEventListener('click',()=>{closeAllMenus?.();openTournamentSetup();});
  window.addEventListener('resize',()=>{if(!q('#ffjTournamentHub')?.classList.contains('hidden'))drawTournamentLines();});

  const existingTournament=loadTournament();
  if(existingTournament)tournamentState=existingTournament;

  // Always begin on Log In after a fresh open or browser refresh.
  // Remembered details may be prefilled, but navigation never skips authentication.
  const rememberedLogin=loadRememberedLogin();
  const storedProfile=loadPlayerProfile();
  if(storedProfile) savePlayerProfile(storedProfile);
  if(rememberedLogin){
    if(q('#ffjLoginEmail')) q('#ffjLoginEmail').value=rememberedLogin.email;
    if(q('#ffjRememberMe')) q('#ffjRememberMe').checked=true;
  }
  showAuthPane('ffjLoginPane');
  showJourneyView('ffjAuthView');

  const modeBackdrop=q('#ffjModeBackdrop');
  const modeMenuBtn=q('#ffjModeMenuBtn');
  const modeMenuPanel=q('#ffjModeMenuPanel');
  const landingMenuBtn=q('#ffjLandingMenuBtn');
  const landingMenuPanel=q('#ffjLandingMenuPanel');
  const menuBtn=q('#ffMenuBtn');
  const menuPanel=q('#ffMenuPanel');
  const tournamentSetupMenuBtn=q('#ffjTournamentSetupMenuBtn');
  const tournamentSetupMenu=q('#ffjTournamentSetupMenu');
  const tournamentMenuBtn=q('#ffjTournamentMenuBtn');
  const tournamentMenu=q('#ffjTournamentMenu');

  function closeModeMenu(){
    modeMenuPanel?.classList.add('hidden');
    modeMenuPanel?.setAttribute('aria-hidden','true');
    modeMenuBtn?.setAttribute('aria-expanded','false');
  }
  function closeLandingMenu(){
    landingMenuPanel?.classList.add('hidden');
    landingMenuPanel?.setAttribute('aria-hidden','true');
    landingMenuBtn?.setAttribute('aria-expanded','false');
  }
  function closeMatchMenu(){
    menuPanel?.classList.add('hidden');
    menuPanel?.setAttribute('aria-hidden','true');
    menuBtn?.setAttribute('aria-expanded','false');
  }
  function closeTournamentSetupMenu(){
    tournamentSetupMenu?.classList.add('hidden');
    tournamentSetupMenu?.setAttribute('aria-hidden','true');
    tournamentSetupMenuBtn?.setAttribute('aria-expanded','false');
  }
  function closeTournamentMenu(){
    tournamentMenu?.classList.add('hidden');
    tournamentMenu?.setAttribute('aria-hidden','true');
    tournamentMenuBtn?.setAttribute('aria-expanded','false');
  }
  function closeAllMenus(){
    closeModeMenu();
    closeLandingMenu();
    closeMatchMenu();
    closeTournamentSetupMenu();
    closeTournamentMenu();
  }
  function openModeSelect(){
    closeAllMenus();
    shell?.classList.remove('hidden');
    document.body.classList.add('ffj-pre-game');
    modeBackdrop?.classList.remove('hidden');
  }
  function closeModeSelect(){
    closeModeMenu();
    modeBackdrop?.classList.add('hidden');
  }
  function goHome(){
    window.FOOTBALL_FORTUNE_AUTOSAVE_NOW?.();
    closeAllMenus();
    hideTournamentScreens();
    modeBackdrop?.classList.add('hidden');
    shell?.classList.remove('hidden');
    document.body.classList.add('ffj-pre-game');
    showLanding();
  }
  function logoutToLogin(){
    window.FOOTBALL_FORTUNE_AUTOSAVE_NOW?.();
    closeAllMenus();
    hideTournamentScreens();
    modeBackdrop?.classList.add('hidden');
    shell?.classList.remove('hidden');
    document.body.classList.add('ffj-pre-game');

    // Log out of the active session, but leave the saved profile itself intact.
    clearRememberedLogin();
    managerName='Player';

    if(q('#ffjLoginPassword')) q('#ffjLoginPassword').value='';
    if(q('#ffjLoginMessage')) q('#ffjLoginMessage').textContent='';
    if(q('#ffjRememberMe')) q('#ffjRememberMe').checked=false;

    showAuthPane('ffjLoginPane');
    showJourneyView('ffjAuthView');
  }

  q('#ffjNewGameBtn')?.addEventListener('click',openModeSelect);
  q('#ffjModeClose')?.addEventListener('click',closeModeSelect);
  q('#ffjFriendlyBtn')?.addEventListener('click',startFriendly);
  q('#ffjContinueBtn')?.addEventListener('click',()=>{
    const save=window.FOOTBALL_FORTUNE_GET_RECENT_SAVE?.();if(!save)return;
    enterFriendlyMatch();
    requestAnimationFrame(()=>requestAnimationFrame(()=>window.FOOTBALL_FORTUNE_LOAD_SAVE?.(save.id)));
  });
  q('#ffjLoadBtn')?.addEventListener('click',openLoadGames);
  q('#ffjLoadCloseBtn')?.addEventListener('click',closeLoadGames);
  q('#ffjLoadBackdrop')?.addEventListener('click',(e)=>{if(e.target===q('#ffjLoadBackdrop'))closeLoadGames();});
  q('#ffjSaveList')?.addEventListener('click',(e)=>{
    const load=e.target.closest('[data-load-save]');
    if(load){const id=load.dataset.loadSave;closeLoadGames();enterFriendlyMatch();requestAnimationFrame(()=>requestAnimationFrame(()=>window.FOOTBALL_FORTUNE_LOAD_SAVE?.(id)));return;}
    const del=e.target.closest('[data-delete-save]');
    if(del){window.FOOTBALL_FORTUNE_DELETE_SAVE?.(del.dataset.deleteSave);renderSaveList();refreshSaveLanding();}
  });
  window.addEventListener('football-fortune-save-changed',refreshSaveLanding);

  // Welcome landing shell controls.
  q('#ffjLandingHomeBtn')?.addEventListener('click',(e)=>{
    e.preventDefault();
    e.stopPropagation();
    goHome();
  });
  landingMenuBtn?.addEventListener('click',(e)=>{
    e.preventDefault();
    e.stopPropagation();
    const opening=landingMenuPanel?.classList.contains('hidden');
    closeModeMenu();
    closeLandingMenu();
    closeMatchMenu();
    if(opening){
      landingMenuPanel?.classList.remove('hidden');
      landingMenuPanel?.setAttribute('aria-hidden','false');
      landingMenuBtn.setAttribute('aria-expanded','true');
    }else{
      closeLandingMenu();
    }
  });
  q('#ffjLandingLogoutBtn')?.addEventListener('click',(e)=>{
    e.preventDefault();
    e.stopPropagation();
    logoutToLogin();
  });

  // Tournament shell controls.
  q('#ffjTournamentSetupHomeBtn')?.addEventListener('click',goHome);
  q('#ffjTournamentHomeBtn')?.addEventListener('click',goHome);
  q('#ffjTournamentSetupLogoutBtn')?.addEventListener('click',logoutToLogin);
  q('#ffjTournamentLogoutBtn')?.addEventListener('click',logoutToLogin);

  tournamentSetupMenuBtn?.addEventListener('click',(e)=>{
    e.preventDefault();e.stopPropagation();
    const opening=tournamentSetupMenu?.classList.contains('hidden');
    closeAllMenus();
    if(opening){
      tournamentSetupMenu?.classList.remove('hidden');
      tournamentSetupMenu?.setAttribute('aria-hidden','false');
      tournamentSetupMenuBtn.setAttribute('aria-expanded','true');
    }
  });
  tournamentMenuBtn?.addEventListener('click',(e)=>{
    e.preventDefault();e.stopPropagation();
    const opening=tournamentMenu?.classList.contains('hidden');
    closeAllMenus();
    if(opening){
      tournamentMenu?.classList.remove('hidden');
      tournamentMenu?.setAttribute('aria-hidden','false');
      tournamentMenuBtn.setAttribute('aria-expanded','true');
    }
  });

  // Mode-screen shell controls.
  q('#ffjModeHomeBtn')?.addEventListener('click',(e)=>{
    e.preventDefault();
    e.stopPropagation();
    goHome();
  });
  q('#ffjModeBackBtn')?.addEventListener('click',(e)=>{
    e.preventDefault();
    e.stopPropagation();
    goHome();
  });
  modeMenuBtn?.addEventListener('click',(e)=>{
    e.preventDefault();
    e.stopPropagation();
    const opening=modeMenuPanel?.classList.contains('hidden');
    closeMatchMenu();
    if(opening){
      modeMenuPanel?.classList.remove('hidden');
      modeMenuPanel?.setAttribute('aria-hidden','false');
      modeMenuBtn.setAttribute('aria-expanded','true');
    }else{
      closeModeMenu();
    }
  });
  q('#ffjModeLogoutBtn')?.addEventListener('click',(e)=>{
    e.preventDefault();
    e.stopPropagation();
    logoutToLogin();
  });

  q('#ffSaveGameBtn')?.addEventListener('click',(e)=>{
    e.preventDefault();e.stopPropagation();closeMatchMenu();window.FOOTBALL_FORTUNE_SAVE_GAME?.();
  });

  // Live-match shell controls.
  menuBtn?.addEventListener('click',(e)=>{
    e.preventDefault();
    e.stopPropagation();
    const opening=menuPanel?.classList.contains('hidden');
    closeModeMenu();
    closeLandingMenu();
    if(opening){
      menuPanel?.classList.remove('hidden');
      menuPanel?.setAttribute('aria-hidden','false');
      menuBtn.setAttribute('aria-expanded','true');
    }else{
      closeMatchMenu();
    }
  });
  q('#ffLogoutBtn')?.addEventListener('click',(e)=>{
    e.preventDefault();
    e.stopPropagation();
    logoutToLogin();
  });
  q('.app .ff-home-btn')?.addEventListener('click',(e)=>{
    e.preventDefault();
    e.stopPropagation();
    goHome();
  });

  document.addEventListener('click',(e)=>{
    if(!e.target.closest('#ffjLandingMenuPanel') && !e.target.closest('#ffjLandingMenuBtn')) closeLandingMenu();
    if(!e.target.closest('#ffjModeMenuPanel') && !e.target.closest('#ffjModeMenuBtn')) closeModeMenu();
    if(!e.target.closest('#ffMenuPanel') && !e.target.closest('#ffMenuBtn')) closeMatchMenu();
    if(!e.target.closest('#ffjTournamentSetupMenu') && !e.target.closest('#ffjTournamentSetupMenuBtn')) closeTournamentSetupMenu();
    if(!e.target.closest('#ffjTournamentMenu') && !e.target.closest('#ffjTournamentMenuBtn')) closeTournamentMenu();
  });
})();
</script>

</body>
</html>