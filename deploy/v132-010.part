.ff-dice-restore{position:absolute;left:50%;bottom:18px;transform:translateX(-50%);z-index:51;border:1px solid rgba(255,255,255,.18);background:rgba(7,21,13,.94);color:#fff;border-radius:999px;padding:11px 16px;font-weight:900;box-shadow:0 12px 28px rgba(0,0,0,.34);cursor:pointer;display:flex;align-items:center;gap:8px}
.ff-dice-restore.hidden{display:none}

/* v95 — persistent standard roll panel beneath the live report */
@media (min-width:800px){
  .sidebar{
    flex-direction:column !important;
    gap:12px !important;
    overflow:hidden !important;
  }
  .live-report-card{
    flex:1 1 auto !important;
    height:auto !important;
    min-height:0 !important;
  }
  .live-report-feed{min-height:0 !important;}
}
.ff-standard-dice-card{
  flex:0 0 268px;
  min-height:268px;
  width:100%;
  border-radius:24px;
  border:2px solid #aebdca;
  background:linear-gradient(180deg,#f8fafc 0%,#eef4f8 100%);
  box-shadow:0 10px 24px rgba(16,40,62,.12);
  padding:14px 16px 16px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:flex-start;
  overflow:hidden;transition:opacity .18s ease,filter .18s ease,border-color .18s ease,box-shadow .18s ease;
}
.ff-standard-dice-card.team-blue{border-width:4px;border-color:#2f7df6;box-shadow:0 10px 24px rgba(16,40,62,.12),0 0 0 3px rgba(47,125,246,.14) inset}
.ff-standard-dice-card.team-red{border-width:4px;border-color:#db4b4b;box-shadow:0 10px 24px rgba(16,40,62,.12),0 0 0 3px rgba(219,75,75,.14) inset}
.ff-standard-dice-card.disabled{opacity:.42;filter:grayscale(1);}
.ff-standard-dice-kicker{font-size:11px;line-height:1;text-transform:uppercase;letter-spacing:1.3px;color:#68829a;font-weight:950;margin-top:1px}
.ff-standard-dice-title{display:none}
.ff-sidebar-dice-click{
  margin-top:4px;
  width:100%;
  flex:1 1 auto;
  min-height:0;
  border:0;
  background:transparent;
  padding:8px 0 34px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:12px;
  cursor:pointer;
  perspective:700px;
  position:relative;
}
.ff-sidebar-dice-click .ff-game-die{margin:auto 0;}
.ff-sidebar-dice-click:disabled{cursor:not-allowed}
.ff-sidebar-dice-click:not(:disabled):hover .ff-game-die:not(.rolling){filter:none}
.ff-sidebar-dice-click .ff-game-die.rolling{animation:ffSidebarSpinDice 1s cubic-bezier(.2,.7,.2,1)}
@keyframes ffSidebarSpinDice{0%{transform:rotateX(0) rotateY(0) rotateZ(0) scale(1)}35%{transform:rotateX(310deg) rotateY(185deg) rotateZ(95deg) scale(1.13)}70%{transform:rotateX(640deg) rotateY(490deg) rotateZ(215deg) scale(.98)}100%{transform:rotateX(900deg) rotateY(720deg) rotateZ(360deg) scale(1)}}
.ff-sidebar-dice-hint{position:absolute;left:0;right:0;bottom:8px;font-size:13px;font-weight:950;color:#2f8fe8;letter-spacing:.2px;text-align:center}
.ff-sidebar-dice-click:disabled .ff-sidebar-dice-hint{color:#6e7f8d}
@media (max-width:799px){
  .ff-standard-dice-card{flex:0 0 auto;min-height:250px;margin-top:12px}
}
.ff-destination-pulse{position:absolute;width:64px;height:64px;border-radius:50%;transform:translate(-50%,-50%);z-index:29;pointer-events:none;animation:ffDestPulse 1.3s ease-out forwards}.ff-destination-pulse.red{box-shadow:0 0 0 4px #fff,0 0 0 9px rgba(227,23,23,.95)}.ff-destination-pulse.yellow{box-shadow:0 0 0 4px #fff,0 0 0 9px rgba(255,213,31,.98)}.ff-destination-pulse.blue{box-shadow:0 0 0 4px #fff,0 0 0 9px rgba(47,143,232,.98)}@keyframes ffDestPulse{0%{opacity:0;transform:translate(-50%,-50%) scale(.7)}25%{opacity:1;transform:translate(-50%,-50%) scale(1.12)}70%{opacity:1;transform:translate(-50%,-50%) scale(.96)}100%{opacity:0;transform:translate(-50%,-50%) scale(1.2)}}
/* v88 — v58 scorer details + fixed-height scoreboard reserve.
   The scorer area exists from kick-off, so goals never push the pitch/report down. */
.score-team-block{
  min-width:0;
  align-self:stretch;
  display:flex;
  flex-direction:column;
  justify-content:flex-start;
}
.scorer-list{
  margin-top:7px;
  padding-left:54px;
  height:42px;
  min-height:42px;
  max-height:42px;
  overflow-y:auto;
  overflow-x:hidden;
  display:flex;
  flex-direction:column;
  gap:2px;
  scrollbar-width:thin;
}
.away-scorers{
  padding-left:0;
  padding-right:54px;
  align-items:flex-end;
  text-align:right;
}
.scorer-entry{
  color:#27445f;
  font-size:11px;
  line-height:1.15;
  font-weight:850;
  white-space:nowrap;
}
.scorer-entry .minute{
  color:#6d8294;
  font-weight:950;
  margin-left:4px;
}
@media (min-width:781px){
  .scoreboard{
    height:112px;
    min-height:112px;
    max-height:112px;
    padding:10px 20px;
    align-items:start;
    overflow:hidden;
  }
  .score-centre{align-self:start;}
}
@media (max-width:780px){
  .scorer-list{height:auto;min-height:0;max-height:42px;padding-left:0;}
  .away-scorers{padding-right:0;}
}


/* v91 — compact horizontal scoreboard.
   Scorers sit beside the central score rather than below team names,
   keeping the overall match header short and the viewport stable. */
@media (min-width:781px){
  .scoreboard.compact-scoreboard{
    height:78px;
    min-height:78px;
    max-height:78px;
    padding:8px 20px;
    grid-template-columns:minmax(180px,1fr) minmax(120px,220px) auto minmax(120px,220px) minmax(180px,1fr);
    gap:14px;
    align-items:center;
    overflow:hidden;
  }
  .compact-scoreboard .score-team-block{
    align-self:center;
    min-width:0;
  }
  .compact-scoreboard .score-centre{
    align-self:center;
    min-width:116px;
  }
  .compact-scoreboard .score{
    font-size:36px;
  }
  .compact-scoreboard .half-time-score{
    margin-top:3px;
    font-size:11px;
    line-height:1;
  }
  .compact-scoreboard .match-minute{
    margin-top:3px;
    font-size:13px;
    line-height:1;
  }
  .compact-scoreboard .scorer-list{
    margin:0;
    padding:0;
    height:52px;
    min-height:52px;
    max-height:52px;
    overflow-y:auto;
    overflow-x:hidden;
    justify-content:center;
    gap:2px;
  }
  .compact-scoreboard .home-scorers-inline{
    align-items:flex-end;
    text-align:right;
  }
  .compact-scoreboard .away-scorers-inline{
    align-items:flex-start;
    text-align:left;
  }
  .compact-scoreboard .scorer-entry{
    font-size:11px;
    line-height:1.1;
  }
  .compact-scoreboard .scorer-list.ff-penalty-marks{
    flex-direction:row;
    align-items:center;
    gap:6px;
    overflow:visible;
  }
  .compact-scoreboard .home-scorers-inline.ff-penalty-marks{justify-content:flex-end}
  .compact-scoreboard .away-scorers-inline.ff-penalty-marks{justify-content:flex-start}
  .ff-pen-progress-dot{
    width:22px;
    height:22px;
    flex:0 0 22px;
    border-radius:50%;
    display:grid;
    place-items:center;
    box-sizing:border-box;
    border:2px solid #c7d3dd;
    background:#fff;
    color:#8798a6;
    font-size:13px;
    line-height:1;
    font-weight:1000;
  }
  .ff-pen-progress-dot.goal{
    background:#168447;
    border-color:#168447;
    color:#fff;
  }
  .ff-pen-progress-dot.miss{
    background:#d34848;
    border-color:#d34848;
    color:#fff;
  }
  .ff-pen-progress-dot.extra{
    box-shadow:0 0 0 2px #eef3f7;
  }
  .compact-scoreboard.ff-shootout-scoreboard .half-time-score{
    color:#0b3558;
    font-weight:1000;
  }
  .compact-scoreboard.ff-shootout-scoreboard .match-minute{
    color:#62798c;
    font-size:11px;
    letter-spacing:.3px;
    text-transform:uppercase;
  }
}
@media (max-width:780px){
  .scoreboard.compact-scoreboard{
    grid-template-columns:1fr;
  }
  .compact-scoreboard .home-scorers-inline,
  .compact-scoreboard .away-scorers-inline{
    align-items:center;
    text-align:center;
  }
}


/* v95 — restored v58-style end-of-match summary */
.ff-summary-backdrop{
  position:fixed!important;inset:0!important;z-index:10000;display:grid;place-items:center;padding:28px;
  background:rgba(8,20,31,.68);backdrop-filter:blur(10px);
}
.ff-summary-backdrop.hidden{display:none}
body.ff-summary-open .play-layout{
  isolation:isolate;
}
.ff-summary-card{
  position:relative;width:min(620px,100%);max-height:calc(100vh - 48px);overflow-y:auto;
  padding:30px;border-radius:26px;background:#fff;color:#142018;border:1px solid rgba(0,0,0,.08);
  box-shadow:0 28px 80px rgba(0,0,0,.42);text-align:left;
}
.ff-summary-close-x{
  position:absolute;top:14px;right:14px;width:42px;height:42px;border-radius:50%;
  border:1px solid rgba(0,0,0,.10);background:#f3f6f3;color:#142018;font-size:28px;line-height:1;cursor:pointer;
}
.ff-summary-eyebrow{color:#607067;font-size:11px;font-weight:950;letter-spacing:1.5px}
.ff-summary-card h2{margin:7px 0 0;font-size:30px;line-height:1.08;color:#142018}
.ff-summary-score{margin-top:8px;font-size:38px;font-weight:950;letter-spacing:-1px;color:#142018}
.ff-summary-copy{margin-top:18px;display:flex;flex-direction:column;gap:12px;font-size:16px;line-height:1.5;color:#314039}
.ff-summary-copy p{margin:0}.ff-summary-copy strong{color:#0d6d35}
.ff-summary-close-btn{width:100%;min-height:50px;margin-top:22px;border:0;border-radius:14px;background:#7CB7FF;color:#142000;font-weight:950;cursor:pointer;box-shadow:inset 0 -6px 0 rgba(87,112,0,.22)}

/* v95 — penalty shootout, using the same persistent bottom-right dice */
.ff-shootout-backdrop{position:fixed;inset:0;z-index:10000;display:grid;place-items:center;padding:24px;background:rgba(1,10,5,.70);backdrop-filter:blur(7px)}
.ff-shootout-backdrop.hidden{display:none}
.ff-shootout-card{width:min(560px,100%);padding:26px;border-radius:26px;background:#fff;color:#142018;border:1px solid rgba(0,0,0,.08);box-shadow:0 28px 80px rgba(0,0,0,.42);text-align:center}
.ff-shootout-eyebrow{font-size:11px;font-weight:950;letter-spacing:1.5px;color:#607067}
.ff-shootout-card h2{margin:7px 0 8px;font-size:28px;line-height:1.08}
.ff-shootout-intro{margin:0 auto 18px;max-width:470px;color:#4b5b53;line-height:1.45}
.ff-shootout-score{display:grid;grid-template-columns:1fr auto 1fr;gap:14px;align-items:center;padding:14px;border-radius:18px;background:#f4f7f5;border:1px solid #d9e1dc}
.ff-shootout-team{font-weight:950}.ff-shootout-total{font-size:34px;line-height:1;margin:5px 0 8px}.ff-shootout-vs{font-size:12px;font-weight:1000;letter-spacing:1px;color:#738178}
.ff-shootout-marks{display:flex;justify-content:center;gap:6px;min-height:12px;flex-wrap:wrap}.ff-pen-mark{width:10px;height:10px;border-radius:50%;display:block;background:#cbd4cf}.ff-pen-mark.goal{background:#168447}.ff-pen-mark.miss{background:#d34848}
.ff-shootout-turn{margin-top:18px;font-size:18px;font-weight:1000;color:#173a5e}.ff-shootout-kicker{margin-top:4px;font-size:15px;font-weight:850;color:#52645a}
.ff-shootout-question{margin-top:18px;font-size:14px;font-weight:950;color:#26372f}.ff-shootout-choice-row{display:flex;gap:12px;margin-top:10px}.ff-shootout-choice,.ff-shootout-next,.ff-shootout-summary-btn{flex:1;min-height:48px;border:0;border-radius:14px;font:inherit;font-weight:1000;cursor:pointer}.ff-shootout-choice{background:#e8f1fb;color:#173a5e;border:1px solid #b9cde0}.ff-shootout-choice.selected{background:#173a5e;color:#fff;border-color:#173a5e}.ff-shootout-next,.ff-shootout-summary-btn{width:100%;margin-top:16px;background:#7CB7FF;color:#142000;box-shadow:inset 0 -5px 0 rgba(87,112,0,.20)}
.ff-shootout-result{margin-top:16px;padding:14px;border-radius:16px;background:#f6f8f6;border:1px solid #dce3df}.ff-shootout-result.hidden,.ff-shootout-choices.hidden,.ff-shootout-winner.hidden{display:none}.ff-shootout-result-title{font-size:22px;font-weight:1000}.ff-shootout-result-copy{margin-top:4px;color:#52645a;line-height:1.4}.ff-shootout-winner{margin-top:18px;padding:18px;border-radius:18px;background:#f1f8f3;border:1px solid #cce5d4}.ff-shootout-winner-title{font-size:24px;font-weight:1000;color:#0d6d35}.ff-shootout-winner-copy{margin-top:6px;color:#44564c;line-height:1.4}


/* v100 — align scoreboard to pitch width and extend the COMPLETE live report to the top while preserving dice position */
@media (min-width:800px){
  .play-layout{
    overflow:visible !important;
  }

  .scoreboard.compact-scoreboard{
    width:calc(100% - 334px) !important;
    max-width:calc(100% - 334px) !important;
    margin-right:334px !important;
    box-sizing:border-box;
  }

  .sidebar{
    margin-top:-92px !important;
    height:calc(100% + 92px) !important;
  }
}

/* v101 — integrated penalty shootout experience. Top bar, live report and standard dice remain unchanged. */
.board-shell{position:relative}
.ff-integrated-penalty{position:absolute;inset:0;z-index:60;border-radius:24px;overflow:hidden;background:#dfe8f1 url('data:image/jpeg;base64,') center/cover no-repeat;box-shadow:0 12px 28px rgba(17,52,78,.14);border:1px solid #9ab1c0}
.ff-integrated-penalty.hidden{display:none}
.ff-pen-header{position:absolute;z-index:64;left:50%;top:18px;transform:translateX(-50%);min-width:390px;max-width:76%;display:flex;align-items:center;gap:14px;padding:12px 18px;background:rgba(250,253,255,.95);border:1px solid rgba(190,210,224,.9);border-radius:22px;box-shadow:0 10px 24px rgba(0,0,0,.18)}
.ff-pen-header-badge{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:950;font-size:20px;background:#3180ef;flex:0 0 48px}
.ff-pen-header-badge.red{background:#f54f54}
.ff-pen-header-title{font-size:24px;font-weight:950;color:#0a2f55}
.ff-pen-header-sub{font-size:14px;color:#607286;margin-top:2px}
.ff-pen-meta{margin-left:auto;font-size:12px;font-weight:950;color:#607286;white-space:nowrap}
.ff-pen-directions{position:absolute;z-index:68;inset:0;pointer-events:none}
.ff-pen-dir{appearance:none;-webkit-appearance:none;position:absolute;margin:0;padding:0;display:grid;place-items:center;pointer-events:auto;border:1px solid rgba(255,255,255,.5);border-radius:28px;cursor:pointer;transition:transform .16s ease,box-shadow .16s ease,filter .16s ease,border-color .16s ease;box-sizing:border-box;color:#fff;box-shadow:0 8px 18px rgba(5,31,54,.20),inset 0 1px 0 rgba(255,255,255,.32)}
.ff-pen-dir[data-dir=left]{left:18.6%;top:58%;width:18.2%;height:14.4%;background:linear-gradient(180deg,#2f78bd,#245f95)}
.ff-pen-dir[data-dir=centre]{left:39.4%;top:58%;width:19.3%;height:14.4%;background:linear-gradient(180deg,#c6a24f,#9f8137)}
.ff-pen-dir[data-dir=right]{left:62%;top:58%;width:18.5%;height:14.4%;background:linear-gradient(180deg,#bd5559,#964247)}
.ff-pen-dir svg{width:44%;height:58%;overflow:visible;filter:drop-shadow(0 2px 2px rgba(0,0,0,.18))}
.ff-pen-dir path{fill:none;stroke:currentColor;stroke-width:12;stroke-linecap:round;stroke-linejoin:round}.ff-pen-dir polygon{fill:currentColor}
.ff-pen-dir:hover,.ff-pen-dir:focus-visible{outline:none;transform:translateY(-4px) scale(1.025);filter:brightness(1.08);border-color:#fff;box-shadow:0 0 0 3px rgba(255,255,255,.32),0 14px 28px rgba(5,31,54,.30),inset 0 1px 0 rgba(255,255,255,.4)}
.ff-pen-dir.selected{transform:translateY(-2px) scale(1.015);border-color:#fff;box-shadow:0 0 0 4px rgba(255,255,255,.22),0 14px 28px rgba(7,29,48,.26)}
.ff-pen-dir:disabled{cursor:default;filter:saturate(.72);opacity:.82;transform:none}
.ff-pen-ball{position:absolute;z-index:66;width:56px;height:56px;background:url('data:image/png;base64,') center/contain no-repeat;filter:drop-shadow(0 5px 10px rgba(0,0,0,.30));opacity:0;transform:translate(-50%,-50%) scale(.82);transition:opacity .18s ease,transform .18s ease;pointer-events:none}
.ff-pen-ball.show{opacity:1;transform:translate(-50%,-50%) scale(1)}
.ff-pen-ball[data-dir=left]{left:28%;top:30%}.ff-pen-ball[data-dir=centre]{left:50%;top:28%}.ff-pen-ball[data-dir=right]{left:72%;top:30%}
.ff-pen-status{position:absolute;z-index:70;left:50%;bottom:20px;transform:translateX(-50%);width:min(690px,68%);padding:16px 22px;border-radius:22px;background:rgba(252,254,255,.97);border:1px solid #c4d5e0;box-shadow:0 12px 28px rgba(0,0,0,.22);text-align:center}
.ff-pen-status.hidden{display:none}.ff-pen-status-title{font-size:22px;font-weight:950;color:#0a2f55}.ff-pen-status-rule{margin-top:10px;font-size:15px;font-weight:850;color:#0b3558}
.ff-pen-status.result-goal{background:rgba(235,255,243,.98);border-color:#61c58a}.ff-pen-status.result-miss{background:rgba(255,241,241,.98);border-color:#e88f8f}
.ff-pen-roll-visual{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:10px}.ff-pen-roll-label{display:inline-flex;align-items:center;justify-content:center;padding:8px 12px;border-radius:999px;background:#edf3f7;border:1px solid #d4e0e8;font-size:12px;letter-spacing:.9px;font-weight:950;color:#0b3558}
.ff-pen-roll-dice{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}.ff-pen-roll-chip{width:36px;height:36px;border-radius:10px;background:linear-gradient(#fff,#edf2f7);border:1px solid #c9d5df;box-shadow:0 3px 10px rgba(17,52,78,.10);display:grid;place-items:center;font-size:18px;font-weight:950;color:#0b3558}.ff-pen-roll-helper{margin-top:10px;font-size:12px;font-weight:800;color:#698091}
.ff-pen-winner{position:absolute;inset:0;z-index:80;display:grid;place-items:center;background:rgba(7,25,39,.54);backdrop-filter:blur(5px)}.ff-pen-winner.hidden{display:none}.ff-pen-winner-card{width:min(520px,82%);padding:26px;border-radius:24px;background:#fff;border:1px solid #c7d6e0;text-align:center;box-shadow:0 24px 70px rgba(0,0,0,.35)}.ff-pen-winner-card h2{margin:0;color:#0a2f55;font-size:28px}.ff-pen-winner-card p{color:#607286;font-weight:750;line-height:1.45}.ff-pen-summary-btn{margin-top:8px;min-height:46px;padding:0 20px;border:0;border-radius:14px;background:#0b3558;color:#fff;font-weight:950;cursor:pointer}.ff-pen-quick-sim-btn:disabled{opacity:.45;cursor:not-allowed}
@media(max-width:900px){.ff-pen-header{min-width:0;width:84%;top:12px}.ff-pen-header-title{font-size:20px}.ff-pen-status{width:78%;bottom:14px}}


.ff-shootout-transition-backdrop{position:absolute;inset:0;z-index:10000;display:grid;place-items:center;background:rgba(8,28,45,.56);backdrop-filter:blur(3px);padding:24px}.ff-shootout-transition-backdrop.hidden{display:none}.ff-shootout-transition-card{width:min(520px,92%);background:#fff;border:1px solid #ccd8e0;border-radius:26px;box-shadow:0 22px 60px rgba(8,28,45,.28);padding:28px 30px 26px;text-align:center;color:#173a5e}.ff-shootout-transition-icon{width:58px;height:58px;margin:0 auto 10px;border-radius:50%;display:grid;place-items:center;background:#edf3f7;font-size:30px}.ff-shootout-transition-eyebrow{font-size:12px;letter-spacing:1.4px;font-weight:1000;color:#718498}.ff-shootout-transition-card h2{margin:7px 0 6px;font-size:27px;line-height:1.15}.ff-shootout-transition-score{font-size:42px;font-weight:1000;line-height:1;margin:8px 0 12px;color:#0b3558}.ff-shootout-transition-card p{margin:0 auto 20px;max-width:390px;font-size:15px;line-height:1.45;color:#566b7d}.ff-shootout-transition-btn{border:0;border-radius:14px;padding:13px 20px;background:#0b3558;color:#fff;font-size:13px;font-weight:1000;letter-spacing:.4px;cursor:pointer}.ff-shootout-transition-btn:hover{filter:brightness(1.06)}

/* v107 — clear final-result cards + newspaper match report */
.ff-result-backdrop{position:fixed!important;inset:0!important;z-index:10000;display:grid;place-items:center;padding:24px;background:rgba(1,10,5,.72);backdrop-filter:blur(8px)}
@media(min-width:1100px){.ff-result-backdrop{padding-left:24px;padding-right:360px}}
@media(max-width:1099px){.ff-result-backdrop{padding:24px}}
.ff-result-backdrop.hidden{display:none}
.ff-result-card{width:min(560px,100%);padding:30px 30px 26px;border-radius:28px;background:linear-gradient(180deg,#ffffff 0%,#f5f8fa 100%);color:#102f4b;border:1px solid rgba(11,53,88,.14);box-shadow:0 30px 85px rgba(0,0,0,.42);text-align:center}
.ff-result-trophy{width:68px;height:68px;margin:0 auto 12px;border-radius:50%;display:grid;place-items:center;background:#eef4f8;border:1px solid #cfdae3;font-size:34px}
.ff-result-eyebrow{font-size:11px;font-weight:1000;letter-spacing:1.7px;color:#718393}
.ff-result-card h2{margin:7px 0 4px;font-size:32px;line-height:1.08;color:#0b3558}
.ff-result-score{font-size:52px;line-height:1;font-weight:1000;letter-spacing:.5px;color:#102f4b;margin:14px 0 16px}
.ff-result-copy{max-width:430px;margin:0 auto;color:#556d7e;font-size:15px;line-height:1.5}
.ff-result-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:24px}
.ff-result-summary-btn,.ff-result-close-btn{min-height:50px;border-radius:14px;font:inherit;font-size:13px;font-weight:1000;cursor:pointer}
.ff-result-summary-btn{border:0;background:#0b3558;color:#fff;box-shadow:inset 0 -4px 0 rgba(0,0,0,.18)}
.ff-result-close-btn{border:1px solid #c8d5df;background:#fff;color:#0b3558}
.ff-result-summary-btn:hover,.ff-result-close-btn:hover{filter:brightness(1.04)}


.ff-summary-card.ff-newspaper{
  width:min(900px,100%);
  max-height:calc(100vh - 40px);
  overflow:hidden;
  padding:0;
  border-radius:26px;
  background:#ffffff;
  color:#102f4b;
  border:1px solid #d9e3ea;
  box-shadow:0 34px 100px rgba(0,0,0,.36);
  text-align:left;
}
.ff-newspaper-masthead{
  padding:20px 34px 8px;
  text-align:left;
  font-family:Inter,Arial,sans-serif;
  font-size:12px;
  font-weight:1000;
  letter-spacing:1.5px;
  text-transform:uppercase;
  color:#658095;
}
.ff-newspaper-rule{
  height:1px;
  margin:0 34px;
  background:#e3ebf1;
  border:0;
}
.ff-newspaper .ff-summary-eyebrow{
  margin:20px 34px 0;
  text-align:left;
  color:#3d6d94;
  font-family:Inter,Arial,sans-serif;
  font-size:12px;
  font-weight:950;
  letter-spacing:1.2px;
  text-transform:uppercase;
}
.ff-summary-card.ff-newspaper h2{
  margin:6px 34px 0;
  max-width:760px;
  text-align:left;
  font-family:Inter,Arial,sans-serif;
  font-size:42px;
  line-height:1.04;
  font-weight:1000;
  color:#0b3558;
  letter-spacing:-1px;
}
.ff-newspaper-scoreline{
  display:none;
}
.ff-newspaper-byline{
  margin:10px 34px 0;
  font-family:Inter,Arial,sans-serif;
  font-size:11px;
  font-weight:850;
  letter-spacing:.7px;
  color:#7a8c9a;
  text-transform:uppercase;
}
.ff-summary-copy.ff-newspaper-copy{
  display:block;
  margin:18px 34px 0;
  padding-top:16px;
  border-top:1px solid #e5edf2;
  font-family:Inter,Arial,sans-serif;
  font-size:15px;
  line-height:1.52;
  color:#30495c;
  max-width:720px;
}
.ff-summary-copy.ff-newspaper-copy p{
  margin:0 0 15px;
}
.ff-summary-copy.ff-newspaper-copy p:last-child{
  margin-bottom:0;
  padding-top:12px;
  border-top:1px solid #e5edf2;
}
.ff-potm-label{font-weight:900;color:#0b3558}

.ff-summary-copy.ff-newspaper-copy p:first-child{
  font-size:inherit;
  line-height:inherit;
  color:inherit;
  font-weight:inherit;
}
.ff-summary-copy.ff-newspaper-copy p:first-child::first-letter{
  float:none;
  font-size:inherit;
  line-height:inherit;
  padding:0;
  font-weight:inherit;
  color:inherit;
}
.ff-summary-copy.ff-newspaper-copy strong{
  color:inherit;
  font-weight:inherit;
}
.ff-newspaper .ff-summary-close-btn{
  display:block;
  width:calc(100% - 68px);
  min-height:50px;
  margin:18px 34px 22px;
  border:0;
  border-radius:14px;
  background:#0b3558;
  color:#fff;
  font-family:Inter,Arial,sans-serif;
  font-weight:950;
  letter-spacing:.3px;
  box-shadow:none;
}
.ff-newspaper .ff-summary-close-btn:hover{filter:brightness(1.05)}
.ff-summary-card.ff-newspaper.ff-summary-compact .ff-summary-copy.ff-newspaper-copy{
  font-size:13px;
  line-height:1.43;
}
.ff-summary-card.ff-newspaper.ff-summary-compact .ff-summary-copy.ff-newspaper-copy p{
  margin-bottom:8px;
}
.ff-summary-card.ff-newspaper.ff-summary-compact .ff-summary-copy.ff-newspaper-copy p:first-child{
  font-size:inherit;
  line-height:inherit;
}
.ff-summary-card.ff-newspaper.ff-summary-compact h2{font-size:34px}
.ff-summary-card.ff-newspaper.ff-summary-compact .ff-newspaper-masthead{padding-top:16px}
.ff-summary-card.ff-newspaper.ff-summary-compact .ff-newspaper .ff-summary-eyebrow{margin-top:16px}
.ff-summary-card.ff-newspaper.ff-summary-tight .ff-summary-copy.ff-newspaper-copy{
  font-size:12px;
  line-height:1.36;
}
.ff-summary-card.ff-newspaper.ff-summary-tight .ff-summary-copy.ff-newspaper-copy p{
  margin-bottom:6px;
}
.ff-summary-card.ff-newspaper.ff-summary-tight .ff-summary-copy.ff-newspaper-copy p:first-child{
  font-size:inherit;
  line-height:inherit;
}
.ff-summary-card.ff-newspaper.ff-summary-tight h2{font-size:31px}
.ff-summary-card.ff-newspaper.ff-summary-tight .ff-newspaper-byline{margin-top:6px}
.ff-summary-card.ff-newspaper.ff-summary-tight .ff-summary-copy.ff-newspaper-copy{
  margin-top:12px;
  padding-top:12px;
}
.ff-summary-card.ff-newspaper.ff-summary-tight .ff-newspaper .ff-summary-close-btn{
  margin-top:12px;
  margin-bottom:16px;
}

@media(max-width:700px){
  .ff-summary-card.ff-newspaper{border-radius:20px}
  .ff-newspaper-masthead{padding:20px 22px 10px}
  .ff-newspaper-rule{margin:0 22px}
  .ff-newspaper .ff-summary-eyebrow{margin:22px 22px 0}
  .ff-summary-card.ff-newspaper h2{margin:8px 22px 0;font-size:34px}
  .ff-newspaper-scoreline{margin:18px 22px 0;font-size:30px}
  .ff-newspaper-byline{margin:12px 22px 0}
  .ff-summary-copy.ff-newspaper-copy{display:block;margin:22px 22px 0;max-width:none}
  .ff-summary-copy.ff-newspaper-copy p:first-child{}
  .ff-newspaper .ff-summary-close-btn{width:calc(100% - 44px);margin:24px 22px 24px}
}

/* v132 — restored approved full-screen authentication from login v30 */
body.ffj-pre-game > .app{display:none!important}
.ffj-shell{
  position:fixed;
  inset:0;
  z-index:20000;
  font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  color:#17385f;
  background:#f7f9fc;
  overflow:hidden;
}
.ffj-shell.hidden{display:none!important}
.ffj-view{display:none;width:100vw;height:100dvh;min-height:100dvh;padding:0}
.ffj-view.active{display:block}

.ffj-auth-card{
  width:100vw;
  height:100dvh;
  min-height:100dvh;
  display:grid;
  grid-template-columns:58% 42%;
  overflow:hidden;
  background:#f7f9fc;
  border:0;
  border-radius:0;
  box-shadow:none;
}
.ffj-auth-visual{
  position:relative;
  height:100dvh;
  overflow:hidden;
  padding:0;
  background:#f7f9fc;
}
.ffj-auth-visual .ffj-visual-logo{
  position:fixed;
  z-index:20002;
  top:5.7vh;
  left:79%;
  transform:translateX(-50%);
  width:min(34vw,620px);
  display:flex;
  justify-content:center;
  pointer-events:none;
}
.ffj-auth-visual .ffj-visual-logo img{
  width:100%;
  height:auto;
  display:block;
}
.ffj-auth-visual .ffj-hero{
  position:absolute;
  inset:5vh 0 0 0;
  overflow:hidden;
}
.ffj-auth-visual .ffj-hero img{
  width:100%;
  height:100%;
  object-fit:contain;
  object-position:center bottom;
  display:block;
}
.ffj-auth-panel{
  height:100dvh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:28px 32px;
  background:#f7f9fc;
  overflow:hidden;
}
.ffj-auth-inner{
  width:min(100%,540px);
  max-height:calc(100dvh - 56px);
  margin:0;
  padding-top:120px;
}
.ffj-tabs{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-bottom:40px;
}
.ffj-tab{
  height:52px;
  min-height:52px;
  border:1px solid #c9ddf0;
  border-radius:14px;
  background:#f8fbff;
  color:#6a7f96;
  font-weight:900;
  letter-spacing:.04em;
  cursor:pointer;
}
.ffj-tab.active{
  background:#eaf4ff;
  color:#245887;
  border-color:#94c5f3;
}
.ffj-auth-pane{display:none}
.ffj-auth-pane.active{display:block}
.ffj-eyebrow{
  font-size:12px;
  font-weight:900;
  letter-spacing:.14em;
  color:#6a8aab;
  margin-bottom:8px;
  text-transform:uppercase;
}
.ffj-auth-pane h1,.ffj-contract-card h1{
  margin:0;
  font-size:clamp(34px,3.7vw,50px);
  line-height:1.02;
  letter-spacing:-1.4px;
  color:#17385f;
}
.ffj-lead{
  margin:10px 0 22px;
  color:#72869d;
  font-size:17px;
  line-height:1.45;
}
.ffj-field{margin:0 0 16px}
.ffj-field label{
  display:block;
  margin-bottom:7px;
  font-size:14px;
  font-weight:850;
}
.ffj-input{
  width:100%;
  height:56px;
  min-height:56px;
  border:1px solid #c9ddf0;
  border-radius:14px;
  padding:0 16px;
  font:inherit;
  font-size:16px;
  background:#fff;
  color:#17385f;
  outline:none;
}
.ffj-input:focus{
  border-color:#7cb7ff;
  box-shadow:0 0 0 3px rgba(124,183,255,.16);
}
.ffj-password-wrap{position:relative}
.ffj-password-wrap .ffj-input{padding-right:54px}
.ffj-password-eye{
  position:absolute;right:9px;top:50%;transform:translateY(-50%);
  width:40px;height:40px;border:0;border-radius:10px;background:transparent;
  color:#6a7f96;display:grid;place-items:center;cursor:pointer;padding:0;
}
.ffj-password-eye:hover,.ffj-password-eye:focus-visible{background:#eef6ff;color:#245887;outline:none}
.ffj-password-eye svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-width:1.8}
.ffj-password-eye.active{color:#245887}
.ffj-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  margin:2px 0 18px;
  font-size:14px;
}
.ffj-link{
  border:0;
  background:none;
  color:#27659b;
  font:inherit;
  font-weight:850;
  padding:0;
  cursor:pointer;
}
.ffj-check{
  display:flex;
  align-items:center;
  gap:8px;
  color:#72869d;
  font-size:14px;
}
.ffj-check input{width:18px;height:18px;margin:0}
.ffj-primary,.ffj-secondary{
  height:58px;
  min-height:58px;
  border-radius:14px;
  padding:0 18px;
  font:inherit;
  font-size:16px;
  font-weight:950;
  cursor:pointer;
}
.ffj-primary{
  width:100%;
  margin-top:0;
  border:0;
  background:linear-gradient(180deg,#7cb7ff,#69aaf7);
  color:#17385f;
  box-shadow:0 4px 0 #5d9fe8;
}
.ffj-secondary{
  border:1px solid #c9ddf0;
  background:#fff;
  color:#17385f;
}
.ffj-message{min-height:20px;margin-top:10px;color:#72869d;font-size:13px}
.ffj-character-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}
.ffj-character{
  height:50px;
  border:1px solid #c9ddf0;
  border-radius:14px;
  background:#fff;
  color:#6a7f96;
  font-size:14px;
  font-weight:900;
  letter-spacing:.05em;
  cursor:pointer;
}
.ffj-character.active{
  background:#eaf4ff;
  color:#245887;
  border-color:#7cb7ff;
  box-shadow:0 0 0 2px rgba(124,183,255,.14);
}

@media(max-width:1000px){
  .ffj-auth-card{grid-template-columns:56% 44%}
  .ffj-auth-visual .ffj-visual-logo{left:78%;width:min(35vw,520px);top:4.5vh}
  .ffj-auth-visual .ffj-hero{inset:5vh 0 0 0}
  .ffj-auth-panel{padding:24px}
  .ffj-auth-inner{padding-top:108px}
}
@media(max-width:820px){
  .ffj-shell{overflow:auto}
  .ffj-view{height:auto;min-height:100dvh}
  .ffj-auth-card{
    height:auto;
    min-height:100dvh;
    grid-template-columns:1fr;
    grid-template-rows:40dvh auto;
  }
  .ffj-auth-visual{height:40dvh}
  .ffj-auth-visual .ffj-visual-logo{
    position:absolute;left:50%;top:14px;
    width:min(82%,390px);transform:translateX(-50%)
  }
  .ffj-auth-visual .ffj-hero{inset:82px 0 0 0}
  .ffj-auth-visual .ffj-hero img{object-fit:contain}
  .ffj-auth-inner{padding-top:0}
  .ffj-auth-panel{
    height:auto;
    min-height:60dvh;
    align-items:flex-start;
    padding:24px 20px 32px;
    overflow:visible;
  }
  .ffj-auth-inner{max-height:none;width:100%}
}

.ffj-contract-stage{
  width:100vw;
  height:100dvh;
  min-height:100dvh;
  display:grid;
  grid-template-columns:50% 50%;
  border-radius:0;
  overflow:hidden;
  background:#fff;
  border:0;
  box-shadow:none;
}
.ffj-contract-art{
  position:relative;
  overflow:hidden;
  min-height:100dvh;
  padding:0;
  background:#eef3f7;
}
.ffj-contract-art img.ffj-contract-signing-image{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center center;
  display:block;
}
.ffj-contract-welcome-overlay{
  position:absolute;
  z-index:3;
  left:0;
  right:0;
  top:0;
  min-height:210px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:flex-start;
  padding:18px 28px 20px;
  text-align:center;
  background:linear-gradient(180deg,#fff 0%,#fff 82%,rgba(255,255,255,.94) 91%,rgba(255,255,255,0) 100%);
}
.ffj-contract-welcome-overlay .ffj-contract-hello{
  margin:0;
  color:#092f5c;
  font-size:clamp(34px,3.5vw,66px);
  font-weight:950;
  line-height:.96;
  letter-spacing:-.04em;
}
.ffj-contract-welcome-overlay .ffj-contract-hello span{
  display:block;
  color:#1269ed;
  margin-top:6px;
}
.ffj-contract-welcome-overlay p{
  margin:14px 0 0;
  color:#17385f;
  font-size:clamp(16px,1.4vw,25px);
  font-weight:700;
}
@media(max-width:900px){
  .ffj-contract-welcome-overlay{min-height:145px;padding:12px 18px 14px}
  .ffj-contract-welcome-overlay .ffj-contract-hello{font-size:34px}
  .ffj-contract-welcome-overlay p{font-size:15px;margin-top:9px}
}
.ffj-contract-news{
  min-height:100dvh;
  padding:64px 7vw 54px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  background:#fff;
}
.ffj-contract-news .ffj-eyebrow{color:#16865b}
.ffj-contract-news h1{
  margin:0;
  font-size:clamp(38px,4vw,58px);
  line-height:1.02;
  letter-spacing:-1.8px;
  color:#17385f;
}
.ffj-contract-news h1 span{color:#0d7a4f}
.ffj-contract-news-copy{
  margin:28px 0 30px;
  display:grid;
  gap:16px;
  color:#60778b;
  font-size:17px;
  line-height:1.65;
}
.ffj-contract-news-copy p{margin:0}
.ffj-contract-news .ffj-primary{
  width:min(100%,360px);
  background:linear-gradient(180deg,#25a66f,#16865b);
  color:#fff;
  box-shadow:0 4px 0 #0f704a;
}
@media(max-width:900px){
  .ffj-contract-stage{
    width:100vw;
    height:auto;
    min-height:100dvh;
    grid-template-columns:1fr;
    margin:0;
  }  .ffj-contract-news{padding:38px 30px 34px}
}

.ffj-landing-wrap{
  width:min(1180px,100%);display:grid;grid-template-columns:minmax(0,1fr) 390px;
  gap:28px;align-items:stretch
}
.ffj-landing-main,.ffj-landing-hero{
  border-radius:30px;background:#fff;border:1px solid #d5e1ea;
  box-shadow:0 24px 70px rgba(29,62,91,.14)
}
.ffj-landing-main{padding:42px}
.ffj-landing-main h1{font-size:42px;line-height:1.05;margin:9px 0 8px;color:#0b3558}
.ffj-landing-sub{margin:0 0 28px;color:#6c8091}
.ffj-grid{display:grid;gap:14px}
.ffj-home-card{
  width:100%;min-height:108px;border-radius:20px;border:1px solid #d6e1e9;background:#fff;
  padding:18px;display:grid;grid-template-columns:56px 1fr 28px;gap:15px;align-items:center;
  text-align:left;cursor:pointer;color:#173b59;transition:.15s ease
}
.ffj-home-card:hover{transform:translateY(-1px);box-shadow:0 12px 30px rgba(32,68,99,.10)}
.ffj-home-card.primary{background:linear-gradient(180deg,#edf7ff,#e4f2ff);border-color:#9ccbf3}
.ffj-card-icon{width:52px;height:52px;border-radius:15px;display:grid;place-items:center;background:#fff;font-size:25px;border:1px solid #d6e2eb}
.ffj-card-copy strong{display:block;font-size:20px;color:#0b3558}
.ffj-card-copy span{display:block;margin-top:4px;color:#718596;font-size:13px;line-height:1.35}
.ffj-arrow{font-size:26px;color:#77a5c7}
.ffj-landing-hero{
  min-height:520px;position:relative;overflow:hidden;
  background:
    radial-gradient(circle at 50% 18%,rgba(255,255,255,.88),transparent 20%),
    linear-gradient(180deg,#cce7ff 0 42%,#78c795 42% 100%);
}
.ffj-landing-hero:before{
  content:"";position:absolute;left:28px;right:28px;bottom:28px;height:250px;
  border:4px solid rgba(255,255,255,.82);border-radius:24px
}
.ffj-hero-copy{position:absolute;left:32px;right:32px;top:34px}
.ffj-hero-copy strong{font-size:27px;color:#0b3558}
.ffj-hero-copy p{color:#58758d;line-height:1.45}
.ffj-hero-ball{position:absolute;left:50%;bottom:115px;transform:translateX(-50%);font-size:86px;filter:drop-shadow(0 15px 18px rgba(0,0,0,.18))}

.ffj-mode-backdrop{
  position:fixed;inset:0;z-index:20010;display:grid;place-items:center;padding:24px;
  background:rgba(8,25,38,.62);backdrop-filter:blur(8px)
}
.ffj-mode-backdrop.hidden{display:none}
/* Use the same fixed shell app bar on mode selection as the live pitch. */
#ffjModeBackdrop > .ff-appbar{
  position:relative;
  inset:auto;
  width:100%;
  height:70px;
  flex:0 0 70px;
  padding:0 18px 0 20px;
  z-index:20;
}
#ffjModeBackdrop .ff-appbar-actions{gap:8px}
#ffjModeBackdrop .ff-menu-panel{z-index:20030!important}
#ffjModeBackdrop .ff-home-btn{
  display:grid;
  place-items:center;
}

.ffj-mode-topbar,.ffj-mode-brand,.ffj-mode-top-actions{display:none!important}

.ffj-mode-card{
  width:min(720px,100%);padding:28px;border-radius:26px;background:#fff;
  box-shadow:0 30px 90px rgba(0,0,0,.36)
}
.ffj-mode-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}
.ffj-mode-head h2{margin:6px 0 0;color:#0b3558;font-size:30px}
.ffj-close{width:42px;height:42px;border-radius:50%;border:1px solid #d3dee7;background:#fff;color:#0b3558;font-size:23px;cursor:pointer}
.ffj-modes{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:22px}
.ffj-mode{
  min-height:170px;border:1px solid #d6e1e9;border-radius:20px;padding:18px;background:#fff;text-align:left;color:#24465f
}
.ffj-mode.active{cursor:pointer;border-color:#7dbcf1;background:#edf7ff}
.ffj-mode.disabled{opacity:.48}
.ffj-mode-icon{font-size:31px}
.ffj-mode strong{display:block;margin-top:14px;font-size:20px;color:#0b3558}
.ffj-mode p{font-size:13px;line-height:1.45;color:#6d8192}
.ffj-mode small{font-size:11px;font-weight:900;letter-spacing:.7px;color:#7990a2;text-transform:uppercase}
@media(max-width:860px){
  .ffj-auth-card,.ffj-landing-wrap{grid-template-columns:1fr}
  .ffj-auth-visual,.ffj-landing-hero{display:none}
  .ffj-auth-panel,.ffj-landing-main{padding:28px 22px}
  .ffj-view{padding:12px}
  .ffj-modes{grid-template-columns:1fr}
}

/* Immersive New Game mode selection */
.ffj-mode-backdrop{
  position:fixed;
  inset:0;
  z-index:20010;
  display:flex;
  flex-direction:column;
  padding:0;
  background:#f4f7fa;
  backdrop-filter:none;
}
.ffj-mode-backdrop.hidden{display:none}
.ffj-mode-topbar{
  position:relative;
  z-index:5;
  height:76px;
  flex:0 0 76px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  padding:0 28px;
  background:rgba(255,255,255,.96);
  border-bottom:1px solid #d8e2ea;
  box-shadow:0 5px 18px rgba(26,55,81,.08);
}
.ffj-mode-brand{
  width:230px;
  min-width:170px;
  display:flex;
  align-items:center;
}
.ffj-mode-brand img{display:block;width:100%;height:auto}
.ffj-mode-top-actions{display:flex;align-items:center;gap:10px}
.ffj-mode-top-btn{
  min-height:42px;
  border:1px solid #c8d5df;
  border-radius:12px;
  background:#fff;
  color:#17385f;
  padding:0 15px;
  display:flex;
  align-items:center;
  gap:8px;
  font:inherit;
  font-weight:850;
  cursor:pointer;
}
.ffj-mode-top-btn:hover{background:#f2f7fb}
.ffj-mode-home{background:#14324e;color:#fff;border-color:#14324e}
.ffj-mode-home:hover{background:#20496f}
.ffj-mode-menu-wrap{position:relative}
.ffj-mode-menu-panel{
  position:absolute;
  top:calc(100% + 9px);
  right:0;
  width:220px;
  padding:8px;
  border:1px solid #cad7e2;
  border-radius:14px;
  background:#fff;
  box-shadow:0 16px 40px rgba(20,50,78,.20);
}
.ffj-mode-menu-panel.hidden{display:none}
.ffj-mode-menu-item{
  width:100%;
  min-height:46px;
  display:flex;
  align-items:center;
  gap:10px;
  border:0;
  border-radius:10px;
  background:transparent;
  padding:0 12px;
  color:#9f2d2d;
  font:inherit;
  font-weight:850;
  cursor:pointer;
}
.ffj-mode-menu-item:hover{background:#fff1f1}
.ffj-mode-shell{
  flex:1;
  min-height:0;
  display:grid;
  grid-template-columns:minmax(0,1.04fr) minmax(420px,.96fr);
  overflow:hidden;
}
.ffj-mode-content{
  min-width:0;
  padding:clamp(34px,5vw,78px);
  display:flex;
  align-items:center;
  justify-content:center;
  background:
    radial-gradient(circle at 12% 8%,rgba(47,143,232,.10),transparent 33%),
    linear-gradient(145deg,#f9fbfd 0%,#eef4f8 100%);
}
.ffj-mode-content-inner{width:min(760px,100%)}
.ffj-mode-kicker{
  display:inline-flex;
  align-items:center;
  gap:8px;
  color:#2c6797;
  font-size:12px;
  font-weight:950;
  letter-spacing:1.4px;
  text-transform:uppercase;
}
.ffj-mode-kicker:before{
  content:"";
  width:28px;
  height:3px;
  border-radius:999px;
  background:#2f8fe8;
}
.ffj-mode-content h2{
  margin:14px 0 12px;
  color:#0b3558;
  font-size:clamp(42px,4.6vw,68px);
  line-height:.98;
  letter-spacing:-2.2px;
}
.ffj-mode-intro{
  margin:0 0 30px;
  max-width:650px;
  color:#62798c;
  font-size:17px;
  line-height:1.55;
}
.ffj-modes{
  display:grid;
  grid-template-columns:1fr;
  gap:14px;
  margin:0;
}
.ffj-mode{
  position:relative;
  min-height:128px;
  border:1px solid #d5e1ea;
  border-radius:20px;
  padding:20px 24px;
  background:rgba(255,255,255,.92);
  text-align:left;
  color:#24465f;
  display:grid;
  grid-template-columns:58px minmax(0,1fr) auto;
  align-items:center;
  gap:18px;
  box-shadow:0 7px 20px rgba(30,65,94,.05);
}
.ffj-mode.active{
  cursor:pointer;
  border:2px solid #58a8eb;
  background:linear-gradient(100deg,#eaf6ff 0%,#fff 76%);
  box-shadow:0 14px 34px rgba(47,143,232,.13);
}
.ffj-mode.active:hover{transform:translateY(-2px);box-shadow:0 18px 40px rgba(47,143,232,.18)}
.ffj-mode.disabled{opacity:.58}
.ffj-mode-icon{
  width:54px;
  height:54px;
  border-radius:16px;
  display:grid;
  place-items:center;
  background:#f5f8fb;
  border:1px solid #dce6ed;
  font-size:28px;
}
.ffj-mode.active .ffj-mode-icon{background:#fff;border-color:#b9dcf8}
.ffj-mode-copy strong{
  display:block;
  margin:0;
  font-size:21px;
  color:#0b3558;
}
.ffj-mode-copy p{
  margin:5px 0 0;
  font-size:13px;
  line-height:1.45;
  color:#6d8192;
}
.ffj-mode-cta{
  min-width:112px;
  text-align:right;
  color:#2d7dae;
  font-size:11px;
  font-weight:950;
  letter-spacing:.8px;
  text-transform:uppercase;
}
.ffj-mode-disabled-label{color:#8ba0b1}
.ffj-mode-visual{
  position:relative;
  min-width:0;
  overflow:hidden;
  background:
    radial-gradient(circle at 50% 14%,rgba(255,255,255,.95),rgba(255,255,255,0) 28%),
    linear-gradient(180deg,#cfe9ff 0 43%,#70bf8d 43% 100%);
}
.ffj-mode-visual:after{
  content:"";
  position:absolute;
  inset:auto 6% 5% 6%;
  height:47%;
  border:4px solid rgba(255,255,255,.76);
  border-radius:34px;
  opacity:.72;
}
.ffj-mode-art{position:absolute;inset:0;z-index:2}
.ffj-mode-art img{
  width:100%;
  height:100%;
  object-fit:contain;
  object-position:center bottom;
  display:block;
  filter:drop-shadow(0 24px 26px rgba(19,51,73,.18));
}
.ffj-mode-visual-copy{
  position:absolute;
  z-index:3;
  left:clamp(26px,4vw,60px);
  right:clamp(26px,4vw,60px);
  top:clamp(30px,5vh,64px);
}
.ffj-mode-visual-copy strong{
  display:block;
  color:#0b3558;
  font-size:clamp(27px,2.4vw,40px);
  line-height:1.02;
  letter-spacing:-1px;
}
.ffj-mode-visual-copy span{
  display:block;
  margin-top:10px;
  max-width:420px;
  color:#4f7189;
  font-size:15px;
  line-height:1.45;
}
.ffj-close.ffj-mode-close-floating{
  position:absolute;
  z-index:4;
  right:24px;
  top:24px;
  width:44px;
  height:44px;
  background:rgba(255,255,255,.92);
  box-shadow:0 8px 22px rgba(20,50,78,.14);
}
@media(max-width:1000px){
  .ffj-mode-shell{grid-template-columns:1fr}
  .ffj-mode-visual{display:none}
  .ffj-mode-content{padding:42px 28px;overflow:auto}
}
@media(max-width:650px){
  .ffj-mode-topbar{height:68px;flex-basis:68px;padding:0 16px}
  .ffj-mode-brand{width:170px}
  .ffj-mode-top-btn span.ffj-btn-label{display:none}
  .ffj-mode-content{padding:28px 18px}
  .ffj-mode-content h2{font-size:40px}
  .ffj-mode{grid-template-columns:48px minmax(0,1fr);padding:17px;min-height:112px}
  .ffj-mode-icon{width:46px;height:46px;font-size:24px}
  .ffj-mode-cta{grid-column:2;text-align:left;min-width:0}
}


/* Full-screen post-login journey: actions left, approved player artwork right. */
#ffjLandingView{padding:0;height:100dvh;min-height:100dvh}
.ffj-landing-wrap{width:100%;height:100dvh;min-height:100dvh;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0;background:#f7f9fc}
.ffj-landing-main,.ffj-landing-hero{border:0;border-radius:0;box-shadow:none;background:#f7f9fc;min-width:0}
.ffj-landing-main{height:100%;padding:clamp(32px,4.5vw,82px);display:flex;align-items:stretch;justify-content:center;overflow:auto}
.ffj-landing-inner{
  width:100%;
  max-width:660px;
  min-height:100%;
  margin:auto;
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding-block:clamp(18px,4vh,48px);
}
.ffj-landing-logo{
  width:min(100%,430px);
  margin:0 0 clamp(36px,6vh,72px);
}
.ffj-landing-logo img{
  display:block;
  width:100%;
  height:auto;
}
.ffj-landing-main h1{font-size:clamp(36px,3.6vw,56px);letter-spacing:-1px;margin-top:10px}
.ffj-landing-sub{line-height:1.5;margin-bottom:clamp(34px,5vh,56px);font-size:16px}
.ffj-grid{gap:clamp(18px,2.3vh,26px)}
.ffj-home-card{min-height:126px;padding:22px;grid-template-columns:56px minmax(0,1fr) 28px}
.ffj-home-card:focus-visible{outline:3px solid #245887;outline-offset:4px}
.ffj-landing-hero{display:block;position:relative;height:100%;min-height:0;overflow:hidden}
.ffj-landing-hero:before{content:none}
.ffj-landing-art{position:absolute;inset:0}
.ffj-landing-art img{width:100%;height:100%;display:block;object-fit:contain;object-position:center bottom}
@media(max-width:1000px){
 .ffj-landing-main{padding:30px}
 .ffj-landing-logo{width:min(100%,360px);margin-bottom:38px}
 .ffj-home-card{padding:17px;gap:12px;grid-template-columns:48px minmax(0,1fr) 20px}
 .ffj-card-icon{width:46px;height:46px}
 .ffj-card-copy strong{font-size:18px}
}
@media(max-width:600px){
 .ffj-landing-wrap{height:auto;grid-template-columns:1fr;grid-template-rows:auto minmax(35dvh,1fr)}
 .ffj-landing-main{height:auto;overflow:visible;padding:28px 20px}
 .ffj-landing-inner{min-height:0;padding-block:0}
 .ffj-landing-logo{width:min(82%,330px);margin-bottom:28px}
 .ffj-landing-hero{height:40dvh;min-height:240px}
 .ffj-landing-main h1{font-size:34px}
 .ffj-landing-sub{margin-bottom:22px}
 .ffj-home-card{min-height:92px}
 .ffj-grid{gap:12px}
 #ffjLandingView{height:auto}
 .ffj-shell:has(#ffjLandingView.active){overflow:auto}
}


/* v132 mode selection — corrected full-screen shell layout */
#ffjModeBackdrop.hidden{display:none!important}
#ffjModeBackdrop{
  position:fixed;
  inset:0;
  width:100vw;
  height:100dvh;
  margin:0;
  padding:0;
  display:flex;
  flex-direction:column;
  align-items:stretch;
  justify-content:flex-start;
  background:#f4f7fa;
  overflow:hidden;
}
#ffjModeBackdrop > .ff-appbar{
  position:relative;
  inset:auto;
  width:100%;
  height:70px;
  flex:0 0 70px;
  margin:0;
  padding:0 18px 0 20px;
  z-index:20;
}
#ffjModeBackdrop .ff-appbar-title{
  display:flex;
  align-items:center;
  height:100%;
  min-width:0;
}
#ffjModeBackdrop .ff-appbar-title img{
  display:block;
  width:auto;
  height:34px;
  max-width:280px;
  object-fit:contain;
}
#ffjModeBackdrop .ffj-mode-shell{
  flex:1 1 auto;
  width:100%;
  min-width:100%;
  max-width:none;
  height:calc(100dvh - 70px);
  min-height:0;
  margin:0;
  padding:0;
  display:grid;
  grid-template-columns:50% 50%;
  overflow:hidden;
}
#ffjModeBackdrop .ffj-mode-content,
#ffjModeBackdrop .ffj-mode-visual{
  width:100%;
  min-width:0;
  max-width:none;
  height:100%;
  min-height:0;
  margin:0;
  border:0;
  border-radius:0;
}
#ffjModeBackdrop .ffj-mode-content{
  padding:clamp(34px,5vw,78px);
  display:flex;
  align-items:center;
  justify-content:center;
  background:
    radial-gradient(circle at 12% 8%,rgba(47,143,232,.10),transparent 33%),
    linear-gradient(145deg,#f9fbfd 0%,#eef4f8 100%);
}
#ffjModeBackdrop .ffj-mode-content-inner{
  width:min(760px,100%);
  margin:0;
}
#ffjModeBackdrop .ffj-mode-back{
  display:inline-flex;
  align-items:center;
  gap:8px;
  height:42px;
  margin:0 0 22px;
  padding:0 14px;
  border:1px solid #c9dbe8;
  border-radius:12px;
  background:rgba(255,255,255,.78);
  color:#315d7f;
  font:inherit;
  font-size:14px;
  font-weight:850;
  cursor:pointer;
  box-shadow:0 4px 12px rgba(30,65,94,.05);
}
#ffjModeBackdrop .ffj-mode-back:hover,
#ffjModeBackdrop .ffj-mode-back:focus-visible{
  background:#fff;
  border-color:#9fc6e4;
  color:#164f7d;
  outline:none;
}
#ffjModeBackdrop .ffj-mode-back svg{
  width:18px;
  height:18px;
  fill:none;
  stroke:currentColor;
  stroke-width:2;
  stroke-linecap:round;
  stroke-linejoin:round;
}
#ffjModeBackdrop .ffj-mode-visual{
  position:relative;
  overflow:hidden;
  background:#f7f9fc;
}
#ffjModeBackdrop .ffj-mode-visual:after,
#ffjModeBackdrop .ffj-mode-visual-copy,
#ffjModeBackdrop .ffj-mode-close-floating{
  display:none!important;
}
#ffjModeBackdrop .ffj-mode-art{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
}
#ffjModeBackdrop .ffj-mode-art img{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  max-width:none;
  display:block;
  object-fit:cover;
  object-position:center bottom;
}
#ffjModeBackdrop .ff-menu-panel{z-index:20030!important}
@media(max-width:1000px){
  #ffjModeBackdrop .ffj-mode-shell{grid-template-columns:1fr}
  #ffjModeBackdrop .ffj-mode-visual{display:none}
}


/* Landing page aligned to the approved Choose Your Mode left-panel scale and feel. */
#ffjLandingView .ffj-landing-main{
  padding:clamp(34px,5vw,78px);
  align-items:center;
  justify-content:center;
  background:
    radial-gradient(circle at 12% 8%,rgba(47,143,232,.10),transparent 33%),
    linear-gradient(145deg,#f9fbfd 0%,#eef4f8 100%);
}
#ffjLandingView .ffj-landing-inner{
  width:min(760px,100%);
  max-width:760px;
  min-height:0;
  margin:0;
  padding:0;
  justify-content:center;
}
#ffjLandingView .ffj-landing-logo{
  width:min(300px,46%);
  margin:0 0 28px;
}
#ffjLandingView .ffj-eyebrow{
  margin:0 0 8px;
  color:#2c6797;
  font-size:12px;
  font-weight:950;
  letter-spacing:1.4px;
  text-transform:uppercase;
}
#ffjLandingView .ffj-landing-main h1{
  margin:0 0 12px;
  color:#0b3558;
  font-size:clamp(42px,4.6vw,68px);
  line-height:.98;
  letter-spacing:-2.2px;
}
#ffjLandingView .ffj-landing-sub{
  margin:0 0 30px;
  max-width:650px;
  color:#62798c;
  font-size:17px;
  line-height:1.55;
}
#ffjLandingView .ffj-grid{
  display:grid;
  gap:14px;
}
#ffjLandingView .ffj-home-card{
  min-height:128px;
  padding:20px 24px;
  grid-template-columns:58px minmax(0,1fr) auto;
  gap:18px;
  border:1px solid #d5e1ea;
  border-radius:20px;
  background:rgba(255,255,255,.92);
  box-shadow:0 7px 20px rgba(30,65,94,.05);
}
#ffjLandingView .ffj-home-card.primary{
  border:2px solid #58a8eb;
  background:linear-gradient(100deg,#eaf6ff 0%,#fff 76%);
  box-shadow:0 14px 34px rgba(47,143,232,.13);
}
#ffjLandingView .ffj-home-card:hover{
  transform:translateY(-2px);
  box-shadow:0 18px 40px rgba(47,143,232,.14);
}
#ffjLandingView .ffj-card-icon{
  width:54px;
  height:54px;
  border-radius:16px;
  background:#f5f8fb;
  border:1px solid #dce6ed;
  font-size:28px;
}
#ffjLandingView .ffj-home-card.primary .ffj-card-icon{
  background:#fff;
  border-color:#b9dcf8;
}
#ffjLandingView .ffj-card-copy strong{
  display:block;
  margin:0;
  font-size:21px;
  color:#0b3558;
}
#ffjLandingView .ffj-card-copy span{
  display:block;
  margin-top:5px;
  color:#6d8192;
  font-size:13px;
  line-height:1.45;
}
#ffjLandingView .ffj-arrow{
  font-size:20px;
  font-weight:900;
  color:#2d7dae;
}
@media(max-width:1000px){
  #ffjLandingView .ffj-landing-main{padding:42px 28px}
  #ffjLandingView .ffj-landing-logo{width:min(280px,52%);margin-bottom:24px}
}
@media(max-width:600px){
  #ffjLandingView .ffj-landing-main{padding:28px 18px}
  #ffjLandingView .ffj-landing-main h1{font-size:40px}
  #ffjLandingView .ffj-home-card{
    min-height:112px;
    padding:17px;
    grid-template-columns:48px minmax(0,1fr) 20px;
  }
  #ffjLandingView .ffj-card-icon{width:46px;height:46px;font-size:24px}
}


/* Welcome landing uses the same shared shell bar as Choose Your Mode. */
#ffjLandingView.active{
  display:flex;
  flex-direction:column;
  width:100vw;
  height:100dvh;
  min-height:100dvh;
  overflow:hidden;
}
#ffjLandingView > .ff-appbar{
  position:relative;
  inset:auto;
  width:100%;
  height:70px;
  flex:0 0 70px;
  margin:0;
  padding:0 18px 0 20px;
  z-index:20;
}
#ffjLandingView .ff-appbar-title{
  display:flex;
  align-items:center;
  height:100%;
  min-width:0;
}
#ffjLandingView .ff-appbar-title img{
  display:block;
  width:auto;
  height:34px;
  max-width:280px;
  object-fit:contain;
}
#ffjLandingView .ffj-landing-wrap{
  flex:1 1 auto;
  width:100%;
  height:calc(100dvh - 70px);
  min-height:0;
}
#ffjLandingView .ffj-landing-main,
#ffjLandingView .ffj-landing-hero{
  height:100%;
  min-height:0;
}
#ffjLandingView .ff-menu-panel{z-index:20030!important}


/* Friendly save / continue / load experience */
#ffjContinueBtn:disabled{
  cursor:not-allowed;
  opacity:.55;
  transform:none!important;
  box-shadow:none!important;
}
.ffj-save-backdrop{
  position:fixed;
  inset:0;
  z-index:20050;
  display:grid;
  place-items:center;
  padding:24px;
  background:rgba(8,25,38,.48);
  backdrop-filter:blur(8px);
}
.ffj-save-backdrop.hidden{display:none!important}
.ffj-save-panel{
  width:min(820px,calc(100vw - 36px));
  max-height:min(760px,calc(100dvh - 48px));
  overflow:hidden;
  border-radius:26px;
  background:#f8fbfd;
  border:1px solid #d7e2ea;
  box-shadow:0 30px 90px rgba(10,36,58,.28);
  display:flex;
  flex-direction:column;
}
.ffj-save-head{
  display:flex;
  justify-content:space-between;
  gap:24px;
  padding:28px 30px 22px;
  border-bottom:1px solid #dce6ed;
  background:#fff;
}
.ffj-save-kicker{
  color:#2c6797;
  font-size:11px;
  font-weight:950;
  letter-spacing:1.4px;
}
.ffj-save-head h2{
  margin:7px 0 7px;
  color:#0b3558;
  font-size:34px;
  letter-spacing:-1px;
}
.ffj-save-head p{margin:0;color:#6b8193;line-height:1.45}
.ffj-save-close{
  flex:0 0 42px;
  width:42px;height:42px;
  border-radius:50%;
  border:1px solid #ccd9e3;
  background:#fff;color:#17385f;
  font-size:24px;
}
.ffj-save-list{
  padding:18px;
  overflow:auto;
  display:grid;
  gap:12px;
}
.ffj-save-empty{
  padding:42px 22px;
  text-align:center;
  color:#718596;
}
.ffj-save-row{
  display:grid;
  grid-template-columns:56px minmax(0,1fr) auto;
  gap:16px;
  align-items:center;
  padding:18px;
  border:1px solid #d7e3eb;
  border-radius:18px;
  background:#fff;
}
.ffj-save-icon{
  width:52px;height:52px;border-radius:15px;
  display:grid;place-items:center;
  background:#edf7ff;border:1px solid #b8d9f5;
  font-size:25px;
}
.ffj-save-copy strong{
  display:block;color:#0b3558;font-size:18px;
}
.ffj-save-meta{
  margin-top:5px;color:#62798c;font-size:13px;line-height:1.45;
}
.ffj-save-actions{display:flex;gap:8px;align-items:center}
.ffj-save-load,.ffj-save-delete{
  min-height:38px;border-radius:10px;padding:0 14px;font-weight:850;
}
.ffj-save-load{border:1px solid #2f8fe8;background:#2f8fe8;color:#fff}
.ffj-save-delete{border:1px solid #d8e2e9;background:#fff;color:#9f2d2d}
.ff-save-toast{
  position:fixed;
  z-index:30000;
  right:24px;
  bottom:24px;
  padding:12px 16px;
  border-radius:12px;
  background:#123a5c;
  color:#fff;
  font-weight:850;
  box-shadow:0 12px 30px rgba(0,0,0,.22);
  transition:opacity .2s ease,transform .2s ease;
}
.ff-save-toast.hide{opacity:0;transform:translateY(8px)}
@media(max-width:650px){
  .ffj-save-row{grid-template-columns:46px 1fr}
  .ffj-save-actions{grid-column:2}
  .ffj-save-head{padding:22px}
}


/* Tournament v1 — setup, bracket hub and tournament stats */
.ffj-tournament-screen{
  position:fixed;
  inset:0;
  z-index:20040;
  width:100vw;
  height:100dvh;
  display:flex;
  flex-direction:column;
  background:#f4f7fa;
  overflow:hidden;
}
.ffj-tournament-screen.hidden{display:none!important}
.ffj-tournament-screen > .ff-appbar{
  width:100%;
  height:70px;
  flex:0 0 70px;
  padding:0 18px 0 20px;
  z-index:30;
}
#ffjTournamentSetup .ff-appbar-title{
  display:flex;
  align-items:center;
  min-width:0;
}
#ffjTournamentSetup .ff-appbar-title img{
  display:block;
  height:34px;
  width:auto;
  max-width:280px;
  object-fit:contain;
}
.ffj-tournament-setup-shell{
  flex:1;
  min-height:0;
  display:grid;
  grid-template-columns:minmax(0,1.1fr) minmax(360px,.9fr);
}
.ffj-tournament-setup-main{
  display:flex;
  align-items:center;
  justify-content:center;
  min-width:0;
  padding:clamp(36px,5vw,76px);
  background:
    radial-gradient(circle at 12% 8%,rgba(47,143,232,.10),transparent 33%),
    linear-gradient(145deg,#f9fbfd 0%,#eef4f8 100%);
}
.ffj-tournament-setup-inner{width:min(760px,100%)}
.ffj-tournament-kicker{
  color:#2c6797;
  font-size:12px;
  font-weight:950;
  letter-spacing:1.4px;
  text-transform:uppercase;
}
.ffj-tournament-setup-inner h1,
.ffj-tournament-summary h1,
.ffj-stats-head h1{
  margin:10px 0 12px;
  color:#0b3558;
  font-size:clamp(40px,4.2vw,64px);
  line-height:1;
  letter-spacing:-2px;
}
.ffj-tournament-intro{
  max-width:640px;
  margin:0 0 28px;
  color:#62798c;
  font-size:17px;
  line-height:1.55;
}
.ffj-tournament-field{
  margin-top:16px;
  padding:18px;
  border:1px solid #d7e2ea;
  border-radius:18px;
  background:rgba(255,255,255,.9);
}
.ffj-tournament-field-head strong{
  display:block;
  color:#0b3558;
  font-size:17px;
}
.ffj-tournament-field-head span{
  display:block;
  margin-top:4px;
  color:#748898;
  font-size:13px;
}
.ffj-tournament-type-options{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:10px;
  margin-top:14px;
}
.ffj-tournament-type-option{
  min-height:48px;
  border:1px solid #cfdae3;
  border-radius:13px;
  background:#fff;
  color:#17385f;
  font:inherit;
  font-size:15px;
  font-weight:900;
  cursor:pointer;
}
.ffj-tournament-type-option.selected{
  border:2px solid #58a8eb;
  background:#eaf6ff;
  color:#0b3558;
  box-shadow:0 8px 20px rgba(47,143,232,.10);
}
.ffj-club-scope{margin-top:18px;padding-top:16px;border-top:1px solid #e3eaf0}
.ffj-club-scope.hidden{display:none}
.ffj-tournament-subhead strong{font-size:15px}
.ffj-team-picker{
  display:grid;
  grid-template-columns:54px minmax(0,1fr);
  gap:14px;
  align-items:center;
  margin-top:14px;
  padding:12px 14px;
  border:1px solid #bfd0dd;
  border-radius:14px;
  background:#fff;
  box-shadow:0 5px 14px rgba(30,65,94,.04);
}
.ffj-team-select-badge{
  position:static;
  width:54px;
  height:54px;
  display:flex;
  align-items:center;
  justify-content:center;
  pointer-events:none;
}
.ffj-team-select-badge img{
  width:42px;
  height:28px;
  display:block;
  object-fit:cover;
  border-radius:4px;
  box-shadow:0 0 0 1px rgba(16,55,84,.16),0 4px 10px rgba(16,55,84,.10);
}
.ffj-team-select-badge .ffj-club-badge{
  width:42px;
  height:46px;
  display:grid;
  place-items:center;
  background:linear-gradient(180deg,#164e78,#0b3558);
  color:#fff;
  font-size:11px;
  font-weight:950;
  letter-spacing:.4px;
  clip-path:polygon(50% 0,92% 15%,86% 72%,50% 100%,14% 72%,8% 15%);
  filter:drop-shadow(0 5px 5px rgba(16,55,84,.18));
}
.ffj-team-picker-main{min-width:0}
.ffj-team-picker-label{
  display:block;
  margin:0 0 3px;
  color:#738899;
  font-size:11px;
  font-weight:850;
  letter-spacing:.35px;
  text-transform:uppercase;
}
.ffj-country-select{
  width:100%;
  min-height:32px;
  border:0;
  border-radius:0;
  padding:0 34px 0 0;
  background:#fff;
  color:#17385f;
  font:inherit;
  font-size:17px;
  font-weight:900;
  outline:none;
}
.ffj-country-select:focus{box-shadow:none}
.ffj-size-options{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
  margin-top:14px;
}
.ffj-size-option{
  min-height:78px;
  border:1px solid #cfdae3;
  border-radius:14px;
  background:#fff;
  color:#17385f;
  cursor:pointer;
}
.ffj-size-option strong{
  display:block;
  font-size:25px;
  color:#0b3558;
}
.ffj-size-option span{
  display:block;
  margin-top:3px;
  font-size:12px;
  color:#7a8e9d;
}
.ffj-size-option.selected{
  border:2px solid #58a8eb;
  background:#eaf6ff;
  box-shadow:0 8px 20px rgba(47,143,232,.12);
}
.ffj-tournament-setup-actions{
  display:flex;
  justify-content:flex-end;
  gap:10px;
  margin-top:20px;
}
.ffj-secondary-action,.ffj-primary-action{
  min-height:48px;
  border-radius:12px;
  padding:0 18px;
  font:inherit;
  font-weight:900;
  cursor:pointer;
}
.ffj-secondary-action{
  border:1px solid #cbd8e2;
  background:#fff;
  color:#17385f;
}
.ffj-primary-action{
  border:1px solid #2f8fe8;
  background:#2f8fe8;
  color:#fff;
}
.ffj-tournament-setup-side{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:54px;
  text-align:center;
  color:#183f5f;
  background:
    radial-gradient(circle at 50% 28%,rgba(255,255,255,.9),transparent 23%),
    linear-gradient(165deg,#dff1ff,#eef8f2 56%,#d7efdf);
  border-left:1px solid #d8e2e9;
}
.ffj-trophy-mark{font-size:92px;filter:drop-shadow(0 16px 16px rgba(100,77,0,.16))}
.ffj-tournament-setup-side>strong{margin-top:20px;font-size:31px;color:#0b3558}
.ffj-tournament-setup-side>p{max-width:440px;line-height:1.55;color:#62798c}
.ffj-tournament-path-preview{
  display:flex;
  align-items:center;
  gap:9px;
  margin-top:26px;
  color:#4f7189;
  font-size:12px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.5px;
}
.ffj-tournament-path-preview i{
  width:34px;
  height:2px;
  background:#8dbbdc;
  position:relative;
}
.ffj-tournament-path-preview i:after{
  content:"";
  position:absolute;
  right:-1px;
  top:-3px;
  border-left:6px solid #8dbbdc;
  border-top:4px solid transparent;
  border-bottom:4px solid transparent;
}
.ffj-tournament-hub-main{
  flex:1;
  min-height:0;
  overflow:auto;
  background:
    radial-gradient(circle at 50% 0,rgba(47,143,232,.08),transparent 30%),
    #f5f8fb;
}
.ffj-tournament-panel{display:none;min-height:100%;padding:28px clamp(22px,3vw,48px) 42px}
.ffj-tournament-panel.active{display:block}
.ffj-tournament-summary,.ffj-stats-head{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:24px;
  width:min(1600px,100%);
  margin:0 auto 18px;
}
.ffj-tournament-summary h1,.ffj-stats-head h1{font-size:clamp(34px,3vw,48px);margin-bottom:8px}
.ffj-tournament-summary p,.ffj-stats-head p{margin:0;color:#6c8091}
.ffj-user-country-chip{
  flex:0 0 auto;
  min-height:48px;
  display:flex;
  align-items:center;
  gap:10px;
  padding:0 16px;
  border:1px solid #bcd6e9;
  border-radius:14px;
  background:#fff;
  color:#17385f;
  font-weight:900;
}
.ffj-bracket-scroll{
  width:100%;
  overflow:auto;
  padding-bottom:16px;
}
.ffj-bracket{
  position:relative;
  width:max(1180px,100%);
  min-height:640px;
  padding:20px;
  border:1px solid #d8e3eb;
  border-radius:24px;
  background:#fff;
  box-shadow:0 18px 55px rgba(27,60,88,.08);
}
.ffj-bracket-grid{
  position:relative;
  z-index:2;
  min-height:600px;
  display:grid;
  grid-template-columns:repeat(var(--bracket-cols,7),minmax(150px,1fr));
  gap:22px;
  align-items:stretch;
}
.ffj-bracket-lines{
  position:absolute;
  inset:20px;
  z-index:1;
  width:calc(100% - 40px);
  height:calc(100% - 40px);
  overflow:visible;
  pointer-events:none;
}
.ffj-bracket-lines path{
  fill:none;
  stroke:#c4d2dd;
  stroke-width:2;
}
.ffj-bracket-round{
  min-width:0;
  display:flex;
  flex-direction:column;
}
.ffj-bracket-round-title{
  min-height:38px;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#668094;
  font-size:11px;
  font-weight:950;
  text-transform:uppercase;
  letter-spacing:.9px;
}
.ffj-bracket-match-stack{
  flex:1;
  display:flex;
  flex-direction:column;
  justify-content:space-around;
  gap:16px;
}
.ffj-bracket-match{
  position:relative;
  min-height:84px;
  border:1px solid #d4e0e8;
  border-radius:14px;
  background:#fff;
  box-shadow:0 7px 18px rgba(29,62,91,.06);
  overflow:hidden;
}
.ffj-bracket-match.user-path{
  border:2px solid #58a8eb;
  box-shadow:0 10px 24px rgba(47,143,232,.14);
}
.ffj-bracket-team{
  min-height:41px;
  display:flex;
  align-items:center;
  gap:8px;
  padding:0 10px;
  color:#24465f;
  font-size:12px;
  font-weight:850;
}
.ffj-bracket-team + .ffj-bracket-team{border-top:1px solid #e5edf2}
.ffj-bracket-team.empty{color:#a8b6c1;font-weight:700}
.ffj-flag{font-size:20px;line-height:1}
.ffj-bracket-final{
  justify-content:center;
}
.ffj-bracket-final .ffj-bracket-round-title{
  color:#2d7dae;
  font-size:13px;
}
.ffj-final-trophy{
  text-align:center;
  font-size:54px;
  margin:0 0 12px;
}
.ffj-final-label{
  text-align:center;
  margin-top:12px;
  color:#8294a2;
  font-size:11px;
  font-weight:900;
  text-transform:uppercase;
}
.ffj-stats-empty{
  width:min(900px,100%);
  min-height:280px;
  margin:44px auto 0;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  border:1px dashed #bfd0dc;
  border-radius:24px;
  background:#fff;
  color:#718596;
  text-align:center;
  font-size:46px;
}
.ffj-stats-empty strong{margin-top:15px;color:#0b3558;font-size:22px}
.ffj-stats-empty span{margin-top:7px;max-width:500px;font-size:14px;line-height:1.45}
.ffj-tournament-nav.active{
  background:#e7f3fc;
  border-color:#9fcbed;
  color:#0b5d98;
}
@media(max-width:1050px){
  .ffj-tournament-setup-shell{grid-template-columns:1fr}
  .ffj-tournament-setup-side{display:none}
  .ffj-tournament-appbar .ffj-tournament-nav{display:none}
}
@media(max-width:680px){
  .ffj-tournament-setup-main{padding:30px 18px}
  .ffj-size-options{grid-template-columns:1fr}
  .ffj-tournament-setup-actions{flex-direction:column-reverse}
  .ffj-secondary-action,.ffj-primary-action{width:100%}
  .ffj-tournament-panel{padding:22px 14px 34px}
  .ffj-tournament-summary{align-items:flex-start;flex-direction:column}
}


/* Tournament match progression */
.ffj-bracket-team{
  justify-content:space-between;
}
.ffj-bracket-team-main{
  min-width:0;
  display:flex;
  align-items:center;
  gap:8px;
}
.ffj-bracket-team-score{
  flex:0 0 auto;
  min-width:18px;
  text-align:right;
  color:#0b3558;
  font-weight:950;
}
.ffj-bracket-team.winner{
  background:#f0f9f4;
  color:#145c3d;
}
.ffj-bracket-team.loser{
  color:#91a0ab;
}
.ffj-bracket-match-result{
  padding:5px 10px 7px;
  border-top:1px solid #e5edf2;
  color:#6c8191;
  font-size:10px;
  font-weight:850;
  text-align:center;
  text-transform:uppercase;
  letter-spacing:.45px;
}
.ffj-play-tournament-match{
  width:calc(100% - 16px);
  min-height:34px;
  margin:8px;
  border:1px solid #2f8fe8;
  border-radius:9px;
  background:#2f8fe8;
  color:#fff;
  font:inherit;
  font-size:11px;
  font-weight:950;
  text-transform:uppercase;
  letter-spacing:.5px;
  cursor:pointer;
}
.ffj-play-tournament-match:hover{background:#237ac0}
.ffj-bracket-match.current-fixture{
  border:2px solid #2f8fe8;
  box-shadow:0 12px 28px rgba(47,143,232,.18);
}
.ffj-tournament-status-banner{
  width:min(1600px,100%);
  margin:0 auto 18px;
  padding:13px 16px;
  border:1px solid #c7dce9;
  border-radius:14px;
  background:#fff;
  color:#365a73;
  font-size:13px;
  font-weight:800;
}
.ffj-tournament-status-banner.champion{
  border-color:#e4c55a;
  background:#fff9df;
  color:#725500;
}
.ffj-tournament-status-banner.eliminated{
  border-color:#e1c9c9;
  background:#fff6f6;
  color:#7e3e3e;
}


/* Tournament setup redesign — compact no-scroll layout + cinematic hero */
#ffjTournamentSetup .ffj-tournament-setup-shell{
  grid-template-columns:minmax(680px,1.05fr) minmax(520px,.95fr);
}
#ffjTournamentSetup .ffj-tournament-setup-main{
  align-items:center;
  padding:24px clamp(30px,4vw,64px);
  overflow:hidden;
}
#ffjTournamentSetup .ffj-tournament-setup-inner{width:min(760px,100%)}
#ffjTournamentSetup .ffj-tournament-setup-inner h1{
  margin:7px 0 8px;
  font-size:clamp(42px,3.45vw,59px);
}
#ffjTournamentSetup .ffj-tournament-intro{
  margin-bottom:16px;
  font-size:15px;
  line-height:1.4;
}
#ffjTournamentSetup .ffj-tournament-field{
  margin-top:12px;
  padding:14px 16px;
  border-radius:16px;
}
#ffjTournamentSetup .ffj-tournament-field-head strong{font-size:15px}
#ffjTournamentSetup .ffj-tournament-field-head span{font-size:12px;margin-top:2px}
#ffjTournamentSetup .ffj-tournament-type-options{margin-top:10px;gap:9px}
#ffjTournamentSetup .ffj-tournament-type-option{min-height:42px;border-radius:11px;font-size:14px}
#ffjTournamentSetup .ffj-club-scope{
  display:grid;
  grid-template-columns:minmax(180px,.9fr) minmax(260px,1.1fr);
  align-items:center;
  gap:14px;
  margin-top:12px;
  padding-top:12px;
}
#ffjTournamentSetup .ffj-club-scope.hidden{display:none}
#ffjTournamentSetup .ffj-club-scope .ffj-tournament-type-options{margin-top:0}
#ffjTournamentSetup .ffj-tournament-subhead strong{font-size:13px}
#ffjTournamentSetup .ffj-tournament-subhead span{font-size:11px}
#ffjTournamentSetup .ffj-team-picker{
  grid-template-columns:48px minmax(0,1fr);
  gap:12px;
  margin-top:10px;
  padding:9px 12px;
}
#ffjTournamentSetup .ffj-team-select-badge{width:48px;height:48px}
#ffjTournamentSetup .ffj-team-select-badge .ffj-club-badge{
  width:44px;height:44px;
  border-radius:50%;
  clip-path:none;
  background:linear-gradient(180deg,#164e78,#0b3558);
  font-size:12px;
  border:2px solid #fff;
  box-shadow:0 0 0 2px #a9c9e2,0 5px 12px rgba(16,55,84,.16);
  filter:none;
}
#ffjTournamentSetup .ffj-team-select-badge img{width:40px;height:27px}
#ffjTournamentSetup .ffj-size-options{margin-top:10px}
#ffjTournamentSetup .ffj-size-option{min-height:61px}
#ffjTournamentSetup .ffj-size-option strong{font-size:21px}
#ffjTournamentSetup .ffj-size-option span{font-size:11px}
#ffjTournamentSetup .ffj-tournament-setup-actions{margin-top:12px}
#ffjTournamentSetup .ffj-secondary-action,
#ffjTournamentSetup .ffj-primary-action{min-height:43px}
#ffjTournamentSetup .ffj-tournament-setup-side{
  position:relative;
  overflow:hidden;
  justify-content:flex-end;
  min-width:0;
  padding:0;
  border-left:1px solid rgba(133,176,210,.35);
  color:#fff;
  background:
    radial-gradient(circle at 50% 12%,rgba(97,181,255,.55),transparent 28%),
    linear-gradient(180deg,#0e5c9d 0%,#073b6c 48%,#06264a 100%);
}
#ffjTournamentSetup .ffj-tournament-setup-side:before{
  content:"";
  position:absolute;inset:0;
  background:
    radial-gradient(circle at 12% 15%,rgba(255,255,255,.75) 0 2px,transparent 3px),
    radial-gradient(circle at 88% 18%,rgba(255,255,255,.75) 0 2px,transparent 3px),
    linear-gradient(180deg,transparent 0 64%,rgba(1,20,42,.34) 100%);
  pointer-events:none;
}
.ffj-tournament-hero{
  position:absolute;
  inset:0;
  overflow:hidden;
}
.ffj-stadium-lights{
  position:absolute;
  top:30px;
  width:180px;height:80px;
  background:radial-gradient(ellipse at center,rgba(255,255,255,.95) 0 5%,rgba(181,224,255,.35) 18%,transparent 68%);
  filter:blur(.2px);
}
.ffj-stadium-lights-left{left:-20px;transform:rotate(-12deg)}
.ffj-stadium-lights-right{right:-20px;transform:rotate(12deg)}
.ffj-hero-trophy{
  position:absolute;
  left:50%;top:8%;
  width:min(42vw,390px);
  transform:translateX(-50%);
  filter:drop-shadow(0 28px 30px rgba(0,8,24,.4));
  z-index:3;
}
.ffj-hero-trophy svg{display:block;width:100%;height:auto}
.ffj-hero-pitch{
  position:absolute;
  left:-8%;right:-8%;bottom:-3%;
  height:39%;
  transform:perspective(500px) rotateX(58deg);
  transform-origin:bottom center;
  background:
    linear-gradient(90deg,transparent 49.7%,rgba(255,255,255,.7) 49.8% 50.2%,transparent 50.3%),
    radial-gradient(ellipse at 50% 28%,transparent 0 16%,rgba(255,255,255,.55) 16.3% 16.8%,transparent 17.1%),
    repeating-linear-gradient(90deg,rgba(41,139,91,.95) 0 90px,rgba(31,117,79,.95) 90px 180px);
  border-top:1px solid rgba(255,255,255,.4);
  box-shadow:0 -20px 60px rgba(10,122,80,.26);
  z-index:1;
}
.ffj-hero-bracket{
  position:absolute;
  top:17%;
  bottom:35%;
  width:22%;
  display:flex;
  flex-direction:column;
  justify-content:space-around;
  z-index:4;
}
.ffj-hero-bracket-left{left:7%;align-items:flex-start}
.ffj-hero-bracket-right{right:7%;align-items:flex-end}
.ffj-hero-team-badge{
  position:relative;
  width:58px;height:58px;
  display:grid;place-items:center;
  border-radius:16px;
  border:1px solid rgba(164,216,255,.65);
  background:linear-gradient(180deg,rgba(52,135,205,.78),rgba(12,67,117,.78));
  box-shadow:0 7px 20px rgba(0,19,47,.28),inset 0 0 18px rgba(153,217,255,.18);
  color:#fff;
  font-size:18px;
  font-weight:950;
}
.ffj-hero-team-badge:after{
  content:"";
  position:absolute;
  top:50%;
  width:54px;height:1px;
  background:linear-gradient(90deg,#9ad7ff,#55b6ff);
  box-shadow:0 0 8px rgba(84,184,255,.8);
}
.ffj-hero-bracket-left .ffj-hero-team-badge:after{left:100%}
.ffj-hero-bracket-right .ffj-hero-team-badge:after{right:100%}
.ffj-tournament-side-copy{
  position:relative;
  z-index:6;
  width:100%;
  padding:0 46px 42px;
  text-align:center;
  text-shadow:0 2px 16px rgba(0,18,45,.5);
}
#ffjTournamentSetup .ffj-tournament-side-copy>strong{
  display:block;
  margin:0;
