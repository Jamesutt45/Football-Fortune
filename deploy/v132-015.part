", "red": "data:image/png;base64,"};
  window.FOOTBALL_FORTUNE_ASSET=ASSET;
  const DICE = {1:ASSET.d1,2:ASSET.d2,3:ASSET.d3,4:ASSET.d4,5:ASSET.d5,6:ASSET.d6};
  const ROUTE = ['m1','m3','m5','m7','m9','m11','m13','m15','m17','m19','m21','m23','m25','m27','m29','m31','m33','m35','m37','m39','m41','m43','m47','m49','m51','m53','m55','m57','m59','m61','m63','m65','m67','m69','m71','m73','m75','m77','m79','m81','m83','m85','m87','m89','m91','m93'];
  const FULL_ROUTE = ['kickoff','m1','m3','m5','m7','m9','m11','m13','m15','m17','m19','m21','m23','m25','m27','m29','m31','m33','m35','m37','m39','m41','m43','halftime','m47','m49','m51','m53','m55','m57','m59','m61','m63','m65','m67','m69','m71','m73','m75','m77','m79','m81','m83','m85','m87','m89','m91','m93','m95','fulltime'];
  const firstHalf=ROUTE.slice(0,22), secondHalf=ROUTE.slice(22);
  let generation=0, currentEvents=[];

  const shuffle=a=>{a=[...a];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;};
  const minuteOf=id=>Number(id.replace('m',''));
  const node=id=>document.querySelector(`.minute-node[data-id="${id}"]`);
  const point=id=>{const el=node(id); if(!el) return null; const layer=document.getElementById('coordinateLayer'); return {x:el.offsetLeft,y:el.offsetTop};};
  function chooseSpaced(ids,count){
    for(let t=0;t<500;t++){
      const candidates=shuffle(ids.map((id,i)=>({id,i}))); const picked=[];
      for(const c of candidates){ if(picked.every(p=>Math.abs(p.i-c.i)>1)) picked.push(c); if(picked.length===count) return picked.map(p=>p.id); }
    }
    return shuffle(ids).slice(0,count);
  }
  function chooseSuccess(min,max){
    const count=min+Math.floor(Math.random()*(max-min+1));
    return shuffle([1,2,3,4,5,6]).slice(0,count).sort((a,b)=>a-b);
  }
  function addEvent(ev){
    const host=document.getElementById('dynamicEventLayer'); const n=node(ev.id); if(!host||!n)return;
    n.classList.add('event-covered');
    const el=document.createElement('div'); el.className='dynamic-event '+ev.cls; el.dataset.event=ev.type; el.dataset.node=ev.id;
    el.style.left=n.style.left; el.style.top=n.style.top; el.title=ev.title;
    const img=document.createElement('img'); img.alt=''; img.src=ASSET[ev.asset]; el.appendChild(img);
    if(ev.type==='goal-odd'||ev.type==='goal-even'){ const label=document.createElement('div'); label.className='goal-rule-label'; label.textContent=ev.type==='goal-odd'?'ODD':'EVEN'; el.appendChild(label); }
    host.appendChild(el);
  }
  function clearBoard(){
    document.getElementById('dynamicEventLayer').innerHTML=''; clearMovementCanvas();
    document.querySelectorAll('.minute-node.event-covered').forEach(n=>n.classList.remove('event-covered'));
  }
  const SCORING_TYPES=new Set(['goal-odd','goal-even','free','penalty','open']);
  function destinationFor(ev,events){
    const idx=FULL_ROUTE.indexOf(ev.id); if(idx<0)return null;
    let dir=0,spaces=0;
    if(ev.type==='yellow'){dir=1;spaces=3;}
    else if(ev.type==='red'){dir=1;spaces=6;}
    else if(ev.type==='injury'){dir=-1;spaces=3;}
    else return null;
    const kickoffIdx=FULL_ROUTE.indexOf('kickoff');
    const m95Idx=FULL_ROUTE.indexOf('m95');
    const fullIdx=FULL_ROUTE.indexOf('fulltime');
    const eventById=new Map(events.map(e=>[e.id,e]));
    let targetIdx=idx;
    for(let step=0;step<spaces;step++){
      if(dir>0){
        if(targetIdx+1>=m95Idx)return 'fulltime';
        targetIdx=Math.min(fullIdx,targetIdx+1);
      }else{
        targetIdx=Math.max(kickoffIdx,targetIdx-1);
      }
    }
    while(true){
      const id=FULL_ROUTE[targetIdx];
      if(dir>0 && (id==='m95' || id==='fulltime')) return 'fulltime';
      const evAtNode=eventById.get(id);
      const isScoring=id==='m95' || (!!evAtNode && SCORING_TYPES.has(evAtNode.type));
      if(!isScoring) return id;
      targetIdx+=dir;
      if(dir>0){
        if(targetIdx>=m95Idx)return 'fulltime';
      }else if(targetIdx<=kickoffIdx){
        return 'kickoff';
      }
    }
  }
  function curveClear(src,dst,control,obstacles,radius){
    for(let s=1;s<30;s++){ const t=s/30, u=1-t; const x=u*u*src.x+2*u*t*control.x+t*t*dst.x; const y=u*u*src.y+2*u*t*control.y+t*t*dst.y;
      for(const o of obstacles){ if(o.id===src.id||o.id===dst.id)continue; const dx=x-o.x,dy=y-o.y;if(dx*dx+dy*dy<radius*radius)return false; } }
    return true;
  }
  function setupMovementCanvas(){
    const canvas=document.getElementById('movementLayer');
    const layer=document.getElementById('coordinateLayer');
    if(!canvas||!layer)return null;
    const dpr=Math.max(1,window.devicePixelRatio||1), w=Math.max(1,layer.clientWidth), h=Math.max(1,layer.clientHeight);
    canvas.width=Math.round(w*dpr); canvas.height=Math.round(h*dpr); canvas.style.width=w+'px'; canvas.style.height=h+'px';
    const ctx=canvas.getContext('2d'); ctx.setTransform(dpr,0,0,dpr,0,0); ctx.clearRect(0,0,w,h);
    return {canvas,ctx,w,h};
  }
  function clearMovementCanvas(){
    const canvas=document.getElementById('movementLayer'); const layer=document.getElementById('coordinateLayer'); if(!canvas||!layer)return;
    const dpr=Math.max(1,window.devicePixelRatio||1),w=Math.max(1,layer.clientWidth),h=Math.max(1,layer.clientHeight);
    canvas.width=Math.round(w*dpr); canvas.height=Math.round(h*dpr); canvas.style.width=w+'px'; canvas.style.height=h+'px';
    const ctx=canvas.getContext('2d'); ctx.setTransform(dpr,0,0,dpr,0,0); ctx.clearRect(0,0,w,h);
  }
  function movementGeometry(ev){
    const sp=point(ev.id), dp=point(ev.to); if(!sp||!dp)return null;
    const all=FULL_ROUTE.map(id=>{const p=point(id);return p?{id,...p}:null;}).filter(Boolean);
    const dx=dp.x-sp.x,dy=dp.y-sp.y,len=Math.max(1,Math.hypot(dx,dy)),ux=dx/len,uy=dy/len;
    // Start/end just outside the 72px event image / 52px stopwatch destination.
    const src={id:ev.id,x:sp.x+ux*40,y:sp.y+uy*40}, dst={id:ev.to,x:dp.x-ux*31,y:dp.y-uy*31};
    const nx=-uy,ny=ux,mx=(src.x+dst.x)/2,my=(src.y+dst.y)/2;
    let c={x:mx,y:my};
    for(const off of shuffle([42,-42,66,-66,92,-92,120,-120,150,-150,180,-180])){
      const cand={x:mx+nx*off,y:my+ny*off}; if(curveClear(src,dst,cand,all,39)){c=cand;break;}
    }
    return {src,dst,c};
  }
  function bezierPoint(g,t){const u=1-t;return{x:u*u*g.src.x+2*u*t*g.c.x+t*t*g.dst.x,y:u*u*g.src.y+2*u*t*g.c.y+t*t*g.dst.y};}
  function drawArrowOnCanvas(ctx,ev){
    if(!ev.to)return; const g=movementGeometry(ev); if(!g)return;
    const color=ev.type==='red'?'#e31717':'#ffd51f';
    ctx.save();
    // dark under-stroke makes yellow/red dotted routes readable over the pitch and black route line.
    ctx.beginPath(); ctx.moveTo(g.src.x,g.src.y); ctx.quadraticCurveTo(g.c.x,g.c.y,g.dst.x,g.dst.y);
    ctx.setLineDash([2,8]); ctx.lineCap='round'; ctx.strokeStyle='rgba(0,0,0,.72)'; ctx.lineWidth=6; ctx.stroke();
    ctx.beginPath(); ctx.moveTo(g.src.x,g.src.y); ctx.quadraticCurveTo(g.c.x,g.c.y,g.dst.x,g.dst.y);
    ctx.setLineDash([2,8]); ctx.lineCap='round'; ctx.strokeStyle=color; ctx.lineWidth=3.2; ctx.stroke();
    ctx.setLineDash([]);
    const p=bezierPoint(g,.965), q=bezierPoint(g,1), ang=Math.atan2(q.y-p.y,q.x-p.x), size=10;
    ctx.beginPath(); ctx.moveTo(q.x,q.y); ctx.lineTo(q.x-Math.cos(ang-.55)*size,q.y-Math.sin(ang-.55)*size); ctx.lineTo(q.x-Math.cos(ang+.55)*size,q.y-Math.sin(ang+.55)*size); ctx.closePath();
    ctx.fillStyle='rgba(0,0,0,.72)'; ctx.save(); ctx.translate(0,0); ctx.fill(); ctx.restore();
    const inner=8; ctx.beginPath(); ctx.moveTo(q.x,q.y); ctx.lineTo(q.x-Math.cos(ang-.55)*inner,q.y-Math.sin(ang-.55)*inner); ctx.lineTo(q.x-Math.cos(ang+.55)*inner,q.y-Math.sin(ang+.55)*inner); ctx.closePath(); ctx.fillStyle=color; ctx.fill();
    ctx.restore();
  }
  function drawMovementPaths(){
    clearMovementCanvas();
  }
  function buildEvents(){
    const openGoal=Math.random()<0.45; // prototype frequency; max one, never guaranteed
    const total=18+(openGoal?1:0); const firstCount=Math.floor(total/2), secondCount=total-firstCount;
    const slots=shuffle([...chooseSpaced(firstHalf,firstCount),...chooseSpaced(secondHalf,secondCount)]);
    const types=[];
    for(let i=0;i<5;i++)types.push({type:'goal-odd',asset:'goal',cls:'event-goal',title:'Goal Chance · odd roll scores'});
    for(let i=0;i<2;i++)types.push({type:'goal-even',asset:'goal',cls:'event-goal',title:'Goal Chance · even roll scores'});
    for(let i=0;i<2;i++)types.push({type:'free',asset:'free',cls:'event-setpiece',title:'Free Kick',success:chooseSuccess(2,2)});
    for(let i=0;i<2;i++)types.push({type:'penalty',asset:'penalty',cls:'event-setpiece',title:'Penalty',success:chooseSuccess(4,4)});
    for(let i=0;i<2;i++)types.push({type:'yellow',asset:'yellow',cls:'event-card',title:'Yellow Card'});
    types.push({type:'red',asset:'red',cls:'event-card',title:'Red Card'});
    for(let i=0;i<4;i++)types.push({type:'injury',asset:'injury',cls:'event-injury',title:'Injury'});
    if(openGoal)types.push({type:'open',asset:'open',cls:'event-open',title:'Open Goal'});
    const shuffledTypes=shuffle(types);
    return slots.map((id,i)=>({id,...shuffledTypes[i]}));
  }
  function updateReport(events){
    const report=document.querySelector('.live-report-feed'); if(!report)return;
    const open=events.some(e=>e.type==='open');
    report.innerHTML=`<div class="report-entry"><div class="report-icon">🎲</div><div class="report-copy"><div class="report-head">Random board #${generation}</div><div class="report-body">Fresh dynamic layer generated over the locked v70 board. Goal chances 7 · Free kicks 2 · Penalties 2 · Yellow cards 2 · Red cards 1 · Injuries 4 · Open Goal ${open?'1':'0'}.</div></div><div class="report-minute">0'</div></div><div class="report-entry"><div class="report-icon">🧭</div><div class="report-copy"><div class="report-head">Cards & injuries</div><div class="report-body">No coloured movement lines are drawn. In play, Red Card = move 6 spaces forward and pulse the destination red. Yellow Card = move 3 spaces forward and pulse yellow. Injury = move 3 spaces backward and pulse blue. If a forced move lands on a scoring chance, skip to the next valid node. If a forward move would hit 95, land on Full Time.</div></div></div>`;
  }
  function generateBoard(){
    generation++; clearBoard(); currentEvents=buildEvents();
    currentEvents.forEach(ev=>{ if(['yellow','red','injury'].includes(ev.type)) ev.to=destinationFor(ev,currentEvents); addEvent(ev); });
    requestAnimationFrame(()=>requestAnimationFrame(()=>drawMovementPaths()));
    updateReport(currentEvents);
    window.FOOTBALL_FORTUNE_CURRENT_BOARD=currentEvents.map(e=>({...e}));
  }
  function loadBoard(events){
    generation++;
    clearBoard();
    currentEvents=(Array.isArray(events)?events:[]).map(e=>({...e}));
    currentEvents.forEach(addEvent);
    requestAnimationFrame(()=>requestAnimationFrame(()=>drawMovementPaths()));
    updateReport(currentEvents);
    window.FOOTBALL_FORTUNE_CURRENT_BOARD=currentEvents.map(e=>({...e}));
  }
  document.addEventListener('DOMContentLoaded',()=>{
    generateBoard();
    document.getElementById('restartMatchBtn')?.addEventListener('click',()=>setTimeout(generateBoard,0));
    window.addEventListener('resize',()=>drawMovementPaths());
  });
  window.FOOTBALL_FORTUNE_GENERATE_BOARD=generateBoard;
  window.FOOTBALL_FORTUNE_LOAD_BOARD=loadBoard;
  window.FOOTBALL_FORTUNE_RESOLVE_FORCED_MOVE=(eventId,type)=>{
    const event=(window.FOOTBALL_FORTUNE_CURRENT_BOARD||[]).find(e=>e.id===eventId&&e.type===type);
    return event?event.to:null;
  };
})();
</script>

<script id="footballFortuneCoordinateLock">
(() => {
  'use strict';
  const LOCKED_ROUTE_COORDINATES = Object.freeze(
    Object.fromEntries(Object.entries({"kickoff":{"x":9.5,"y":9.0},"m1":{"x":9.0,"y":26.432},"m3":{"x":9.0,"y":39.207},"m5":{"x":9.0,"y":53.451},"m7":{"x":10.084,"y":65.786},"m9":{"x":9.0,"y":79.883},"m11":{"x":13.329,"y":92.0},"m13":{"x":20.88,"y":80.47},"m15":{"x":22.366,"y":63.436},"m17":{"x":17.968,"y":50.661},"m19":{"x":17.719,"y":33.627},"m21":{"x":18.798,"y":18.062},"m23":{"x":27.158,"y":9.985},"m25":{"x":41.702,"y":12.775},"m27":{"x":42.117,"y":25.551},"m29":{"x":29.586,"y":30.396},"m31":{"x":29.42,"y":48.458},"m33":{"x":29.835,"y":67.841},"m35":{"x":31.993,"y":88.253},"m37":{"x":40.913,"y":87.812},"m39":{"x":44.647,"y":70.631},"m41":{"x":37.598,"y":58.527},"m43":{"x":42.075,"y":43.783},"halftime":{"x":50.0,"y":50.0},"m47":{"x":56.0,"y":57.269},"m49":{"x":55.104,"y":74.596},"m51":{"x":57.759,"y":90.749},"m53":{"x":66.639,"y":91.336},"m55":{"x":62.573,"y":70.044},"m57":{"x":65.311,"y":54.185},"m59":{"x":63.734,"y":37.739},"m61":{"x":55.021,"y":29.222},"m63":{"x":54.357,"y":13.95},"m65":{"x":63.568,"y":8.811},"m67":{"x":72.199,"y":9.838},"m69":{"x":67.3,"y":24.229},"m71":{"x":73.527,"y":40.0},"m73":{"x":73.5,"y":54.0},"m75":{"x":72.5,"y":70.5},"m77":{"x":74.5,"y":88.0},"m79":{"x":80.2,"y":76.7},"m81":{"x":80.0,"y":58.0},"m83":{"x":81.0,"y":42.5},"m85":{"x":78.2,"y":27.0},"m87":{"x":86.0,"y":13.0},"m89":{"x":88.0,"y":27.5},"m91":{"x":91.2,"y":44.0},"m93":{"x":90.6,"y":60.5},"m95":{"x":90.0,"y":78.5},"fulltime":{"x":92.0,"y":91.0}}).map(([id, point]) => [id, Object.freeze({ x: point.x, y: point.y })]))
  );
  const applyLockedCoordinate = (el) => {
    const point = LOCKED_ROUTE_COORDINATES[el.dataset.id];
    if (!point) return;
    const left = `${point.x.toFixed(3)}%`;
    const top = `${point.y.toFixed(3)}%`;
    if (el.style.left !== left) el.style.left = left;
    if (el.style.top !== top) el.style.top = top;
  };
  const enforceAll = () => {
    document.querySelectorAll('.coordinate-layer .minute-node[data-id]').forEach(applyLockedCoordinate);
    if (typeof window !== 'undefined' && typeof window.FOOTBALL_FORTUNE_DRAW_LOCKED_ROUTE === 'function') window.FOOTBALL_FORTUNE_DRAW_LOCKED_ROUTE();
  };
  document.addEventListener('DOMContentLoaded', () => {
    enforceAll();
    const layer = document.getElementById('coordinateLayer');
    if (!layer) return;
    const observer = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        if (mutation.type === 'attributes' && mutation.attributeName === 'style' && mutation.target.matches('.minute-node[data-id]')) { applyLockedCoordinate(mutation.target); if (typeof window !== 'undefined' && typeof window.FOOTBALL_FORTUNE_DRAW_LOCKED_ROUTE === 'function') window.FOOTBALL_FORTUNE_DRAW_LOCKED_ROUTE(); }
      }
    });
    observer.observe(layer, { subtree:true, attributes:true, attributeFilter:['style'] });
  });
  const LOCKED_ROUTE_SEQUENCE = Object.freeze([
    'kickoff','m1','m3','m5','m7','m9','m11','m13','m15','m17','m19','m21','m23','m25','m27','m29','m31','m33','m35','m37','m39','m41','m43','halftime','m47','m49','m51','m53','m55','m57','m59','m61','m63','m65','m67','m69','m71','m73','m75','m77','m79','m81','m83','m85','m87','m89','m91','m93','m95','fulltime'
  ]);

  const buildSmoothPath = (points, tension = 0.64) => {
    if (!points.length) return '';
    if (points.length === 1) return `M ${points[0].x} ${points[0].y}`;
    let d = `M ${points[0].x.toFixed(2)} ${points[0].y.toFixed(2)}`;
    for (let i = 0; i < points.length - 1; i++) {
      const p0 = points[i - 1] || points[i];
      const p1 = points[i];
      const p2 = points[i + 1];
      const p3 = points[i + 2] || p2;
      const cp1x = p1.x + ((p2.x - p0.x) / 6) * tension;
      const cp1y = p1.y + ((p2.y - p0.y) / 6) * tension;
      const cp2x = p2.x - ((p3.x - p1.x) / 6) * tension;
      const cp2y = p2.y - ((p3.y - p1.y) / 6) * tension;
      d += ` C ${cp1x.toFixed(2)} ${cp1y.toFixed(2)}, ${cp2x.toFixed(2)} ${cp2y.toFixed(2)}, ${p2.x.toFixed(2)} ${p2.y.toFixed(2)}`;
    }
    return d;
  };

  const getRoutePoints = () => {
    const layer = document.getElementById('coordinateLayer');
    if (!layer) return { layer:null, width:1, height:1, points:[] };
    const width = Math.max(1, layer.clientWidth);
    const height = Math.max(1, layer.clientHeight);
    const points = LOCKED_ROUTE_SEQUENCE.map((id) => {
      const point = LOCKED_ROUTE_COORDINATES[id];
      if (!point) return null;
      return {
        id,
        x: (point.x / 100) * width,
        y: (point.y / 100) * height
      };
    }).filter(Boolean);
    return { layer, width, height, points };
  };

  const getSegmentGeometry = (points, index, tension = 0.64) => {
    const p0 = points[index - 1] || points[index];
    const p1 = points[index];
    const p2 = points[index + 1];
    const p3 = points[index + 2] || p2;
    return {
      p1,
      p2,
      cp1: {
        x: p1.x + ((p2.x - p0.x) / 6) * tension,
        y: p1.y + ((p2.y - p0.y) / 6) * tension
      },
      cp2: {
        x: p2.x - ((p3.x - p1.x) / 6) * tension,
        y: p2.y - ((p3.y - p1.y) / 6) * tension
      }
    };
  };

  const bezierPoint = (segment, t) => {
    const u = 1 - t;
    const { p1, cp1, cp2, p2 } = segment;
    return {
      x: (u*u*u*p1.x) + (3*u*u*t*cp1.x) + (3*u*t*t*cp2.x) + (t*t*t*p2.x),
      y: (u*u*u*p1.y) + (3*u*u*t*cp1.y) + (3*u*t*t*cp2.y) + (t*t*t*p2.y)
    };
  };

  const drawLockedRoute = () => {
    const canvas = document.getElementById('routeCanvas');
    const { width, height, points } = getRoutePoints();
    if (!canvas || !points.length) return;

    const dpr = window.devicePixelRatio || 1;
    canvas.width = Math.round(width * dpr);
    canvas.height = Math.round(height * dpr);
    canvas.style.width = width + 'px';
    canvas.style.height = height + 'px';

    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, width, height);

    ctx.beginPath();
    ctx.moveTo(points[0].x, points[0].y);
    for (let i = 0; i < points.length - 1; i++) {
      const segment = getSegmentGeometry(points, i);
      ctx.bezierCurveTo(
        segment.cp1.x, segment.cp1.y,
        segment.cp2.x, segment.cp2.y,
        segment.p2.x, segment.p2.y
      );
    }

    ctx.strokeStyle = '#111111';
    ctx.lineWidth = 4.5;
    ctx.setLineDash([3, 10]);
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.globalAlpha = 1;
    ctx.stroke();
    ctx.setLineDash([]);
  };

  const getExactNodePixel = (id) => {
    const { width, height } = getRoutePoints();
    const p = LOCKED_ROUTE_COORDINATES[id];
    if (!p) return null;
    return { x:(p.x/100)*width, y:(p.y/100)*height };
  };

  const placePieceOnNode = (piece, id) => {
    const point = getExactNodePixel(id);
    if (!piece || !point) return;
    piece.style.position = 'absolute';
    piece.style.left = point.x + 'px';
    piece.style.top = point.y + 'px';
    piece.style.transform = 'translate(-50%,-50%)';
  };

  const movePieceAlongRoute = (piece, fromId, toId, duration = 650) => {
    if (!piece) return Promise.resolve();
    const { points } = getRoutePoints();
    const fromIndex = points.findIndex(p => p.id === fromId);
    const toIndex = points.findIndex(p => p.id === toId);
    if (fromIndex < 0 || toIndex < 0 || fromIndex === toIndex) {
      placePieceOnNode(piece, toId);
      return Promise.resolve();
    }

    const direction = toIndex > fromIndex ? 1 : -1;
    const segmentIndexes = [];
    if (direction > 0) {
      for (let i = fromIndex; i < toIndex; i++) segmentIndexes.push(i);
    } else {
      for (let i = fromIndex - 1; i >= toIndex; i--) segmentIndexes.push(i);
    }

    const perSegment = duration / Math.max(1, segmentIndexes.length);

    return new Promise(resolve => {
      let segmentCursor = 0;
      let segmentStart = performance.now();

      const tick = (now) => {
        const segIndex = segmentIndexes[segmentCursor];
        const segment = getSegmentGeometry(points, segIndex);
        let t = Math.min(1, (now - segmentStart) / perSegment);
        if (direction < 0) t = 1 - t;
        const point = bezierPoint(segment, t);
        piece.style.position = 'absolute';
        piece.style.left = point.x + 'px';
        piece.style.top = point.y + 'px';
        piece.style.transform = 'translate(-50%,-50%)';

        const doneThisSegment = direction > 0 ? t >= 1 : t <= 0;
        if (doneThisSegment) {
          segmentCursor += 1;
          if (segmentCursor >= segmentIndexes.length) {
            placePieceOnNode(piece, toId); // exact coordinate landing
            resolve();
            return;
          }
          segmentStart = now;
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  };

  document.addEventListener('DOMContentLoaded', () => {
    drawLockedRoute();
    window.addEventListener('resize', drawLockedRoute);
  });

  window.FOOTBALL_FORTUNE_LOCKED_ROUTE_COORDINATES = LOCKED_ROUTE_COORDINATES;
  window.FOOTBALL_FORTUNE_LOCKED_ROUTE_SEQUENCE = LOCKED_ROUTE_SEQUENCE;
  window.FOOTBALL_FORTUNE_DRAW_LOCKED_ROUTE = drawLockedRoute;
  window.FOOTBALL_FORTUNE_ROUTE = Object.freeze({
    sequence: LOCKED_ROUTE_SEQUENCE,
    coordinates: LOCKED_ROUTE_COORDINATES,
    getExactNodePixel,
    placePieceOnNode,
    movePieceAlongRoute
  });
})();
</script>


<script id="footballFortunePlayableV83">
(() => {
  'use strict';
  const ROUTE=['kickoff','m1','m3','m5','m7','m9','m11','m13','m15','m17','m19','m21','m23','m25','m27','m29','m31','m33','m35','m37','m39','m41','m43','halftime','m47','m49','m51','m53','m55','m57','m59','m61','m63','m65','m67','m69','m71','m73','m75','m77','m79','m81','m83','m85','m87','m89','m91','m93','m95','fulltime'];
  const $=s=>document.querySelector(s), wait=ms=>new Promise(r=>setTimeout(r,ms));
  let state;
  function getMatchMode(){
    const params=new URLSearchParams(window.location.search);
    const raw=(params.get('mode')||localStorage.getItem('footballFortuneMatchMode')||'friendly').toLowerCase();
    if(raw==='league')return 'season';
    return ['friendly','tournament','season'].includes(raw)?raw:'friendly';
  }
  function drawNeedsShootout(){const m=getMatchMode();return m==='friendly'||m==='tournament';}
  function updateMatchModeTitle(){
    const el=$('#ffMatchTitle'); if(!el)return;
    const m=getMatchMode();
    if(m==='tournament'){const round=new URLSearchParams(window.location.search).get('round');el.textContent=round?`Tournament: ${round.replace(/(^|[- ])\w/g,x=>x.toUpperCase())}`:'Tournament: Match Day';}
    else if(m==='season'){const game=new URLSearchParams(window.location.search).get('game');el.textContent=game?`Season: Match ${game}`:'Season: Match Day';}
    else el.textContent='Friendly: Match Day';
  }
  const other=p=>p==='blue'?'red':'blue';
  function managerProfile(){
    try{
      return window.FOOTBALL_FORTUNE_PLAYER_PROFILE
        || JSON.parse(localStorage.getItem('footballFortunePlayerProfile')||'null')
        || {};
    }catch(e){return {};}
  }
  function managerSurname(){
    const profile=managerProfile();
    const surname=(profile?.surname||'').trim();
    if(surname)return surname;
    const full=(profile?.fullName||'').trim();
    if(full&&full!=='Player'){
      const parts=full.split(/\s+/);
      return parts[parts.length-1]||'the manager';
    }
    return 'the manager';
  }
  function managerPronouns(){
    const profile=managerProfile();
    return profile?.gender==='female'
      ? {subject:'she',object:'her',possessive:'her'}
      : {subject:'he',object:'him',possessive:'his'};
  }
  function teamName(p){
    const names=document.querySelectorAll('.team-name');
    const raw=p==='blue'?(names[0]?.textContent||'Home Team'):(names[1]?.textContent||'Away Team');
    return raw?.trim()|| (p==='blue'?'Home Team':'Away Team');
  }
  const token=p=>p==='blue'?$('#bluePlayerToken'):$('#redPlayerToken');
  const node=id=>document.querySelector(`.minute-node[data-id="${id}"]`);
  function minuteFor(id){ if(id==='kickoff')return 0;if(id==='halftime')return 45;if(id==='fulltime')return 95; const m=id.match(/^m(\d+)/); return m?+m[1]:0; }
  function eventAt(id){ return (window.FOOTBALL_FORTUNE_CURRENT_BOARD||[]).find(e=>e.id===id)||null; }
  function scoreEls(){ const s=document.querySelectorAll('.score span'); return {b:s[0],r:s[2]}; }
  function updateScoreboardDetails(){
    const board=document.querySelector('.scoreboard.compact-scoreboard');
    const shootout=state?.phase==='shootout'&&state.shootout;
    const renderPenaltyMarks=(team,selector)=>{
      const el=$(selector);if(!el)return;
      el.innerHTML='';el.classList.add('ff-penalty-marks');
      const kicks=state.shootout.kicks[team]||[];
      const slots=Math.max(5,kicks.length);
      for(let i=0;i<slots;i++){
        const dot=document.createElement('span');
        const result=kicks[i];
        dot.className='ff-pen-progress-dot'+(i>=5?' extra':'')+(result===true?' goal':result===false?' miss':'');
        dot.textContent=result===true?'✓':result===false?'×':'';
        dot.setAttribute('aria-label',result===true?`Penalty ${i+1}: scored`:result===false?`Penalty ${i+1}: missed`:`Penalty ${i+1}: not taken`);
        el.appendChild(dot);
      }
    };
    if(shootout){
      board?.classList.add('ff-shootout-scoreboard');
      renderPenaltyMarks('blue','#homeScorers');
      renderPenaltyMarks('red','#awayScorers');
      const ht=$('.half-time-score');
      if(ht)ht.textContent=`PENS ${state.shootout.goals.blue}–${state.shootout.goals.red}`;
      return;
    }
    board?.classList.remove('ff-shootout-scoreboard');
    const render=(team,selector)=>{
      const el=$(selector); if(!el)return; el.innerHTML='';el.classList.remove('ff-penalty-marks');
      (state.scorers?.[team]||[]).forEach(goal=>{
        const row=document.createElement('div'); row.className='scorer-entry';
        row.innerHTML=`${goal.name}<span class="minute">(${goal.minute}')</span>`;
        el.appendChild(row);
      });
      el.scrollTop=el.scrollHeight;
    };
    render('blue','#homeScorers');
    render('red','#awayScorers');
    const ht=$('.half-time-score');
    if(ht)ht.textContent=state.halfTimeScore?`(HT ${state.halfTimeScore.blue}–${state.halfTimeScore.red})`:'';
  }
  function updateScore(){const e=scoreEls(); if(e.b)e.b.textContent=state.score.blue;if(e.r)e.r.textContent=state.score.red;updateScoreboardDetails();}
  function recordGoalFromCommentary(player,commentary,kind='goal'){
    const numberMatch=commentary.match(/Number\s+(\d+)/i);
    const ownGoal=/own net|own goal/i.test(commentary);
    const number=ownGoal?null:Number(numberMatch?numberMatch[1]:shirtNumber('attacker',player));
    const name=ownGoal?'Own goal':`No. ${number}`;
    const assistNumber=ownGoal?null:chooseAssistNumber(player,number,commentary,kind);
    const goal={name,number,minute:currentMinute(),assistNumber};
    state.scorers[player].push(goal);
    updateScoreboardDetails();
    return goal;
  }
  function currentMinute(){return Math.max(minuteFor(ROUTE[state.pos.blue]),minuteFor(ROUTE[state.pos.red]));}
  function updateClock(){ const m=currentMinute(); const t=`${m}'`; $('.match-minute').textContent=t; const l=$('.live-clock'); if(l)l.textContent=t; }

  async function callHalfTime(){
    if(state.halfTimeCalled)return;
    state.halfTimeCalled=true;
    state.halfTimeScore={...state.score};
    $('.half-time-score').textContent=`(HT ${state.score.blue}–${state.score.red})`;
    report(null,'HALF TIME',halfTimeCommentary(),'⏸️',45);await wait(700);
  }
  let lastReportCommentary='';
  function uniqueReportCommentary(text,title,player){
    const clean=(text||'').trim();
    if(clean!==lastReportCommentary) return clean;

    const team=player?teamName(player):'';
    const fallbacks = /GOAL/i.test(title) ? [
      `${team||'They'} make the moment count as the match swings again.`,
      `Another decisive moment, and the scoreboard changes once more.`,
      `${team||'The attacking side'} are celebrating again as play restarts.`
    ] : /MISS|CHANCE|FREE KICK|PENALTY/i.test(title) ? [
      `Another opening comes and goes as the pressure continues.`,
      `The chance passes, but the game remains finely balanced.`,
      `A fresh opportunity, but this one does not alter the score.`
    ] : /YELLOW|RED|INJURY/i.test(title) ? [
      `Another incident interrupts the flow of the match.`,
      `Play pauses again before the game can settle.`,
      `A different flashpoint now as the referee restores order.`
    ] : /HALF TIME|FULL TIME/i.test(title) ? [
      `The whistle brings another phase of the match to a close.`,
      `A pause in play as the teams take stock of where things stand.`,
      `The match reaches another key stopping point.`
    ] : [
      `Play develops differently this time as the match moves on.`,
      `Another passage of play unfolds as both sides keep pushing.`,
      `The game moves into its next moment with the tempo still building.`
    ];

    const alternatives=fallbacks.filter(line=>line!==lastReportCommentary);
    return alternatives[Math.floor(Math.random()*alternatives.length)];
  }
  function report(player,title,text,icon='🎙️',minute=null){
    const feed=$('.live-report-feed'); if(!feed)return;
    const m=minute??currentMinute();
    const commentary=uniqueReportCommentary(text,title,player);
    lastReportCommentary=commentary;
    const e=document.createElement('div');
    e.className='report-entry';
    const minuteOnlyTitle=/^\d+'$/.test(String(title).trim());
    const reportHeading=player
      ? `${teamName(player)}${minuteOnlyTitle?'':' · '+title}`
      : title;
    e.innerHTML=`<div class="report-icon">${icon}</div><div class="report-copy"><div class="report-head">${reportHeading}</div><div class="report-body">${commentary}</div></div><div class="report-minute">${m}'</div>`;
    feed.prepend(e);
    feed.scrollTop=0;

    // Keep lightweight match-flow stats so commentary can describe the game,
    // not just isolated events. These are deliberately based on reported moments.
    if(state){
      state.matchFlow=state.matchFlow||{goals:0,chances:0,cards:0,reds:0,injuries:0};
      if(/GOAL!/i.test(title)) state.matchFlow.goals++;
      if(/GOAL CHANCE|OPEN GOAL|PENALTY!|FREE KICK!|95TH-MINUTE DRAMA/i.test(title)) state.matchFlow.chances++;
      if(/YELLOW CARD|RED CARD/i.test(title)) state.matchFlow.cards++;
      if(/RED CARD/i.test(title)) state.matchFlow.reds++;
      if(/INJURY/i.test(title)) state.matchFlow.injuries++;

      state.summaryEvents=state.summaryEvents||[];
      if(/GOAL!|YELLOW CARD|RED CARD|INJURY|PENALTY MISSED|FREE KICK MISSED|CHANCE MISSED/i.test(title)){
        state.summaryEvents.push({player,title,commentary,minute:m,icon});
      }
    }
    if(typeof ffScheduleAutosave==='function')ffScheduleAutosave('match-event');
  }
  function placeTokens(){
    const same=state.pos.blue===state.pos.red;
    ['blue','red'].forEach(p=>{ const el=token(p), id=ROUTE[state.pos[p]]; window.FOOTBALL_FORTUNE_ROUTE.placePieceOnNode(el,id); el.style.marginLeft=same?(p==='blue'?'-13px':'13px'):'0px'; el.classList.toggle('active',state.current===p&&!state.finished);});
    $('#ffTurnPill').textContent=state.finished?'Full time':`${state.current==='blue'?'Blue':'Red'} team to roll`;
  }
  function renderEventTargets(numbers){
    const wrap=$('#ffEventTargets'); if(!wrap)return;
    const label=$('#ffEventTargetsLabel'), box=$('#ffEventTargetBox');
    wrap.innerHTML='';
    if(!numbers||!numbers.length){wrap.classList.add('hidden'); if(label)label.classList.add('hidden'); if(box)box.classList.add('hidden'); return;}
    const uniqueSorted=[...new Set(numbers)].sort((a,b)=>a-b);
    uniqueSorted.forEach(num=>{
      const chip=document.createElement('span');
      chip.className='ff-target-chip hit';
      chip.textContent=String(num);
      wrap.appendChild(chip);
    });
    wrap.classList.remove('hidden');
    if(label)label.classList.remove('hidden');
    if(box)box.classList.remove('hidden');
  }
  function chanceModalCommentary(kind,team){
    if(kind==='goal-odd')return pick([
      `${team} are through on goal. Roll one of the yellow odd numbers to score!`,
      `Big chance for ${team}. An odd number puts the ball in the net.`,
      `${team} have a clear sight of goal. Hit a yellow odd number to score.`
    ]);
    if(kind==='goal-even')return pick([
      `${team} are through on goal. Roll one of the yellow even numbers to score!`,
      `Big chance for ${team}. An even number puts the ball in the net.`,
      `${team} have a clear sight of goal. Hit a yellow even number to score.`
    ]);
    if(kind==='free')return pick([
      `A free kick in a dangerous position for ${team}! Can they find the top corner?`,
      `${team} have a free kick in a dangerous position. Can they beat the wall and the keeper?`,
      `Big free-kick chance for ${team}. Can they find the top corner?`
    ]);
    return pick([
      `Penalty to ${team}! Roll one of the yellow numbers and they score.`,
      `${team} have a huge penalty chance. Four numbers out of six will score here.`,
      `Big pressure moment for ${team}. Hit a yellow number to smash home the penalty!`
    ]);
  }
  function updateStandardDiceAvailability(){
    const card=$('#ffStandardDiceCard'), btn=$('#ffSidebarRollBtn');
    if(!card||!btn||!state)return;
    const activeTeam=state.phase==='shootout'&&state.shootout?.current?state.shootout.current:state.current;
    const teamLabel=activeTeam==='red'?'RED TEAM':'BLUE TEAM';
    const kicker=$('#ffStandardDiceKicker'); if(kicker)kicker.textContent=teamLabel;
    card.classList.remove('team-blue','team-red');
    card.classList.add(activeTeam==='red'?'team-red':'team-blue');
    const specialChance=state.phase==='chance'&&!state.finished;
    const shootoutReady=state.phase==='shootout'&&state.shootout?.choice&&!state.shootout?.winner;
    const enabled=!state.busy&&!state.finished&&(state.phase==='move'||state.phase==='chance'||shootoutReady);
    btn.disabled=!enabled;
    card.classList.toggle('disabled',state.finished||(state.phase==='shootout'&&!shootoutReady));
    btn.setAttribute('aria-label',enabled?(shootoutReady?`Take penalty for ${teamName(state.shootout.current)}`:specialChance?`Roll dice for ${teamName(state.current)} chance`:`Roll dice for ${teamName(state.current)}`):(state.finished?'Match complete':state.phase==='shootout'?'Choose a direction first':'Dice rolling'));
    $('#ffSidebarDiceHint').textContent=state.busy?'Rolling…':(shootoutReady?'Click dice to take penalty':state.phase==='shootout'?'Choose a direction':specialChance?'Click dice to shoot':'Click dice to roll');
  }
  function updateStandardDiceTurn(title=''){
    const activeTeam=state.phase==='shootout'&&state.shootout?.current?state.shootout.current:state.current;
    const teamLabel=activeTeam==='red'?'RED TEAM':'BLUE TEAM';
    const el=$('#ffStandardDiceTitle'); if(el)el.textContent='';
    const kicker=$('#ffStandardDiceKicker'); if(kicker)kicker.textContent=teamLabel;
    const restore=$('#ffDiceRestoreLabel'); if(restore)restore.textContent='Roll the dice';
    const card=$('#ffStandardDiceCard');
    if(card){
      card.classList.remove('team-blue','team-red');
      card.classList.add(activeTeam==='red'?'team-red':'team-blue');
    }
    // Every new standard turn begins from the same approved three-face starting view.
    // Do not let the previous landed face or hover state carry into the next turn.
    if(state.phase==='move'&&!state.busy&&!state.finished){
      const die=$('#ffSidebarDie');
      if(die){
        die.classList.remove('rolling');
        die.style.transform='rotateX(-15deg) rotateY(25deg)';
      }
    }
  }
  function setModal(kicker,title,rule='',button='ROLL DICE',show=true,opts=null){
    const m=$('#ffGameModal'), card=m.querySelector('.ff-game-card');
    const isChance=!!opts?.kind || kicker==='95TH MINUTE';
    const isEnd=kicker==='FULL TIME';
    const showCentral=show&&(isChance||isEnd);
    card.classList.toggle('roll-info-mode',isChance);
    m.classList.toggle('hidden',!showCentral);
    m.setAttribute('aria-hidden',showCentral?'false':'true');
    $('#ffGameKicker').textContent=kicker;
    $('#ffGameTitle').textContent=title;
    const ruleEl=$('#ffGameRule');
    ruleEl.textContent=rule||'';
    ruleEl.classList.toggle('hidden',!rule);
    $('#ffRollBtn').textContent=button;
    updateStandardDiceTurn(isChance?'':title);

    const hero=$('#ffEventHero'), heroImg=$('#ffEventHeroImg');
    if(opts?.kind){
      card.classList.add('event-mode');
      card.classList.toggle('free-kick-mode',opts.kind==='free');
      hero.classList.remove('hidden');
      heroImg.src=opts.kind==='free'?'data:image/png;base64,