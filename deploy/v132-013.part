" alt="Football Fortune players celebrating"></div>
      </div>
      <div class="ffj-auth-panel">
        <div class="ffj-auth-inner">
          <div class="ffj-tabs">
            <button class="ffj-tab active" id="ffjLoginTab" type="button">LOG IN</button>
            <button class="ffj-tab" id="ffjSignupTab" type="button">SIGN UP</button>
          </div>

          <div class="ffj-auth-pane active" id="ffjLoginPane">
            <div class="ffj-eyebrow">Secure sign in</div>
            <h1>Welcome back</h1>
            <p class="ffj-lead">Log in to continue your Football Fortune journey.</p>
            <div class="ffj-field"><label>Email address</label><input class="ffj-input" id="ffjLoginEmail" type="email" placeholder="name@example.com"></div>
            <div class="ffj-field"><label>Password</label><div class="ffj-password-wrap"><input class="ffj-input" id="ffjLoginPassword" type="password" placeholder="Your password"><button class="ffj-password-eye" data-password-target="ffjLoginPassword" type="button" aria-label="Show password" title="Show password"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6S2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="2.7"/></svg></button></div></div>
            <div class="ffj-row">
              <label class="ffj-check"><input id="ffjRememberMe" type="checkbox" checked> Remember me</label>
              <button class="ffj-link" id="ffjForgotBtn" type="button">Forgot password?</button>
            </div>
            <button class="ffj-primary" id="ffjLoginBtn" type="button">LOG IN</button>
            <div class="ffj-message" id="ffjLoginMessage"></div>
          </div>

          <div class="ffj-auth-pane" id="ffjSignupPane">
            <div class="ffj-eyebrow">Create account</div>
            <h1>Join Football Fortune</h1>
            <p class="ffj-lead">Start your Football Fortune career.</p>
            <div class="ffj-field"><label>First name</label><input class="ffj-input" id="ffjSignupFirstName" type="text" autocomplete="given-name" placeholder="e.g. Freddie"></div>
            <div class="ffj-field"><label>Surname</label><input class="ffj-input" id="ffjSignupSurname" type="text" autocomplete="family-name" placeholder="e.g. Uttley"></div>
            <div class="ffj-field"><label>Email address</label><input class="ffj-input" id="ffjSignupEmail" type="email" autocomplete="email" placeholder="name@example.com"></div>
            <div class="ffj-field"><label>Password</label><div class="ffj-password-wrap"><input class="ffj-input" id="ffjSignupPassword" type="password" autocomplete="new-password" placeholder="At least 8 characters"><button class="ffj-password-eye" data-password-target="ffjSignupPassword" type="button" aria-label="Show password" title="Show password"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6S2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="2.7"/></svg></button></div></div>
            <div class="ffj-field">
              <label>Player gender</label>
              <div class="ffj-character-row">
                <button class="ffj-character active" data-ffj-gender="male" type="button">MALE</button>
                <button class="ffj-character" data-ffj-gender="female" type="button">FEMALE</button>
              </div>
            </div>
            <button class="ffj-primary" id="ffjSignupBtn" type="button">CREATE ACCOUNT</button>
            <div class="ffj-message" id="ffjSignupMessage"></div>
          </div>

          <div class="ffj-auth-pane" id="ffjForgotPane">
            <div class="ffj-eyebrow">Password reset</div>
            <h1>Forgot your password?</h1>
            <p class="ffj-lead">Enter your email and we'll send a secure reset link.</p>
            <div class="ffj-field"><label>Email address</label><input class="ffj-input" id="ffjForgotEmail" type="email" placeholder="name@example.com"></div>
            <button class="ffj-primary" id="ffjResetBtn" type="button">SEND RESET LINK</button>
            <button class="ffj-secondary" style="width:100%;margin-top:10px" id="ffjBackLoginBtn" type="button">BACK TO LOGIN</button>
            <div class="ffj-message" id="ffjForgotMessage"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="ffj-view" id="ffjContractView">
    <div class="ffj-contract-stage">
      <div class="ffj-contract-art" aria-label="Football Fortune contract signing">
        <img class="ffj-contract-signing-image" id="ffjContractSigningImage" src="data:image/jpeg;base64," data-male-src="data:image/jpeg;base64," data-female-src="data:image/jpeg;base64," alt="Male Football Fortune player signing a contract">
        <div class="ffj-contract-welcome-overlay">
          <h1 class="ffj-contract-hello">Welcome,<span id="ffjContractPlayer">Player Name!</span></h1>
        </div>
      </div>
      <div class="ffj-contract-news">
        <div class="ffj-eyebrow">Transfer news</div>
        <h1>Football Fortune finally land <span id="ffjContractHeadlineName">Player Name</span></h1>
        <div class="ffj-contract-news-copy">
          <p>Football Fortune are delighted to finally get the signature of <strong id="ffjContractStoryName">Player Name</strong> on a five-year deal.</p>
          <p>Fans are really excited to see what <strong id="ffjContractStorySurname">the new signing</strong> can achieve. Expectations are already building as a brand-new Football Fortune career gets underway.</p>
        </div>
        <button class="ffj-primary" id="ffjContractContinueBtn" type="button">CONTINUE</button>
      </div>
    </div>
  </section>

  <section class="ffj-view" id="ffjLandingView">
    <header class="ff-appbar ffj-landing-appbar">
      <div class="ff-appbar-title" id="ffjLandingTopbarLogo" aria-label="Football Fortune"></div>
      <div class="ff-appbar-actions">
        <div class="ff-menu-wrap">
          <button class="ff-menu-btn" id="ffjLandingMenuBtn" type="button" aria-expanded="false" aria-controls="ffjLandingMenuPanel">☰ Menu</button>
          <div class="ff-menu-panel hidden" id="ffjLandingMenuPanel" role="menu" aria-hidden="true">
            <button class="ff-menu-item ff-menu-logout" id="ffjLandingLogoutBtn" type="button" role="menuitem">
              <span class="ff-menu-item-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M10 5H6.5A2.5 2.5 0 0 0 4 7.5v9A2.5 2.5 0 0 0 6.5 19H10" stroke-width="2" stroke-linecap="round"/>
                  <path d="M13 8l4 4-4 4M17 12H9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Log out</span>
            </button>
          </div>
        </div>
        <button class="ff-icon-btn ff-home-btn" id="ffjLandingHomeBtn" type="button" aria-label="Home" title="Home">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3.5 10.5 12 3.5l8.5 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M5.5 9.5V20h13V9.5M9.5 20v-6h5v6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </header>
    <div class="ffj-landing-wrap">
      <main class="ffj-landing-main">
        <div class="ffj-landing-inner">
        <div class="ffj-eyebrow">Your football story starts here</div>
        <h1 id="ffjWelcome">Welcome back!</h1>
        <p class="ffj-landing-sub">Choose how you want to continue your Football Fortune career.</p>
        <div class="ffj-grid">
          <button class="ffj-home-card primary" id="ffjNewGameBtn" type="button">
            <span class="ffj-card-icon">⚽</span>
            <span class="ffj-card-copy"><strong>New Game</strong><span>Choose Friendly, Tournament or League and kick off a new challenge.</span></span>
            <span class="ffj-arrow">→</span>
          </button>
          <button class="ffj-home-card" id="ffjContinueBtn" type="button">
            <span class="ffj-card-icon">▶</span>
            <span class="ffj-card-copy"><strong>Continue Recent</strong><span id="ffjContinueDetail">No recent Friendly save yet.</span></span>
            <span class="ffj-arrow">→</span>
          </button>
          <button class="ffj-home-card" id="ffjLoadBtn" type="button">
            <span class="ffj-card-icon">▣</span>
            <span class="ffj-card-copy"><strong>Load Game</strong><span id="ffjLoadDetail">Open a saved Friendly with match time, score and date.</span></span>
            <span class="ffj-arrow">→</span>
          </button>
        </div>
        </div>
      </main>
      <aside class="ffj-landing-hero" aria-label="Football Fortune players">
        <div class="ffj-landing-art"></div>
      </aside>
    </div>
  </section>

  <div class="ffj-save-backdrop hidden" id="ffjLoadBackdrop" aria-hidden="true">
    <section class="ffj-save-panel" role="dialog" aria-modal="true" aria-labelledby="ffjLoadTitle">
      <div class="ffj-save-head">
        <div>
          <div class="ffj-save-kicker">SAVED GAMES</div>
          <h2 id="ffjLoadTitle">Load a Friendly</h2>
          <p>Pick a saved match to return to the exact score, minute, pitch and match report.</p>
        </div>
        <button class="ffj-save-close" id="ffjLoadCloseBtn" type="button" aria-label="Close">×</button>
      </div>
      <div class="ffj-save-list" id="ffjSaveList"></div>
    </section>
  </div>

  <div class="ffj-mode-backdrop hidden" id="ffjModeBackdrop">
    <header class="ff-appbar">
      <div class="ff-appbar-title" id="ffjModeTopbarLogo" aria-label="Football Fortune"></div>
      <div class="ff-appbar-actions">
        <div class="ff-menu-wrap">
          <button class="ff-menu-btn" id="ffjModeMenuBtn" type="button" aria-expanded="false" aria-controls="ffjModeMenuPanel">☰ Menu</button>
          <div class="ff-menu-panel hidden" id="ffjModeMenuPanel" role="menu" aria-hidden="true">
            <button class="ff-menu-item ff-menu-logout" id="ffjModeLogoutBtn" type="button" role="menuitem">
              <span class="ff-menu-item-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M10 5H6.5A2.5 2.5 0 0 0 4 7.5v9A2.5 2.5 0 0 0 6.5 19H10" stroke-width="2" stroke-linecap="round"/>
                  <path d="M13 8l4 4-4 4M17 12H9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Log out</span>
            </button>
          </div>
        </div>
        <button class="ff-icon-btn ff-home-btn" id="ffjModeHomeBtn" type="button" aria-label="Home" title="Home">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3.5 10.5 12 3.5l8.5 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M5.5 9.5V20h13V9.5M9.5 20v-6h5v6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </header>
    <div class="ffj-mode-shell">
      <main class="ffj-mode-content">
        <div class="ffj-mode-content-inner">
          <button class="ffj-mode-back" id="ffjModeBackBtn" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/><path d="M8 12h11"/></svg>
            <span>Back</span>
          </button>
          <h2>Choose your mode</h2>
          <p class="ffj-mode-intro">Every Football Fortune story starts differently. Jump into a one-off match now, with Tournament and League ready to grow into your longer career.</p>
          <div class="ffj-modes">
            <button class="ffj-mode active" id="ffjFriendlyBtn" type="button">
              <div class="ffj-mode-icon">🤝</div>
              <div class="ffj-mode-copy"><strong>Friendly</strong><p>Play a standalone match on the full dynamic Football Fortune pitch.</p></div>
              <div class="ffj-mode-cta">Play now →</div>
            </button>
            <button class="ffj-mode active ffj-mode-tournament" id="ffjTournamentBtn" type="button">
              <div class="ffj-mode-icon">🏆</div>
              <div class="ffj-mode-copy"><strong>Tournament</strong><p>Build a 4, 8 or 16-country knockout draw and chase the final trophy.</p></div>
              <div class="ffj-mode-cta">Set up →</div>
            </button>
            <div class="ffj-mode disabled">
              <div class="ffj-mode-icon">📈</div>
              <div class="ffj-mode-copy"><strong>League</strong><p>Build your career, earn promotion and climb through the divisions.</p></div>
              <div class="ffj-mode-cta ffj-mode-disabled-label">Coming later</div>
            </div>
          </div>
        </div>
      </main>
      <aside class="ffj-mode-visual" aria-label="Football Fortune players">
        <div class="ffj-mode-art" id="ffjModeArt"></div>
      </aside>
    </div>
  </div>
</div>


<div class="ffj-tournament-screen hidden" id="ffjTournamentSetup" aria-hidden="true">
  <header class="ff-appbar">
    <div class="ff-appbar-title" id="ffjTournamentSetupLogo" aria-label="Football Fortune"></div>
    <div class="ff-appbar-actions">
      <div class="ff-menu-wrap">
        <button class="ff-menu-btn" id="ffjTournamentSetupMenuBtn" type="button" aria-expanded="false" aria-controls="ffjTournamentSetupMenu">☰ Menu</button>
        <div class="ff-menu-panel hidden" id="ffjTournamentSetupMenu" role="menu" aria-hidden="true">
          <button class="ff-menu-item ff-menu-logout" id="ffjTournamentSetupLogoutBtn" type="button" role="menuitem">
            <span class="ff-menu-item-icon" aria-hidden="true">↪</span><span>Log out</span>
          </button>
        </div>
      </div>
      <button class="ff-icon-btn ff-home-btn" id="ffjTournamentSetupHomeBtn" type="button" aria-label="Home" title="Home">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3.5 10.5 12 3.5l8.5 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M5.5 9.5V20h13V9.5M9.5 20v-6h5v6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </header>
  <div class="ffj-tournament-setup-shell">
    <main class="ffj-tournament-setup-main">
      <div class="ffj-tournament-setup-inner">
        <div class="ffj-tournament-kicker">TOURNAMENT</div>
        <h1>Create your tournament</h1>
        <p class="ffj-tournament-intro">Choose the kind of knockout competition you want to enter, select your team and set the draw size. Every match must produce a winner.</p>

        <section class="ffj-tournament-field">
          <div class="ffj-tournament-field-head">
            <div><strong>Tournament type</strong><span>Play an international tournament or take a club into a domestic or European cup.</span></div>
          </div>
          <div class="ffj-tournament-type-options" role="radiogroup" aria-label="Tournament type">
            <button class="ffj-tournament-type-option selected" type="button" data-tournament-type="countries" aria-pressed="true">Countries</button>
            <button class="ffj-tournament-type-option" type="button" data-tournament-type="clubs" aria-pressed="false">Clubs</button>
          </div>
          <div class="ffj-club-scope hidden" id="ffjClubScope">
            <div class="ffj-tournament-field-head ffj-tournament-subhead">
              <div><strong>Club competition</strong><span>Choose whether the draw stays domestic or includes clubs from across Europe.</span></div>
            </div>
            <div class="ffj-tournament-type-options" role="radiogroup" aria-label="Club competition">
              <button class="ffj-tournament-type-option selected" type="button" data-club-scope="domestic" aria-pressed="true">Domestic</button>
              <button class="ffj-tournament-type-option" type="button" data-club-scope="european" aria-pressed="false">European</button>
            </div>
          </div>
        </section>

        <section class="ffj-tournament-field">
          <div class="ffj-tournament-field-head">
            <div><strong id="ffjTournamentTeamLabel">Your nation</strong><span id="ffjTournamentTeamHelp">Choose the nation you will manage throughout the tournament.</span></div>
          </div>
          <label class="ffj-country-select-wrap">
            <span class="sr-only" id="ffjTournamentTeamSr">Choose your team</span>
            <span class="ffj-team-select-badge" id="ffjTournamentSelectedBadge" aria-hidden="true"></span>
            <select id="ffjTournamentCountry" class="ffj-country-select" aria-labelledby="ffjTournamentTeamLabel"></select>
          </label>
        </section>

        <section class="ffj-tournament-field">
          <div class="ffj-tournament-field-head">
            <div><strong>Tournament size</strong><span>The draw automatically starts at the correct knockout round.</span></div>
          </div>
          <div class="ffj-size-options" role="radiogroup" aria-label="Tournament size">
            <button class="ffj-size-option" type="button" data-tournament-size="4" aria-pressed="false">
              <strong>4</strong><span>Semi-finals</span>
            </button>
            <button class="ffj-size-option" type="button" data-tournament-size="8" aria-pressed="false">
              <strong>8</strong><span>Quarter-finals</span>
            </button>
            <button class="ffj-size-option selected" type="button" data-tournament-size="16" aria-pressed="true">
              <strong>16</strong><span>Round of 16</span>
            </button>
          </div>
        </section>

        <div class="ffj-tournament-setup-actions">
          <button class="ffj-secondary-action" id="ffjTournamentBackBtn" type="button">Back to modes</button>
          <button class="ffj-primary-action" id="ffjGenerateTournamentBtn" type="button">Generate draw →</button>
        </div>
      </div>
    </main>
    <aside class="ffj-tournament-setup-side">
      <div class="ffj-trophy-mark">🏆</div>
      <strong id="ffjTournamentSetupCompetitionName">Fortune Nations Cup</strong>
      <p id="ffjTournamentSetupCompetitionCopy">A single-elimination international tournament. Draws go to penalties and only one nation can lift the trophy.</p>
      <div class="ffj-tournament-path-preview">
        <span>Round</span><i></i><span>Next round</span><i></i><span>Final</span>
      </div>
    </aside>
  </div>
</div>

<div class="ffj-tournament-screen hidden" id="ffjTournamentHub" aria-hidden="true">
  <header class="ff-appbar ffj-tournament-appbar">
    <div class="ff-appbar-title" id="ffjTournamentTitle">Tournament · Draw</div>
    <div class="ff-appbar-actions">
      <button class="ghost ffj-tournament-nav active" id="ffjTournamentBracketBtn" type="button">🏆 Tournament</button>
      <button class="ghost ffj-tournament-nav" id="ffjTournamentScorersBtn" type="button">⚽ Top scorers</button>
      <button class="ghost ffj-tournament-nav" id="ffjTournamentAssistsBtn" type="button">🎯 Top assists</button>
      <div class="ff-menu-wrap">
        <button class="ff-menu-btn" id="ffjTournamentMenuBtn" type="button" aria-expanded="false" aria-controls="ffjTournamentMenu">☰ Menu</button>
        <div class="ff-menu-panel hidden" id="ffjTournamentMenu" role="menu" aria-hidden="true">
          <button class="ff-menu-item" id="ffjTournamentNewDrawBtn" type="button" role="menuitem">
            <span class="ff-menu-item-icon" aria-hidden="true">↻</span><span>New tournament</span>
          </button>
          <button class="ff-menu-item ff-menu-logout" id="ffjTournamentLogoutBtn" type="button" role="menuitem">
            <span class="ff-menu-item-icon" aria-hidden="true">↪</span><span>Log out</span>
          </button>
        </div>
      </div>
      <button class="ff-icon-btn ff-home-btn" id="ffjTournamentHomeBtn" type="button" aria-label="Home" title="Home">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3.5 10.5 12 3.5l8.5 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M5.5 9.5V20h13V9.5M9.5 20v-6h5v6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </header>

  <main class="ffj-tournament-hub-main">
    <section class="ffj-tournament-panel active" id="ffjTournamentBracketPanel">
      <div class="ffj-tournament-summary">
        <div>
          <div class="ffj-tournament-kicker">FORTUNE NATIONS CUP</div>
          <h1 id="ffjTournamentHeading">Tournament draw</h1>
          <p id="ffjTournamentSummaryText">Your route to the final.</p>
        </div>
        <div class="ffj-user-country-chip" id="ffjUserCountryChip"></div>
      </div>
      <div class="ffj-bracket-scroll">
        <div class="ffj-bracket" id="ffjBracket">
          <svg class="ffj-bracket-lines" id="ffjBracketLines" aria-hidden="true"></svg>
          <div class="ffj-bracket-grid" id="ffjBracketGrid"></div>
        </div>
      </div>
    </section>

    <section class="ffj-tournament-panel" id="ffjTournamentScorersPanel">
      <div class="ffj-stats-head">
        <div><div class="ffj-tournament-kicker">TOURNAMENT STATS</div><h1>Top scorers</h1><p>Goals across every match in this tournament will appear here.</p></div>
      </div>
      <div class="ffj-stats-empty">⚽ <strong>No goals yet</strong><span>Player statistics will populate as tournament matches are played or simulated.</span></div>
    </section>

    <section class="ffj-tournament-panel" id="ffjTournamentAssistsPanel">
      <div class="ffj-stats-head">
        <div><div class="ffj-tournament-kicker">TOURNAMENT STATS</div><h1>Top assists</h1><p>Creators across every match in this tournament will appear here.</p></div>
      </div>
      <div class="ffj-stats-empty">🎯 <strong>No assists yet</strong><span>Assists will be tracked across the whole knockout competition.</span></div>
    </section>
  </main>
</div>


<div class="app">
  <header class="ff-appbar">
    <div class="ff-appbar-title" id="ffMatchTitle">Friendly: Match Day</div>
    <div class="ff-appbar-actions">
      <button class="ghost" id="quickSimBtn" type="button">⚡ Quick Sim</button>
      <button class="ghost" id="restartMatchBtn" type="button">New Match</button>
      <div class="ff-menu-wrap">
        <button class="ff-menu-btn" id="ffMenuBtn" type="button" aria-expanded="false" aria-controls="ffMenuPanel">☰ Menu</button>
        <div class="ff-menu-panel hidden" id="ffMenuPanel" role="menu" aria-hidden="true">
          <button class="ff-menu-item" id="ffSaveGameBtn" type="button" role="menuitem">
            <span class="ff-menu-item-icon" aria-hidden="true">💾</span>
            <span>Save Game</span>
          </button>
          <button class="ff-menu-item ff-menu-logout" id="ffLogoutBtn" type="button" role="menuitem">
            <span class="ff-menu-item-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M10 5H6.5A2.5 2.5 0 0 0 4 7.5v9A2.5 2.5 0 0 0 6.5 19H10" stroke-width="2" stroke-linecap="round"/>
                <path d="M13 8l4 4-4 4M17 12H9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span>Log out</span>
          </button>
        </div>
      </div>
      <button class="ff-icon-btn ff-home-btn" type="button" aria-label="Home" title="Home">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3.5 10.5 12 3.5l8.5 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M5.5 9.5V20h13V9.5M9.5 20v-6h5v6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </header>

  <main class="page">
    <section class="scoreboard compact-scoreboard">
      <div class="score-team-block home-block">
        <div class="team">
